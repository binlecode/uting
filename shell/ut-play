#!/usr/bin/env bash

# Portability: must run on bash 3.2 (macOS system bash). No bash-4 features; guard
# every empty-array expansion (a bare "${arr[@]}" on an empty array aborts under
# `set -u` on 3.2). See SPEC-system.md §28.
#
# set -e means any unguarded failing command aborts the script. This is desired for
# this core: single-handle playback is non-interactive, so if the engine or mpv fails the
# script should abort and propagate a real exit code. Where a failure must
# be captured rather than abort (e.g. classifying a playback error for JSON output),
# the `cmd || rc=$?` idiom keeps set -e from firing — see play_url_json().
set -euo pipefail

# ==============================================================================
# 1. CORE LIBRARY & DEFAULT SETTINGS (Merged from yt-common.sh)
# ==============================================================================
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# THE version of the whole suite, declared once — in a data file, not in code. The player and
# the engines are independent executables that share no library, so a shell variable in any
# one of them would make the others ask IT for the version, which is the wrong dependency
# direction for a player that must not know its engines. A one-line file each reads keeps
# "one fact, one place" with zero code sharing. CLAUDE.md § one fact, one place.
if [[ -r "$SCRIPT_DIR/VERSION" ]]; then
    YT_VERSION=$(cat "$SCRIPT_DIR/VERSION")
else
    YT_VERSION="unknown"
fi
# Path to this script, used to re-exec a detached playback child (see detach_play).
SELF="${BASH_SOURCE[0]}"

: "${YT_ASCII_VO:=tct}"
# Optional custom mpv input.conf path; empty means use mpv defaults.
: "${YT_MPV_INPUT_CONF:=}"

# WHICH ENGINE turns a handle into bytes. An engine is a PAIR of executables sharing a name
# prefix (`<engine>-search`, `<engine>-resolve`); the player calls only the resolve half,
# and only by that name — it carries no table of sites, no URL sniffing, and no idea what a
# format string looks like. Name == command prefix is what keeps the lookup a string
# concatenation instead of a registry the player and the TUI would both have to hold.
# Per-call override: --engine. docs/PLAN-ut-restructure.md §2.2.
: "${UT_DEFAULT_ENGINE:=yt}"

YT_MPV_AUDIO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar --no-video)
# Keep video output auto-selected by mpv for compatibility across terminals/displays.
# Video-mode terminal-noise fix (video/fast). mpv draws the media TITLE as a video OSD via
# libass; a title with glyphs no font covers (emoji — pervasive on YouTube) makes libass emit
# a per-frame "[osd/libass] fontselect: failed … glyph" warning AND macOS CoreText a
# ".LastResort" note. At ~30/s these interrupt mpv's in-place status line so it scrolls
# endlessly, burying ut-tui's menu. Two-part fix that KEEPS the on-window OSD/OSC (so the video
# window still shows its seek bar / controls): (1) --msg-level=osd/libass=error suppresses the
# libass warnings at the source while keeping error level for the -j classifier; (2) the
# leftover CoreText notes — which no mpv flag can reach — are dropped by a stderr filter in
# run_mpv. Crucially the useful --term-osd-bar/AV status prints on STDOUT and the noise on
# STDERR, so filtering stderr never touches the progress bar. audio is immune (--no-video → no
# OSD); ascii uses --really-quiet. Rejected: --osd-level=0 (kills the noise but also the
# on-window OSD/OSC); --msg-level=all=error (blanks the status bar); OS_ACTIVITY_MODE=disable
# (does NOT stop CoreText). See SPEC-system.md §8.1.
YT_MPV_VIDEO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar)
# mpv docs suggest sw-fast/really-quiet for terminal VOs to reduce glitches and improve speed.
YT_MPV_ASCII_OPTIONS=(--vo="${YT_ASCII_VO}" --profile=sw-fast --really-quiet --term-osd-bar)


# ==============================================================================
# 2. CORE HELPER FUNCTIONS
# ==============================================================================

usage() {
    cat <<'EOF'
ut-play — the non-interactive PLAYER: play + detached-playback lifecycle. It is the
source-agnostic half of the suite. It does not search, does not extract, and knows nothing
about any one site: an ENGINE (a pair of executables, <engine>-search and <engine>-resolve)
turns a handle into a stream URL, and this file plays it. It is the whole playback surface
and it gates its own flags: no wrapper sits in front of it, and nothing else on PATH plays.

  yt-search   search -> text list or JSON        (the YouTube engine, half one)
  yt-resolve  handle -> stream URL + headers, metadata, captions   (half two)
  ut-tui      interactive terminal browser (pick + play)

A HANDLE is a URL or an engine media id (dQw4w9WgXcQ). Whether an id is well formed is the
engine's knowledge, not this file's, so a bad one fails as an extraction (2+), not usage (1).

Usage (everything after -- is the handle, so it may start with '-'):
  ut-play [-f mode] [--volume N] [-j] -- <id|URL>         play (blocks until done)
  ut-play -d [-f mode] [--volume N] [-j] -- <id|URL>      detached background playback
  ut-play --status [-j]                                   list live detached players
  ut-play --stop [--id ID | --all] [-j]                   stop one player (or all)
  ut-play --set-volume N [--id ID] [-j]                   live volume on a detached player
  ut-play (no handle, no action)                          usage error; use ut-tui to browse

Not here, by design: metadata, captions and stream URLs are extraction, so they are the
engine's verbs — yt-resolve --info / --transcript / (bare) resolve. Searching is yt-search.

Options:
  --engine N  Which engine resolves the handle (default: yt; set UT_DEFAULT_ENGINE).
              The name is also the command prefix: --engine yt calls yt-resolve.
  -S SORT     Engine format-sort override, forwarded verbatim (e.g. res:720,fps)
  -f MODE     Playback mode (default: audio)
              audio|ba  audio-only          video|bv  high-quality video+audio
              fast|fst  progressive video   ascii|asc terminal video (mpv terminal VO)
              viz|waves live audio spectrum wave visualizer
              (-d rejects ascii/viz: a detached player has no terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: mpv's own). For -d this is the STARTING
              volume; change it live with --set-volume.
  -l          Prose output (default)
  -j          JSON output: one-line status JSON for play/lifecycle
  -d          --detach: background playback; manage with --status/--stop/--set-volume
  --color M   auto|always|never (default: auto). No -c short form.
  -h          This help
  -V          Print the suite version (answered before any dependency check)

Long-only flags: --engine --detach --status --stop --set-volume --id --all --json --list
                 --color --volume  (--help and --version also have short forms: -h, -V)

Output contracts (full schemas: docs/SPEC-system.md §14):
  play -j   {status, url, mode, exit_code, reason, retried}
            reason: forbidden|unavailable|format_unavailable|network|stopped_by_user|
                    unknown|null(ok)   (network also covers HTTP 429 rate limiting)
  -d -j     {status:"started", id, pid, url, mode, started_at, title, sock, log}
  --status  {status:"players", players:[{id,pid,url,mode,volume,paused,position,
            duration,title,started_at}], failed:[{id,url,mode,started_at,ended_at,
            exit_code,reason}]}   volume/paused/position/duration are read live off the
            player (null = could not ask); failed lists players that died on their own
  --stop    {status:"stopped", id, stopped} | {status:"stopped", scope:"all", stopped}
  --set-vol {status:"ok", id, volume} | {status:"not_playing"} | {status:"ambiguous", …}
            | {status:"error", reason:"ipc_failed"}

Exit codes: 0 ok · 1 usage/validation · 2+ propagated engine/mpv failure · 4 lifecycle
            call did not take effect (no such player / ambiguous / IPC failure)

Playback keys (mpv, during a blocking 'ut-play -- <handle>' playback):
  _  toggle video track on/off        q  stop playback and exit

Dependencies: mpv (playback) + jq; nc (--set-volume); an <engine>-resolve on PATH or next
              to this file. yt-dlp / curl / cookies are the ENGINE's business, not the
              player's — see 'yt-resolve -h' for those.

Environment:
  UT_DEFAULT_ENGINE    Engine used when --engine is not given (default: yt)
  YT_ASCII_VO          mpv terminal video output driver (default: tct)
  YT_MPV_INPUT_CONF    Path to an optional custom mpv input.conf
EOF
}

die() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
    exit 1
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

mpv_supports_vo() {
    local vo=$1
    mpv --vo=help 2>/dev/null | awk 'NR > 1 {print $1}' | grep -Fxq "$vo"
}


normalize_playback_mode() {
    case "$1" in
    audio | ba) echo "audio" ;;
    video | bv) echo "video" ;;
    fast | fst) echo "fast" ;;
    ascii | asc) echo "ascii" ;;
    viz | waves | wave) echo "viz" ;;
    *) die "-f must be one of: audio, video, fast, ascii, viz, waves, ba, bv, fst, asc, wave" ;;
    esac
}

# ==============================================================================
# 3. THE ENGINE SEAM & PLAYBACK PIPELINES
# ==============================================================================

# An engine is a PAIR of executables sharing a name prefix. The player calls exactly one of
# them — `<engine>-resolve` — with a mode and a handle, and gets an envelope back; it never
# learns what a format string is, whether cookies exist, or what a media id looks like on
# any given site. Name == command prefix is what makes this lookup a string concatenation
# instead of a name->command registry that the player and the TUI would each have to carry.
# Sibling first so a bare checkout runs with nothing on PATH, then PATH so an installed
# engine works from anywhere.
ENGINE_RESOLVE=""
engine_resolve_bin() {
    if [[ -n "$ENGINE_RESOLVE" ]]; then
        return 0
    fi
    # The name is pasted into a path, so it is validated as a NAME — not sanitised as a path.
    if [[ ! "$ENGINE" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        die "invalid engine name: '$ENGINE'"
    fi
    if [[ -x "$SCRIPT_DIR/$ENGINE-resolve" ]]; then
        ENGINE_RESOLVE="$SCRIPT_DIR/$ENGINE-resolve"
    elif command -v "$ENGINE-resolve" >/dev/null 2>&1; then
        ENGINE_RESOLVE=$(command -v "$ENGINE-resolve")
    else
        die "unknown engine '$ENGINE': no '$ENGINE-resolve' next to ut-play or on PATH"
    fi
    return 0
}

# Out-params of resolve_media. Globals rather than a return value because bash 3.2 arrays do
# not survive command substitution — the same discipline reap_dead_players already uses.
# These four are the ENTIRE vocabulary the playback path has for "what am I playing".
RESOLVED_URLS=()          # [0] = what mpv opens; [1] = its separate audio track, if any
RESOLVED_HEADER_ARGS=()   # ready-made --http-header-fields-append=... mpv flags
RESOLVED_TITLE=""
RESOLVED_FORMAT=""        # the engine's format string: recorded verbatim, never read
RESOLVED_REASON=""        # on failure, the engine's own reason enum member
RESOLVED_RC=0

# Turn a handle into bytes by asking the engine. This ONE call replaces everything the
# player used to know about YouTube: the mode->format table, the cookie decision, and the
# proof-of-origin probe that picks a client which can actually fetch. Returns 0 with the
# RESOLVED_* globals filled, or the engine's own exit code with RESOLVED_RC/RESOLVED_REASON
# set. Callers must reach it through `|| rc=$?` (or `if !`), never bare under set -e.
resolve_media() {
    local handle=$1 mode=$2
    engine_resolve_bin

    RESOLVED_URLS=()
    RESOLVED_HEADER_ARGS=()
    RESOLVED_TITLE=""
    RESOLVED_FORMAT=""
    RESOLVED_REASON=""
    RESOLVED_RC=0
    PLAYBACK_RETRIED=0

    # -S is forwarded because format-sort is the engine's concept and the caller may have
    # overridden it; everything else the engine decides for itself.
    local out rc=0
    out=$("$ENGINE_RESOLVE" -j -f "$mode" ${FORMAT_SORT:+-S "$FORMAT_SORT"} -- "$handle" 2>/dev/null) || rc=$?

    if ((rc != 0)) || [[ -z "$out" ]]; then
        # An engine that exits 0 with nothing usable still failed a tool call, which the
        # taxonomy scores 2+, never 0. Its own `reason` is trusted when it sent one.
        RESOLVED_RC=$rc
        ((RESOLVED_RC == 0)) && RESOLVED_RC=2
        RESOLVED_REASON=$(printf '%s' "$out" | jq -r '.reason // empty' 2>/dev/null) || RESOLVED_REASON=""
        [[ -n "$RESOLVED_REASON" ]] || RESOLVED_REASON="unknown"
        return "$RESOLVED_RC"
    fi

    local u h
    while IFS= read -r u; do
        if [[ -n "$u" ]]; then RESOLVED_URLS+=("$u"); fi
    done < <(printf '%s' "$out" | jq -r '.stream_urls[]? // empty' 2>/dev/null)
    while IFS= read -r h; do
        if [[ -n "$h" ]]; then RESOLVED_HEADER_ARGS+=(--http-header-fields-append="$h"); fi
    done < <(printf '%s' "$out" | jq -r '(.http_headers // {}) | to_entries[] | "\(.key): \(.value)"' 2>/dev/null)

    if ((${#RESOLVED_URLS[@]} == 0)); then
        RESOLVED_RC=2
        RESOLVED_REASON="unknown"
        return 2
    fi

    RESOLVED_TITLE=$(printf '%s' "$out" | jq -r '.title // ""' 2>/dev/null) || RESOLVED_TITLE=""
    RESOLVED_FORMAT=$(printf '%s' "$out" | jq -r '.format // ""' 2>/dev/null) || RESOLVED_FORMAT=""
    # The anonymous-client fallback is now the ENGINE's decision, so `retried` is relayed
    # rather than observed — but it is still the playback envelope's field (§14).
    if printf '%s' "$out" | jq -e '.retried == true' >/dev/null 2>&1; then
        PLAYBACK_RETRIED=1
    fi

    patch_player_meta
    return 0
}

# Backfill the two player-record fields detach_play could not know at launch. This is what
# retired the old background title updater: that was a whole extra `yt-dlp --print title`
# round trip whose only job was to answer a question the resolve envelope already answers,
# held open in a detached background job whose fds had to be redirected so a capturing
# caller would not block on it. Here it is a jq call in a child that already has the data.
#
# Self-guarding exactly as the updater was: it patches ONLY while this pid still owns the
# state file, so a --stop during the resolve window wins and is never clobbered (jq emits
# nothing when the pid no longer matches, and the empty temp is dropped without touching the
# live file). Best-effort throughout — a failure leaves title:null, which callers tolerate.
patch_player_meta() {
    local id="${YT_PLAYER_ID:-}" sf tmp i
    if [[ -z "$id" ]]; then
        return 0
    fi

    # detach_play writes players/<id>.json AFTER launching this child, so a fast resolve can
    # arrive first. Bounded poll, not a fixed sleep: the ordinary case costs one stat.
    sf=$(player_state "$id")
    for ((i = 0; i < 50; i++)); do
        if [[ -f "$sf" ]]; then break; fi
        sleep 0.1
    done
    if [[ ! -f "$sf" ]]; then
        return 0
    fi

    tmp="$sf.tmp.$$"
    lock_player_state "$id" || true
    if jq --arg t "$RESOLVED_TITLE" --arg f "$RESOLVED_FORMAT" --arg p "$$" \
        'if ((.pid | tostring) == $p)
         then .title = (if $t == "" then null else $t end)
              | .format = (if $f == "" then null else $f end)
         else empty end' \
        "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"
    return 0
}

# ------------------------------------------------------------------------------
# Playback pipelines
# ------------------------------------------------------------------------------


# Play the ALREADY-RESOLVED stream(s) with mpv. There is no ytdl_hook any more: the engine
# handed us direct URLs plus the headers they must be fetched with, so mpv is told
# --no-ytdl and never makes an extraction of its own. That closes the asymmetry where the
# LAST yt-dlp call in a play was one we did not make and could not classify — from here
# there is exactly one extraction and we made it. docs/PLAN-ut-restructure.md §3.3.
#
# The media comes from the RESOLVED_* globals rather than arguments because bash 3.2 arrays
# do not survive command substitution; resolve_media sets them in place and every path into
# here runs after a successful resolve. Positional args are the caller's mode options.
run_mpv() {
    local mpv_cmd=(mpv --no-ytdl)

    # Optionally load caller-provided mpv input bindings.
    if [[ -n "$YT_MPV_INPUT_CONF" && -r "$YT_MPV_INPUT_CONF" ]]; then
        mpv_cmd+=(--input-conf="$YT_MPV_INPUT_CONF")
    fi

    # Launch-time volume. For a foreground/blocking session this is the only lever
    # (mpv's own volume keys work via the TTY); for detached playback it is just the
    # STARTING volume — live adjustment happens over the per-instance IPC socket
    # (see YT_IPC_SOCK below and do_set_volume). SPEC-system.md §26.
    if [[ -n "$VOLUME" ]]; then
        mpv_cmd+=(--volume="$VOLUME")
    fi

    # Runtime control channel: only when launched under detach_play, which exports
    # YT_IPC_SOCK. mpv's --input-ipc-server is per-process, so each detached player
    # points at its own socket and is driven independently. A foreground/blocking
    # session has a real TTY and needs no IPC. SPEC-system.md §26.
    if [[ -n "${YT_IPC_SOCK:-}" ]]; then
        mpv_cmd+=(--input-ipc-server="$YT_IPC_SOCK")
    fi

    # The headers the engine says these URLs must be fetched with — one of the two things
    # ytdl_hook used to do for free (it called mpv's set_http_headers itself). Repeated
    # `-append` rather than one comma-joined --http-header-fields: that option is a LIST,
    # so a header value containing a comma would be split into two broken headers.
    #
    # These land on mpv's argv and are therefore visible in `ps`. An engine must not return
    # a credential header (Cookie / Authorization) here; the YouTube engine returns only
    # User-Agent / Accept / Accept-Language / Sec-Fetch-Mode. SPEC-system.md §14.
    if ((${#RESOLVED_HEADER_ARGS[@]})); then
        mpv_cmd+=("${RESOLVED_HEADER_ARGS[@]}")
    fi

    # ytdl_hook also set the media title from the extractor record; without it the OSD and
    # the window would read a googlevideo path. The resolve envelope already carries the
    # title, so hand it over rather than fetch it a second time.
    if [[ -n "$RESOLVED_TITLE" ]]; then
        mpv_cmd+=(--force-media-title="$RESOLVED_TITLE")
    fi

    # The third thing ytdl_hook did for free: when the chosen format merges a video-only and
    # an audio-only stream it built an EDL out of the pair. mpv joins them natively with
    # --audio-file, so the synthesis is one flag — element 0 is the video (the engine sorts
    # it first), element 1 its audio track.
    local media=("${RESOLVED_URLS[0]}")
    if ((${#RESOLVED_URLS[@]} > 1)); then
        media+=(--audio-file="${RESOLVED_URLS[1]}")
    fi

    # Detached playback has no terminal, so nobody ever reads mpv's status line — but mpv
    # keeps writing it into mpv-<id>.log anyway (~2.4 MB/h measured on a 24/7 stream, i.e.
    # unbounded growth in TMPDIR for exactly the long-lived players -d exists for). Silence
    # the cosmetic chatter there and keep error level, so the log stays small and still
    # explains a failure. These go AFTER the caller's mode options so they win (mpv: last
    # flag wins). SPEC-system.md §9.1.
    local detached_opts=()
    if [[ -n "${YT_DETACHED:-}" ]]; then
        detached_opts=(--no-term-osd-bar --msg-level=all=error)
    fi

    # Execute mpv natively. The STDERR filter drops the macOS CoreText ".LastResort" notes
    # (no mpv flag reaches them) plus any residual libass fontselect warning that
    # emoji-titled video would otherwise flood (see YT_MPV_VIDEO_OPTIONS). The useful
    # --term-osd-bar/AV status prints on STDOUT, so the progress bar is never touched; real
    # (non-noise) errors still pass through to >&2 for the -j classifier. Process
    # substitution (not a pipe) leaves $? as mpv's own exit code.
    #
    # It runs ONLY when a human is watching this terminal. Under -j the caller captures
    # stdout+stderr into a temp file that is never displayed, and a detached child writes to
    # its log — there the filter buys nothing and costs correctness: process substitution is
    # not waited on, so play_url_json (which reads the temp file the instant mpv exits) could
    # miss a late-flushed error line and classify a real 403 as `unknown`.
    if [[ "$OUTPUT_MODE" == "json" || -n "${YT_DETACHED:-}" ]]; then
        "${mpv_cmd[@]}" "$@" ${detached_opts[@]+"${detached_opts[@]}"} "${media[@]}"
    else
        "${mpv_cmd[@]}" "$@" "${media[@]}" 2> >(grep --line-buffered -vE 'CoreText note|\.LastResort|fontselect' >&2)
    fi
}


play_audio_url() {
    run_mpv "${YT_MPV_AUDIO_OPTIONS[@]}"
}


play_video_url() {
    run_mpv "${YT_MPV_VIDEO_OPTIONS[@]}"
}


play_ascii_url() {
    run_mpv "${YT_MPV_ASCII_OPTIONS[@]}"
}

play_viz_url() {
    # Real terminal size via the ioctl. `$(tput cols)` can answer with terminfo's
    # default 80x24 inside command substitution (measured: 80 in a 60-column pane), which
    # would size the visualizer for a window that isn't there.
    local width height size sz
    sz=$(stty size </dev/tty 2>/dev/null || true)
    height=${sz%% *}
    width=${sz##* }
    [[ "$width" =~ ^[0-9]+$ ]] || width=$(tput cols 2>/dev/null || echo 80)
    [[ "$height" =~ ^[0-9]+$ ]] || height=$(tput lines 2>/dev/null || echo 24)
    # Cap size to prevent terminal lag
    if ((width > 120)); then width=120; fi
    if ((height > 30)); then height=30; fi
    size="${width}x${height}"

    # Use showwaves filter with TCT terminal output
    run_mpv \
        --vo=tct \
        --lavfi-complex="[aid1]asplit[ao][v];[v]showwaves=s=${size}:mode=line:colors=cyan|yellow:r=15[vo]"
}

# Single mode-dispatch table for playback, shared by play_url_directly() (prose
# `yt <url>`) and play_url_json() (structured output). Kept as one function so the
# callers can never drift out of sync on which modes exist or what they print.
play_mode_url() {
    local url=$1
    local mode=$2

    case "$mode" in
    video)
        printf "Playing video: %s\n" "$url"
        play_video_url
        ;;
    fast)
        printf "Playing fast video: %s\n" "$url"
        play_video_url
        ;;
    ascii)
        printf "Playing ascii video: %s\n" "$url"
        play_ascii_url
        ;;
    viz)
        printf "Playing audio with live visualizer: %s\n" "$url"
        play_viz_url
        ;;
    *)
        printf "Playing audio: %s\n" "$url"
        play_audio_url
        ;;
    esac
}


# Prose entry (a blocking `ut-play <handle>`) and the detached child's own path. A resolve
# failure has no envelope to carry a reason here, so it goes to stderr carrying the
# machine-readable marker detached_epitaph reads back out of the log. It RETURNS rather than
# exits so the caller still gets to write that epitaph.
play_url_directly() {
    local url=$1
    if ! resolve_media "$url" "$PLAYBACK_MODE"; then
        echo "ut-play: $ENGINE-resolve could not resolve $url (yt_reason=$RESOLVED_REASON)" >&2
        return "$RESOLVED_RC"
    fi
    play_mode_url "$url" "$PLAYBACK_MODE"
}


# Map captured mpv output + exit code to the suite's stable reason taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw player wording (which is not
# a contract and drifts across versions).
#
# This is the PLAYER's half of that job and it only knows mpv. The yt-dlp wordings — video
# unavailable, requested format, sign in to confirm — left with the extraction; they reach a
# caller as the ENGINE's own reason, replayed here from the marker play_url_directly logs
# rather than re-derived from prose. The ENUM is the shared fact (docs/SPEC-system.md §14),
# and no member may appear here that it does not already have. `unknown` is the conservative
# default — we never guess a specific cause we didn't positively identify.
classify_playback_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    # A resolve that failed was already classified, by the half of the suite that can read
    # extractor wording. Trust that verdict instead of guessing from the prose around it.
    if [[ "$text" =~ yt_reason=([a-z_]+) ]]; then
        echo "${BASH_REMATCH[1]}"
        return
    fi
    # mpv's own transport failure on a URL it was handed. 403 stays reachable here because
    # a signed media URL can expire or be refused between resolve and open.
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    # 429 lands in `network`, not `unknown`: it is a transport-level, RETRYABLE refusal, and
    # `network` is the enum member that already means "try again later". Adding a
    # `rate_limited` member instead would grow a contract three verbs publish (§14) for no
    # branch a caller would take differently. It is grouped here rather than with `forbidden`
    # (403) deliberately — 403 means these credentials never work, 429 means not right now.
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out|HTTP Error 429|Too Many Requests' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}


# The ONE place the playback envelope is written, so the mpv path and the resolve-failure
# path cannot drift on its shape.
emit_play_json() {
    local url=$1 mode=$2 rc=$3 status=$4 reason=$5
    local retried_json="false"
    if ((PLAYBACK_RETRIED)); then
        retried_json="true"
    fi
    jq -nc \
        --arg status "$status" \
        --arg url "$url" \
        --arg mode "$mode" \
        --argjson exit_code "$rc" \
        --arg reason "$reason" \
        --argjson retried "$retried_json" \
        '{status: $status, url: $url, mode: $mode, exit_code: $exit_code, reason: (if $reason == "" then null else $reason end), retried: $retried}'
}

# Opt-in structured playback (ut-play -j). Captures the player's stdout+stderr (suppressing
# its chatter) and emits exactly one final JSON line describing the outcome. rc 130 (user hit
# q/ctrl-c) is a normal stop, reported as status "ok" with reason "stopped_by_user". The real
# non-zero exit is still propagated so the process exit code stays truthful.
play_url_json() {
    local url=$1 mode=$2
    local tmp rc=0 status reason

    # A failed extraction is reported as the play's failure, with the engine's own reason:
    # there is no mpv output to classify because mpv was never launched.
    if ! resolve_media "$url" "$mode"; then
        emit_play_json "$url" "$mode" "$RESOLVED_RC" "error" "$RESOLVED_REASON"
        return "$RESOLVED_RC"
    fi

    # Keep the capture file inside the 0700 state dir: the mktemp-less fallback name is
    # predictable, and on Linux ${TMPDIR:-/tmp} is a shared world-writable directory.
    ensure_state_dir
    tmp=$(mktemp "$STATE_DIR/play.XXXXXX" 2>/dev/null) || tmp="$STATE_DIR/play.$$"

    play_mode_url "$url" "$mode" >"$tmp" 2>&1 || rc=$?

    if ((rc == 0)); then
        status="ok"
        reason=""
    elif ((rc == 130)); then
        status="ok"
        reason="stopped_by_user"
    else
        status="error"
        reason=$(classify_playback_error "$(cat "$tmp" 2>/dev/null)" "$rc")
    fi
    rm -f "$tmp"

    emit_play_json "$url" "$mode" "$rc" "$status" "$reason"

    ((rc == 130)) && return 0
    return "$rc"
}

# A detached playback is tracked by its PROCESS GROUP, not a PID tree. The child bash
# is launched as its own process-group leader (see detach_play), so its pgid == its
# pid, and every descendant it forks — the engine's own yt-dlp/curl, and mpv — inherits
# that pgid. This is what a PID-tree
# walk cannot handle: a late-spawned mpv appears after any one-time snapshot, and once
# bash exits the mpv reparents to init (ppid=1) so it is no longer findable by parentage.
# The pgid is invariant under reparenting, so group operations always reach it.
# pgrep -g / kill -<pgid> are available on macOS and Linux.

# True if any process in group $pgid is still alive.
group_alive() {
    local pgid=${1:-}
    [[ -n "$pgid" ]] && [[ -n "$(pgrep -g "$pgid" 2>/dev/null)" ]]
}

# Stop the whole process group: SIGINT (mpv treats it as a clean stop, like q), wait
# briefly for graceful exit, then SIGKILL any survivor. Negative PID targets the group.
stop_group() {
    local pgid=$1
    kill -INT -"$pgid" 2>/dev/null || true

    local i
    for ((i = 0; i < 15; i++)); do
        group_alive "$pgid" || return 0
        sleep 0.2
    done

    kill -KILL -"$pgid" 2>/dev/null || true
}

# Create the per-user state dir (and the players/ dir under it) with a pinned 0700 mode.
# SECURITY: 0700 so no other local user can traverse in and connect to a player's IPC
# socket (a control channel — a peer could drive mpv). macOS $TMPDIR is already per-user;
# the /tmp fallback (Linux) is world-traversable at umask 022, so pin the mode explicitly
# on both dirs. `mkdir -p -m 700` only applies the mode to dirs it actually creates, so the
# chmod re-asserts it on both; idempotent and cheap (two syscalls), deliberately re-run on
# every use as a safety net rather than trusting the mode was never widened after creation.
ensure_state_dir() {
    mkdir -p -m 700 "$PLAYERS_DIR" 2>/dev/null || true
    chmod 700 "$STATE_DIR" "$PLAYERS_DIR" 2>/dev/null || true
}

# Live property read straight off a player's IPC socket. The state file's `volume` is only
# what was recorded at launch or by the last --set-volume, so anything driving the socket
# directly (ut-tui's 9/0 keys — see SPEC-system.md §9.3) moves the real value without
# telling us; mpv is the source of truth. `pause` and the playback position are worse still:
# the state file has never held them at all.
#
# ONE connection carries every property asked for — that is why this is a property list and
# not four calls: --status pays the same single round trip it always did (~10ms measured; a
# healthy mpv closes as soon as the reader breaks, so the -w1 timeout is never reached).
# Soft-gated on nc so --status keeps working with jq alone (§15): no nc, no socket, no
# output, and the caller reports nulls.
#
# Emits one "<request_id><US><value>" line per answer, in whatever order mpv sent them —
# correlation is the CALLER's job and must be by request_id, never by line order: mpv
# multiplexes async events into every client's stream (the rule do_set_volume already
# carries). `\(.data)` stringifies a JSON null as the four characters "null", so a property
# the player answered null keeps its slot and stays distinguishable from one it never
# answered at all. `|| true` guards the pipeline: under set -euo pipefail an nc timeout or a
# SIGPIPE from the caller breaking early is a non-zero status that would abort the script.
#
# `head -n $i` is load-bearing, not tidiness — it is what CLOSES the pipe. mpv answers every
# command exactly once and jq has already dropped the id-less async events, so the i-th line
# is the last one coming; head exiting there SIGPIPEs nc, which is how the read costs ~30ms
# instead of the full `nc -w1` second against a peer that never closes its side (measured:
# 1.11s -> 0.03s against tests/mpv_ipc_mock.py, which is exactly that peer). The caller
# breaking its own read loop does NOT achieve this: nothing writes again to notice.
live_props() {
    local sock=$1
    shift
    command -v nc >/dev/null 2>&1 || return 0
    [[ -S "$sock" ]] || return 0
    local prop i=0
    local reqs=()
    for prop in "$@"; do
        i=$((i + 1))
        reqs+=("$(printf '{"command":["get_property","%s"],"request_id":%d}' "$prop" "$i")")
    done
    ((${#reqs[@]})) || return 0
    printf '%s\n' "${reqs[@]}" |
        nc -U -w1 "$sock" 2>/dev/null |
        jq -r --unbuffered 'select(.request_id != null) | "\(.request_id)\u001f\(.data)"' 2>/dev/null |
        head -n "$i" || true
}

# The policy half of the read above, shared by both --status output modes so the correlation
# and the normalisation exist once. Sets four globals, each EMPTY when the player did not
# answer (no nc, dead socket, property null) — empty becomes JSON null at the call site, and
# the distinction matters: `false` means "playing", null means "could not ask".
LP_VOLUME=""
LP_PAUSED=""
LP_POSITION=""
LP_DURATION=""
read_player_live() {
    local sock=$1 rid val got=0 seen=0
    LP_VOLUME=""
    LP_PAUSED=""
    LP_POSITION=""
    LP_DURATION=""
    # Breaking on the fourth answer is what keeps a WEDGED player cheap: a peer that never
    # closes its side would otherwise charge the full `nc -w1` second per player. `seen`
    # bounds the loop so a chatty one cannot hold --status open either.
    while IFS=$'\037' read -r rid val; do
        seen=$((seen + 1))
        case "$rid" in
        1) LP_VOLUME="$val"; got=$((got + 1)) ;;
        2) LP_PAUSED="$val"; got=$((got + 1)) ;;
        3) LP_POSITION="$val"; got=$((got + 1)) ;;
        4) LP_DURATION="$val"; got=$((got + 1)) ;;
        *) ;; # an async event; not one of ours
        esac
        ((got >= 4 || seen >= 16)) && break
    done < <(live_props "$sock" volume pause time-pos duration)
    # mpv answers with floats (100.000000, 83.437000); report integers, the unit the rest of
    # the contract speaks — --set-volume takes one, and the search envelope's `duration` is
    # integer seconds. A value that is not a number (including the literal "null") is dropped.
    [[ "$LP_VOLUME" =~ ^[0-9]+ ]] && LP_VOLUME="${LP_VOLUME%.*}" || LP_VOLUME=""
    [[ "$LP_POSITION" =~ ^[0-9]+ ]] && LP_POSITION="${LP_POSITION%.*}" || LP_POSITION=""
    [[ "$LP_DURATION" =~ ^[0-9]+ ]] && LP_DURATION="${LP_DURATION%.*}" || LP_DURATION=""
    [[ "$LP_PAUSED" == "true" || "$LP_PAUSED" == "false" ]] || LP_PAUSED=""
    return 0
}

# The last thing a DETACHED child says, written to its own stdout — i.e. as the final line
# of the log the launch envelope already handed the caller. Without it a detached player that
# dies leaves nothing behind at all: `-d -j` returned {"status":"started"} + exit 0 long
# before the failure, reap_dead_players then deletes the record AND the log, and `--status`
# goes empty — indistinguishable from a track that simply finished. The reaper cannot fill
# that gap on its own: it has no exit code, and "played fine" and "failed for a reason we do
# not recognise" are the same text in a log (classify_playback_error answers `unknown` to
# both). The child is the only process that knows rc, so the child writes the epitaph.
#
# Nothing is written on success, so a normal finish leaves no trace — this is an error
# record, not listening history (a ROADMAP.md §0 non-goal), and that distinction is enforced
# here rather than promised in prose. A player killed by --stop dies with its process group
# and never reaches this line, which is the same rule from the other direction.
detached_epitaph() {
    local rc=$1 reason ended_at
    [[ -n "${YT_DETACHED_LOG:-}" ]] || return 0
    ((rc == 0 || rc == 130)) && return 0
    # Same taxonomy every other surface publishes (§14) — the reason a caller branches on
    # must not depend on which verb produced it. The tail bound keeps a long mpv log from
    # becoming an argument the classifier has to grep in full.
    reason=$(classify_playback_error "$(tail -c 4000 "$YT_DETACHED_LOG" 2>/dev/null)" "$rc")
    ended_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    jq -nc --argjson rc "$rc" --arg reason "$reason" --arg ended_at "$ended_at" \
        '{yt_event: "exit", rc: $rc, reason: $reason, ended_at: $ended_at}' 2>/dev/null || true
    return 0
}

# Per-instance derived paths. Functions, not constants, since they key off the id;
# every detached player owns players/<id>.json, mpv-<id>.sock, mpv-<id>.log.
player_state() { echo "$PLAYERS_DIR/$1.json"; }
player_sock() { echo "$STATE_DIR/mpv-$1.sock"; }
player_log() { echo "$STATE_DIR/mpv-$1.log"; }
player_lock_dir() { echo "$STATE_DIR/lock-$1"; }

# Serialize concurrent read-modify-write patches to the same player state file (e.g. a
# detached child's title/format backfill racing a --set-volume call): both
# do temp+mv RMW with no version check, so without mutual exclusion whichever mv lands
# last silently clobbers the other's field. `mkdir` is atomic on POSIX, making it a
# portable lock on bash 3.2 (no flock binary on stock macOS). Bounded spin (5s) so a
# lock left behind by a crashed holder can't wedge callers forever; on timeout the
# caller proceeds unlocked, same best-effort risk these patches already tolerated
# before this lock existed.
lock_player_state() {
    local id=$1 dir
    dir=$(player_lock_dir "$id")
    local i
    for ((i = 0; i < 50; i++)); do
        mkdir "$dir" 2>/dev/null && return 0
        sleep 0.1
    done
    return 1
}

unlock_player_state() {
    rmdir "$(player_lock_dir "$1")" 2>/dev/null || true
}

# Mint a fresh, collision-free player id by atomically creating a reservation file
# with mktemp; the id is its basename. Done BEFORE launch so the socket path is
# known up front (the child's pid isn't available until $! after launch) and so the
# handle is immune to pid reuse. detach_play removes the bare reservation file once
# the real <id>.json is written.
new_player_id() {
    basename "$(mktemp "$PLAYERS_DIR/XXXXXX")"
}

# Background a playback and record it in a per-player state file (players/<id>.json)
# so a later --status/--stop/--set-volume can find it. Re-execs this script (SELF)
# with a plain, non-detached play invocation via nohup so it survives the launching
# process exiting; the child is tracked by its PROCESS GROUP. Multiple detached
# players run concurrently — each gets its own id, IPC socket, state file, and log,
# so a 2nd -d is NOT refused (that is the point).
#
# THE CHILD RESOLVES, NOT US. Extraction is a ~3s round trip and detach must return in
# milliseconds (ut-tui captures this call), so the parent launches first and writes `title`
# and `format` as null; the child backfills both from its own resolve envelope the moment it
# has one (patch_player_meta). Doing it the other way — resolve here, then launch — would
# put the whole engine round trip on the -d hot path. docs/PLAN-ut-restructure.md §5 B-2. Audio only in practice: a detached
# process has no controlling terminal, so video/ascii/viz have nowhere to render.
detach_play() {
    local url=$1
    ensure_state_dir

    local started_at pid volume_json id sock log
    started_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    volume_json=null
    [[ -n "$VOLUME" ]] && volume_json="$VOLUME"

    # Mint the handle BEFORE launch so the socket path is known up front (see
    # new_player_id): the child's pid isn't available until $! after launch, but the
    # socket must be named at launch via YT_IPC_SOCK. The id is a monotonic token,
    # immune to pid reuse; the pid is stored in the state file for liveness only.
    id=$(new_player_id)
    sock=$(player_sock "$id")
    log=$(player_log "$id")
    rm -f "$sock" 2>/dev/null || true

    # Launch the child in its OWN process group so the whole playback (incl. any
    # fallback mpv) can be stopped as a unit later (see stop_group). Enabling monitor
    # mode (set -m) makes a backgrounded job a process-group leader whose pgid == its
    # pid; nohup + disown detach it from this shell so it survives our exit. YT_IPC_SOCK
    # is exported into the child's environment so its run_mpv adds --input-ipc-server.
    # Job-control chatter is routed away from stdout so -j output stays one JSON line.
    # YT_DETACHED tells the child's run_mpv there is no terminal to draw on (quiet mpv,
    # no stderr filter); YT_DETACHED_LOG hands it the path its own stdout goes to, which is
    # all detached_epitaph needs to read back what mpv said before classifying its own death.
    # -S is forwarded like --volume so a format-sort override isn't silently lost on the
    # detached path; `--` guards a URL that begins with a dash.
    set -m
    YT_IPC_SOCK="$sock" YT_DETACHED=1 YT_DETACHED_LOG="$log" YT_PLAYER_ID="$id" \
        nohup bash "$SELF" --engine "$ENGINE" -f "$PLAYBACK_MODE" \
        ${VOLUME:+--volume "$VOLUME"} ${FORMAT_SORT:+-S "$FORMAT_SORT"} -- "$url" >"$log" 2>&1 &
    pid=$!
    set +m
    disown "$pid" 2>/dev/null || true

    # Persist state under a guarded write. new_player_id created a bare "$PLAYERS_DIR/$id"
    # (mktemp) to reserve the id; the real state lives in "$id.json". The reservation token
    # is only reaped AFTER the real file lands, so under `set -euo pipefail` a bare jq/mv
    # failure (disk full, permissions changed mid-run by a concurrent reap) would abort
    # before cleanup and orphan the token forever — the *.json reap globs never touch a
    # bare non-.json file. Guard both steps so the token is reaped on every path, and stop
    # the just-launched mpv group if we can't track it (else it plays on as an orphan the
    # lifecycle verbs can't find).
    local sf; sf=$(player_state "$id")
    if ! jq -n \
        --arg id "$id" \
        --argjson pid "$pid" \
        --arg url "$url" \
        --arg mode "$PLAYBACK_MODE" \
        --arg started_at "$started_at" \
        --arg log "$log" \
        --arg sock "$sock" \
        --argjson volume "$volume_json" \
        '{id: $id, pid: $pid, url: $url, mode: $mode, format: null, started_at: $started_at, log: $log, sock: $sock, title: null, volume: $volume}' >"$sf.tmp.$pid"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        stop_group "$pid"
        die "failed to write player state for $url"
    fi
    if ! mv -f "$sf.tmp.$pid" "$sf"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        stop_group "$pid"
        die "failed to persist player state for $url"
    fi
    rm -f "$PLAYERS_DIR/$id" 2>/dev/null || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        # sock/log are part of the envelope so a caller never has to RECONSTRUCT them from
        # the state-dir layout (ut-tui used to hardcode "$TMPDIR/yt-cli-$(id -u)/mpv-$id.sock",
        # duplicating a private path in a second script). SPEC-system.md §9.3.
        jq -nc \
            --arg id "$id" --argjson pid "$pid" --arg url "$url" --arg mode "$PLAYBACK_MODE" \
            --arg started_at "$started_at" --arg sock "$sock" --arg log "$log" \
            '{status: "started", id: $id, pid: $pid, url: $url, mode: $mode, started_at: $started_at, title: null, sock: $sock, log: $log}'
    else
        printf "Detached playback started (id %s, pid %s, mode %s): %s\n" "$id" "$pid" "$PLAYBACK_MODE" "$url"
        printf "  status: ut-play --status   stop: ut-play --stop --id %s   log: %s\n" "$id" "$log"
    fi
}

# Scan $PLAYERS_DIR once, reaping any player whose process group is gone (rm its
# state/sock/log). "What counts as dead" (currently: group not alive) lives here in exactly
# one place, shared by resolve_target, do_status, and do_stop --all so those verbs can never
# disagree about which players exist.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...); bash 3.2 arrays don't survive command
# substitution): sets three PARALLEL GLOBAL arrays for the survivors, index-aligned —
#   LIVE_PLAYER_FILES[i] = players/<id>.json path
#   LIVE_PLAYER_IDS[i]   = its .id
#   LIVE_PLAYER_PIDS[i]  = its .pid
# reading .id/.pid once here means no caller has to reopen the file for them.
reap_dead_players() {
    LIVE_PLAYER_FILES=()
    LIVE_PLAYER_IDS=()
    LIVE_PLAYER_PIDS=()
    local f id pid
    [[ -d "$PLAYERS_DIR" ]] || return 0
    for f in "$PLAYERS_DIR"/*.json; do
        [[ -e "$f" ]] || continue
        id=$(jq -r '.id // empty' "$f" 2>/dev/null || true)
        pid=$(jq -r '.pid // empty' "$f" 2>/dev/null || true)
        if group_alive "$pid"; then
            LIVE_PLAYER_FILES+=("$f")
            LIVE_PLAYER_IDS+=("$id")
            LIVE_PLAYER_PIDS+=("$pid")
        else
            # Read the epitaph BEFORE the log goes: this is the only moment both the record
            # and the log still exist, and a failure that is not captured here is gone.
            [[ -n "$id" ]] && record_player_death "$id" "$f"
            rm -f "$f" 2>/dev/null || true
            [[ -n "$id" ]] && rm -f "$(player_sock "$id")" "$(player_log "$id")" 2>/dev/null || true
        fi
    done
}

# Map a request to a single live player, reaping any dead ones along the way. The single
# place --set-volume and --stop share for target selection.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...)): on success sets the GLOBAL
# RESOLVED_ID and returns 0; on failure sets RESOLVE_ERR ("not_playing"|"ambiguous")
# (+ RESOLVE_PLAYERS_JSON for ambiguous) and returns non-zero. Nothing is echoed to
# stdout — the caller decides how to render (a --stop treats not_playing as idempotent
# success; a --set-volume treats it as exit 4), so the error text must not be trapped
# by command substitution.
#   --id given          -> that player if live, else not_playing
#   no --id, exactly 1  -> that player (common case, zero-friction)
#   no --id, 0 players   -> not_playing
#   no --id, 2+ players  -> ambiguous (candidates in RESOLVE_PLAYERS_JSON)
resolve_target() {
    local want_id=$1
    RESOLVED_ID=""
    RESOLVE_ERR=""
    RESOLVE_PLAYERS_JSON="[]"

    # Read the live set from reap_dead_players' globals directly — copying via
    # ("${arr[@]}") would abort under `set -u` on bash 3.2 when the array is empty (the
    # common "nothing playing" case). Index access and count are safe on an empty array.
    reap_dead_players
    local n=${#LIVE_PLAYER_IDS[@]}

    if [[ -n "$want_id" ]]; then
        local i
        for ((i = 0; i < n; i++)); do
            if [[ "${LIVE_PLAYER_IDS[$i]}" == "$want_id" ]]; then
                RESOLVED_ID="$want_id"
                return 0
            fi
        done
        RESOLVE_ERR="not_playing"
        return 1
    fi

    if ((n == 0)); then
        RESOLVE_ERR="not_playing"
        return 1
    elif ((n == 1)); then
        RESOLVED_ID="${LIVE_PLAYER_IDS[0]}"
        return 0
    else
        RESOLVE_ERR="ambiguous"
        RESOLVE_PLAYERS_JSON=$(jq -s '[.[] | {id, pid, title, url}]' "${LIVE_PLAYER_FILES[@]}")
        return 1
    fi
}

# Turn a dead player's last log line into a tombstone under players/dead/, so `--status` can
# answer "it stopped, and here is why" instead of going silently empty (see detached_epitaph
# for why the child, not this function, decides rc). Failures ONLY: no epitaph — a normal
# finish, a --stop that took the whole process group down, a truncated log, a kill -9 — means
# no tombstone. Silence is reported as silence; a death is never inferred.
record_player_death() {
    local id=$1 f=$2 log ev rc reason ended_at dead
    log=$(player_log "$id")
    [[ -f "$log" ]] || return 0
    ev=$(tail -n 1 "$log" 2>/dev/null | jq -c 'select(.yt_event == "exit")' 2>/dev/null) || ev=""
    [[ -n "$ev" ]] || return 0
    IFS=$'\037' read -r rc reason ended_at < <(
        printf '%s' "$ev" | jq -r '[(.rc // 0), (.reason // "unknown"), (.ended_at // "unknown")] | join("\u001f")' 2>/dev/null
    ) || return 0
    [[ "$rc" =~ ^[0-9]+$ ]] && ((rc != 0)) || return 0

    # No -p: reap_dead_players only reaches here with PLAYERS_DIR already present, and -p
    # would apply the mode to the deepest component only (the SC2174 note at ensure_state_dir).
    dead="$PLAYERS_DIR/dead"
    [[ -d "$dead" ]] || mkdir -m 700 "$dead" 2>/dev/null || return 0
    # Only the fields that answer "which launch was this, and what happened to it" — the
    # socket, log and format paths described a process that no longer exists.
    jq -c --argjson exit_code "$rc" --arg reason "$reason" --arg ended_at "$ended_at" \
        '{id, url, mode, started_at, ended_at: $ended_at, exit_code: $exit_code, reason: $reason}' \
        "$f" >"$dead/$id.json.tmp" 2>/dev/null &&
        mv -f "$dead/$id.json.tmp" "$dead/$id.json" 2>/dev/null ||
        rm -f "$dead/$id.json.tmp" 2>/dev/null || true
    prune_dead_players
    return 0
}

# Two bounds, both enforced on disk rather than at render time, so the directory cannot grow
# into a history nobody asked for: nothing older than an hour, and never more than 8 records.
# `find -mmin` is stock on macOS and Linux alike; the count cap reuses jq's sort so "oldest"
# means the same thing here as it does in the output.
DEAD_KEEP=8
prune_dead_players() {
    local dead="$PLAYERS_DIR/dead" files=() extra x
    [[ -d "$dead" ]] || return 0
    find "$dead" -name '*.json' -mmin +60 -delete 2>/dev/null || true
    files=("$dead"/*.json)
    [[ -e "${files[0]}" ]] || return 0
    ((${#files[@]} > DEAD_KEEP)) || return 0
    extra=$(jq -sr --argjson keep "$DEAD_KEEP" \
        'sort_by(.ended_at) | reverse | .[$keep:] | .[].id' "${files[@]}" 2>/dev/null) || return 0
    while IFS= read -r x; do
        [[ -n "$x" ]] && rm -f "$dead/$x.json" 2>/dev/null || true
    done <<<"$extra"
    return 0
}

# The read side of the same directory: newest first, capped, as a JSON array in FAILED_JSON.
# Always a valid array — `failed` is a key that is ALWAYS present in the --status envelope,
# because a key that appears only when something went wrong is harder to consume than an
# empty one (a caller would have to distinguish "no failures" from "old version").
FAILED_JSON='[]'
collect_failed_players() {
    local dead="$PLAYERS_DIR/dead" files=()
    FAILED_JSON='[]'
    [[ -d "$dead" ]] || return 0
    files=("$dead"/*.json)
    # The glob is unexpanded when the directory is empty; test the first element rather than
    # the count, and skip the prune entirely — the common case must cost no fork at all.
    [[ -e "${files[0]}" ]] || return 0
    prune_dead_players
    files=("$dead"/*.json)
    [[ -e "${files[0]}" ]] || return 0
    FAILED_JSON=$(jq -sc --argjson keep "$DEAD_KEEP" \
        'sort_by(.ended_at) | reverse | .[0:$keep]' "${files[@]}" 2>/dev/null) || FAILED_JSON='[]'
    [[ -n "$FAILED_JSON" ]] || FAILED_JSON='[]'
    return 0
}

# List ALL live detached players (reaping dead ones). Always exits 0 (an agent polling
# status must not see a non-zero exit as failure); empty set is still a success.
# `volume`, `paused`, `position` and `duration` are reported LIVE (one round trip per player
# off its IPC socket, see read_player_live) rather than from the state file: the record only
# knows about launch --volume and --set-volume, so a client driving the socket itself
# (ut-tui's 9/0 keys) would make `volume` lie — and it has never held the other three at all.
# `volume` keeps the recorded value as its fallback; the other three are null when unread,
# which is NOT the same as false/0 ("could not ask" vs "playing at zero"). read_player_live
# is a no-op without nc, keeping the jq-only dep contract.
do_status() {
    reap_dead_players
    collect_failed_players

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        local n=${#LIVE_PLAYER_FILES[@]}
        if ((n)); then
            local i parts=()
            for ((i = 0; i < n; i++)); do
                read_player_live "$(player_sock "${LIVE_PLAYER_IDS[$i]}")"
                parts+=("$(jq -c \
                    --argjson live "${LP_VOLUME:-null}" \
                    --argjson paused "${LP_PAUSED:-null}" \
                    --argjson position "${LP_POSITION:-null}" \
                    --argjson duration "${LP_DURATION:-null}" \
                    '{id, pid, url, mode, volume: ($live // .volume),
                      paused: $paused, position: $position, duration: $duration,
                      title, started_at}' \
                    "${LIVE_PLAYER_FILES[$i]}")")
            done
            # -sc: one line, like the empty branch below and every other envelope. The
            # pretty form only ever showed up with a player present, i.e. exactly when a
            # caller is polling this.
            printf '%s\n' "${parts[@]}" |
                jq -sc --argjson failed "$FAILED_JSON" '{status: "players", players: ., failed: $failed}'
        else
            jq -nc --argjson failed "$FAILED_JSON" '{status: "players", players: [], failed: $failed}'
        fi
    else
        if ((${#LIVE_PLAYER_FILES[@]})); then
            local f id pid mode started_at url title volume vol_suffix pause_suffix
            for f in "${LIVE_PLAYER_FILES[@]}"; do
                vol_suffix=""
                pause_suffix=""
                # One jq call for the structural fields (never contain tabs/newlines) via
                # @tsv, instead of five separate per-field forks. title stays on its own
                # jq -r so a title with an embedded tab/newline round-trips byte-for-byte
                # rather than being @tsv-escaped.
                IFS=$'\t' read -r id pid mode started_at url < <(
                    jq -r '[.id, .pid, .mode, .started_at, .url] | @tsv' "$f" 2>/dev/null
                ) || true
                title=$(jq -r '.title // empty' "$f" 2>/dev/null || true)
                read_player_live "$(player_sock "$id")"
                volume="$LP_VOLUME"
                [[ -n "$volume" ]] || volume=$(jq -r '.volume // empty' "$f" 2>/dev/null || true)
                [[ -n "$volume" ]] && vol_suffix=", volume $volume"
                # Only `paused` joins the human line: a person reading this wants to know why
                # it went quiet. The position pair stays JSON-only — the human who wants a
                # playhead has `ytt`, which draws one, and this line is already long.
                [[ "$LP_PAUSED" == "true" ]] && pause_suffix=", paused"
                if [[ -n "$title" ]]; then
                    printf "playing (id %s, pid %s, mode %s%s%s, since %s): %s\n  %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$pause_suffix" "$started_at" "$title" "$url"
                else
                    printf "playing (id %s, pid %s, mode %s%s%s, since %s): %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$pause_suffix" "$started_at" "$url"
                fi
            done
        else
            echo "idle (nothing playing)"
        fi
        # After the live list, not instead of it: a player can have failed while another is
        # still playing. Same wording as the JSON `failed` entries, one line each.
        if [[ "$FAILED_JSON" != "[]" ]]; then
            jq -r '.[] | "failed (id \(.id), mode \(.mode), \(.reason), exit \(.exit_code), ended \(.ended_at)): \(.url)"' \
                <<<"$FAILED_JSON" 2>/dev/null || true
        fi
    fi
    exit 0
}

# Stop detached playback. Idempotent: exits 0 when nothing (or nothing matching) is
# playing. --all stops every live player; otherwise a single target is resolved
# (exactly-one is zero-friction; 2+ without --id is ambiguous → exit 4).
do_stop() {
    local want_id=$1 stop_all=$2
    local id any=false

    if ((stop_all)); then
        # reap_dead_players already rm'd every dead player's state/sock/log; the survivors
        # are exactly the ones to stop. Kill each group, then remove its state/sock/log.
        reap_dead_players
        local i n=${#LIVE_PLAYER_FILES[@]}
        ((n > 0)) && any=true
        for ((i = 0; i < n; i++)); do
            stop_group "${LIVE_PLAYER_PIDS[$i]}"
            rm -f "${LIVE_PLAYER_FILES[$i]}" 2>/dev/null || true
            rm -f "$(player_sock "${LIVE_PLAYER_IDS[$i]}")" "$(player_log "${LIVE_PLAYER_IDS[$i]}")" 2>/dev/null || true
        done
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --argjson stopped "$any" '{status: "stopped", scope: "all", stopped: $stopped}'
        else
            if [[ "$any" == true ]]; then echo "stopped all playback"; else echo "nothing to stop"; fi
        fi
        exit 0
    fi

    if ! resolve_target "$want_id"; then
        if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
            if [[ "$OUTPUT_MODE" == "json" ]]; then
                jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
            else
                echo "multiple players playing; specify --id or --all (see 'ut-play --status')" >&2
            fi
            exit 4
        fi
        # not_playing → idempotent success, not an error.
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc '{status: "stopped", stopped: false}'
        else
            echo "nothing to stop"
        fi
        exit 0
    fi

    local sf pid_stop
    id=$RESOLVED_ID
    sf=$(player_state "$id")
    pid_stop=$(jq -r '.pid // empty' "$sf" 2>/dev/null || true)
    if group_alive "$pid_stop"; then
        stop_group "$pid_stop"
        any=true
    fi
    rm -f "$sf" 2>/dev/null || true
    rm -f "$(player_sock "$id")" "$(player_log "$id")" 2>/dev/null || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson stopped "$any" '{status: "stopped", id: $id, stopped: $stopped}'
    else
        if [[ "$any" == true ]]; then echo "stopped playback (player $id)"; else echo "nothing to stop"; fi
    fi
    exit 0
}

# Adjust volume on a detached player via mpv's per-instance JSON IPC socket. One-shot:
# open, send, read the matching ack, close, exit (stateless-per-call). Exit 4 for any
# "did not take effect" (no such/no player, ambiguous, or IPC failure); the -j
# status/reason carries the why. See SPEC-system.md §14/§15.
do_set_volume() {
    local n=$1 want_id=$2
    is_non_negative_int "$n" || die "--set-volume must be a non-negative integer"
    ((n <= 100)) || die "--set-volume must be between 0 and 100" # symmetry w/ launch --volume

    if ! resolve_target "$want_id"; then
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
                jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
            else
                echo '{"status":"not_playing"}'
            fi
        else
            if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
                echo "multiple players playing; specify --id (see 'ut-play --status')" >&2
            else
                echo "nothing playing" >&2
            fi
        fi
        exit 4
    fi

    local id sock
    id=$RESOLVED_ID
    sock=$(player_sock "$id")
    if [[ ! -S "$sock" ]]; then
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"ipc_failed"}' || echo "failed to set volume (no IPC socket)" >&2
        exit 4
    fi

    # request_id correlation: mpv multiplexes ASYNC EVENTS to every client, interleaved
    # with replies (mpv ipc.rst), so head -1 alone can grab an event. Filter by request_id.
    # `|| true` is REQUIRED — under set -euo pipefail the pipeline exits non-zero on nc
    # timeout / SIGPIPE (head closing early) and would abort the script AT the assignment.
    local reply
    reply=$(printf '{"command":["set_property","volume",%d],"request_id":1}\n' "$n" |
        nc -U -w1 "$sock" 2>/dev/null |
        jq -c 'select(.request_id==1)' 2>/dev/null | head -1) || true

    if [[ "$(jq -r '.error // empty' <<<"$reply" 2>/dev/null)" != success ]]; then
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"ipc_failed"}' || echo "failed to set volume" >&2
        exit 4
    fi

    # Atomic patch of this player's state file (temp+mv, same idiom as patch_player_meta),
    # under the same per-id lock so this can't interleave with a concurrent title backfill.
    local sf tmp
    sf=$(player_state "$id")
    tmp="$sf.tmp.$$"
    lock_player_state "$id"
    if jq --argjson v "$n" '.volume = $v' "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson volume "$n" '{status: "ok", id: $id, volume: $volume}'
    else
        echo "volume set to $n (player $id)"
    fi
    exit 0
}

# ==============================================================================
# 5. CLI OPTIONS PARSING & VALIDATION
# ==============================================================================

PLAYBACK_MODE="audio"
FORMAT_SORT=""
VOLUME=""
COLOR_MODE="auto"
# Default output is prose; -j/-J select a machine envelope.
OUTPUT_MODE="list"
# Playback lifecycle / structured-output state.
DETACH=0
ENGINE="$UT_DEFAULT_ENGINE"  # which <engine>-resolve turns a handle into bytes
ACTION=""            # "" (normal) | status | stop | set-volume
ACTION_FLAG=""       # the flag that set ACTION, for conflict messages
PLAYBACK_RETRIED=0   # relayed from the resolve envelope; surfaced in the playback JSON
SET_VOLUME_ARG=""    # value from --set-volume N
TARGET_ID=""         # value from --id (target a specific detached player)
STOP_ALL=0           # --stop --all
RESOLVED_ID=""       # resolve_target out-param: the resolved player id
RESOLVE_ERR=""       # resolve_target out-param: "not_playing" | "ambiguous"
RESOLVE_PLAYERS_JSON="[]"  # resolve_target out-param: candidates on ambiguity
STATE_DIR="${TMPDIR:-/tmp}/yt-cli-$(id -u)"
PLAYERS_DIR="$STATE_DIR/players"   # one <id>.json per detached player

# Actions are mutually exclusive; a caller asking for two used to silently get whichever
# flag came last. Name both flags in the error instead of guessing an intent.
set_action() {
    local want=$1 flag=$2
    if [[ -n "$ACTION" && "$ACTION" != "$want" ]]; then
        die "conflicting actions: $ACTION_FLAG and $flag"
    fi
    ACTION="$want"
    ACTION_FLAG="$flag"
}

normalized_args=()
while (($#)); do
    case "$1" in
    --)
        # End of options: everything after it is the query/URL, VERBATIM. Without this the
        # loop kept scanning past `--`, so a query that merely LOOKS like a long flag became
        # an action (`yt -l -- --status` listed players instead of searching for the text).
        # The `--` is forwarded to getopts too — getopts stops there (verified on bash 3.2),
        # so a query/URL starting with a single dash survives as well. This is the guard the
        # wrappers rely on when they delegate (SPEC-system.md §6).
        normalized_args+=("--")
        shift
        while (($#)); do
            normalized_args+=("$1")
            shift
        done
        break
        ;;
    --help)
        normalized_args+=("-h")
        shift
        ;;
    --version)
        normalized_args+=("-V")
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || die "--color requires a value"
        COLOR_MODE="$2"
        shift 2
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --engine)
        [[ $# -ge 2 ]] || die "--engine requires a value"
        ENGINE="$2"
        shift 2
        ;;
    --engine=*)
        ENGINE="${1#*=}"
        shift
        ;;
    --volume)
        [[ $# -ge 2 ]] || die "--volume requires a value"
        VOLUME="$2"
        shift 2
        ;;
    --volume=*)
        VOLUME="${1#*=}"
        shift
        ;;
    --list|-l)
        normalized_args+=("-l")
        shift
        ;;
    --json|-j)
        normalized_args+=("-j")
        shift
        ;;
    --detach)
        normalized_args+=("-d")
        shift
        ;;
    --status)
        set_action status --status
        shift
        ;;
    --stop)
        set_action stop --stop
        shift
        ;;
    --get-url)
        # Retired, not renamed: resolving a stream URL is what a bare `yt-resolve` call IS,
        # so the player forwarding a verb of its own was a second spelling of one contract.
        die "--get-url is gone — resolve a stream URL with 'yt-resolve -j -- <id|URL>'"
        ;;
    --info | --transcript | --subtitles | --sub-lang | --sub-langs \
        | --sub-lang=* | --sub-langs=*)
        # Extraction verbs, forwarded from here until the wrapper merge — and a forward is
        # the copy the split exists to remove. Name the engine rather than reporting an
        # unknown flag: the caller has the right suite, wrong half.
        die "${1%%=*} is an engine verb — run 'yt-resolve ${1%%=*} -- <id|URL>' (metadata and captions are extraction)"
        ;;
    --set-volume)
        [[ $# -ge 2 ]] || die "--set-volume requires a value"
        set_action set-volume --set-volume
        SET_VOLUME_ARG="$2"
        shift 2
        ;;
    --set-volume=*)
        set_action set-volume --set-volume
        SET_VOLUME_ARG="${1#*=}"
        shift
        ;;
    --id)
        [[ $# -ge 2 ]] || die "--id requires a value"
        TARGET_ID="$2"
        shift 2
        ;;
    --id=*)
        TARGET_ID="${1#*=}"
        shift
        ;;
    --all)
        STOP_ALL=1
        shift
        ;;
    --*)
        # Every long flag is handled in THIS loop (getopts below sees only short ones), so
        # an unmatched one can never be valid — and left to fall through it reached getopts
        # as `-`, which reported the useless "invalid option: --". The wrapper used to hold
        # this arm; naming the real flags is the half of a gate that helps a caller recover.
        die "unknown flag '$1' (play flags: -f -S -d -j -l --engine --volume --status --stop --set-volume --id --all --color)"
        ;;
    *)
        normalized_args+=("$1")
        shift
        ;;
    esac
done
if ((${#normalized_args[@]})); then
    set -- "${normalized_args[@]}"
else
    set --
fi

while getopts ":f:S:dljhV" opt; do
    case "$opt" in
    f) PLAYBACK_MODE=$(normalize_playback_mode "$OPTARG") ;;
    S) FORMAT_SORT="$OPTARG" ;;
    d) DETACH=1 ;;
    l) OUTPUT_MODE="list" ;;
    j) OUTPUT_MODE="json" ;;
    h)
        usage
        exit 0
        ;;
    # Answered before ANY dependency gate: a version is the first thing a bug report needs,
    # and needing yt-dlp installed to find out which version you have is backwards.
    V)
        printf 'ut-play %s\n' "$YT_VERSION"
        exit 0
        ;;
    :)
        die "option -$OPTARG requires an argument"
        ;;
    \?)
        # The gate the yt-play wrapper used to hold: a search flag here is a caller who
        # picked the wrong verb, and "invalid option: -n" does not say which verb is right.
        case "$OPTARG" in
        n | m | M | s) die "-$OPTARG is a search flag — use yt-search for searching" ;;
        J) die "-J (full raw record) is an engine flag — try 'yt-resolve --info -J'" ;;
        esac
        die "invalid option: -$OPTARG"
        ;;
    esac
done

shift $((OPTIND - 1))

QUERY="$*"

if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi
if [[ -n "$VOLUME" ]]; then
    if ! is_non_negative_int "$VOLUME"; then
        die "--volume must be a non-negative integer"
    fi
    if ((VOLUME > 100)); then
        die "--volume must be between 0 and 100"
    fi
fi

# Flag combinations that used to be accepted and silently ignored. --id/--all only mean
# something to the lifecycle verbs, -d is a launch rather than an action, and a detached
# player has no terminal for the terminal-rendering modes to draw into (§9.2).
if [[ -n "$TARGET_ID" ]] && [[ "$ACTION" != stop && "$ACTION" != set-volume ]]; then
    die "--id applies only to --stop and --set-volume"
fi
if ((STOP_ALL)) && [[ "$ACTION" != stop ]]; then
    die "--all applies only to --stop"
fi
if ((DETACH)) && [[ -n "$ACTION" ]]; then
    die "-d/--detach cannot be combined with $ACTION_FLAG"
fi
if ((DETACH)) && [[ "$PLAYBACK_MODE" == "ascii" || "$PLAYBACK_MODE" == "viz" ]]; then
    die "-d/--detach cannot use -f $PLAYBACK_MODE: a detached player has no terminal to render into (use audio, video, or fast)"
fi

# A HANDLE is what the player forwards to an engine: a URL, or an engine-specific media id
# (`dQw4w9WgXcQ`, `BV1FPjy6TEiE`). The player deliberately CANNOT tell a good id from a bad
# one — that shape is engine knowledge, and giving it up is the whole point of the split — so
# it rejects only what is not a handle at all: empty, or containing whitespace, which is a
# search query and belongs to a different verb. An unresolvable handle therefore surfaces as
# a propagated engine failure (2+), not a usage error. docs/PLAN-ut-restructure.md §5 B-3.
IS_HANDLE=0
if [[ -n "${QUERY//[[:space:]]/}" && "$QUERY" != *[[:space:]]* ]]; then
    IS_HANDLE=1
fi

# Every remaining ACTION (status / stop / set-volume) addresses a running PLAYER, not a
# piece of media, so --detach is the only verb left that needs a handle.
if ((DETACH)) && ((! IS_HANDLE)); then
    die "--detach requires a video id or URL"
fi

# A bare invocation (no handle, no lifecycle action) is a usage error (D3). Report it before
# the heavier mpv dependency check so the message is about the missing input, not a missing
# player. Searching lives in yt-search; interactive browsing in ut-tui.
if ((! IS_HANDLE)) && [[ -z "${QUERY//[[:space:]]/}" ]] && [[ -z "$ACTION" ]]; then
    die "provide a video id or URL (to search, run yt-search; for interactive browsing, ut-tui)"
fi

# Lifecycle queries need only jq and take no handle — answer them before the heavier
# mpv dependency check and before any routing.
if [[ "$ACTION" == "status" ]]; then
    require_cmd jq
    do_status
fi
if [[ "$ACTION" == "stop" ]]; then
    require_cmd jq
    do_stop "${TARGET_ID:-}" "$STOP_ALL"
fi
# --set-volume drives a running player over its IPC socket: needs jq + nc, but NOT mpv,
# and takes no handle. nc is gated lazily HERE (not in require_deps) so a plain play never
# demands it. BSD `nc -U` is stock on macOS (first use in
# this script); on Linux the -U flag varies by netcat variant (known gap, SPEC-system.md).
if [[ "$ACTION" == "set-volume" ]]; then
    require_cmd jq
    require_cmd nc
    do_set_volume "$SET_VOLUME_ARG" "${TARGET_ID:-}"
fi
# yt-dlp is no longer a dependency of the PLAYER: extraction belongs to the engine, which
# gates its own tools. What is left here is what actually plays and shapes output.
require_deps jq mpv

if [[ "$PLAYBACK_MODE" == "ascii" ]]; then
    if ! mpv_supports_vo "$YT_ASCII_VO"; then
        die "mpv does not support --vo=$YT_ASCII_VO (run 'mpv --vo=help' to choose a supported terminal VO)"
    fi
fi

# =-----------------------------------------------------------------------------
# ROUTING: play a handle. Search left for yt-search (B-1); extraction for yt-resolve (B-2).
# =-----------------------------------------------------------------------------
if ((IS_HANDLE)); then
    if ((DETACH)); then
        detach_play "$QUERY"
        exit 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        rc=0
        play_url_json "$QUERY" "$PLAYBACK_MODE" || rc=$?
        exit "$rc"
    fi
    # rc is captured rather than left to set -e so the DETACHED child gets one line of
    # epilogue before it goes (detached_epitaph is a no-op for every other caller — a
    # foreground play has a terminal to have already shown the error on). The exit status is
    # unchanged either way: set -e would have exited with exactly this rc.
    rc=0
    play_url_directly "$QUERY" || rc=$?
    detached_epitaph "$rc"
    exit "$rc"
fi

# =-----------------------------------------------------------------------------
# Not a handle: nothing left to route. Search moved out to the engine (yt-search) when the
# suite split into player + engines, and the core's old D2 contract (bare `yt "query"` ->
# list) went with it. Anything reaching here is a caller holding the wrong tool.
# docs/PLAN-ut-restructure.md §5 B-1.
# =-----------------------------------------------------------------------------
die "'$QUERY' is not a video id or URL — run 'yt-search -- $QUERY' to search for it"
