#!/usr/bin/env bash
# yt-tui — interactive terminal browser for YouTube (self-rendered menu). Owned glue, not a
# client: the human-facing surface, ZERO YouTube logic. It composes the headless verbs with jq.
#
# Delegates core jobs to headless binaries:
#   search (network fetch) → yt-search -j <query>   (JSON envelope)
#   play                   → yt-play -d -j -f MODE -- url  (ASYNCHRONOUS: detached background player)
#   filter (narrow rows)   → pure bash, no external tool
#
# yt-tui renders its OWN menu with dual switchable views:
#   Mode B (List View)           → interactive result list + live Now-Playing mini banner
#   Mode A (Now Playing Focus)   → dedicated full-screen Now-Playing metadata & control card
# Toggle between Mode A and Mode B with [Tab] at any time without stopping audio.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features (no ${v,,}, no mapfile); guard
# empty-array expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). §28.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Locate the sibling verbs: next to this file when run from shell-scripts/ (or from a bin/
# that happens to symlink them too), else by the same relative hop the wrappers themselves
# use to reach the core. That hop is what makes this work when bin/ carries ONLY the short
# names — invoked as bin/ytt, SCRIPT_DIR is the bin/ dir and bin/yt-search does not exist,
# but bin/../../shell-scripts does, because the kernel resolves `..` through the bin symlink
# into env-config. PATH stays as the last resort.
if [[ -x "$SCRIPT_DIR/yt-search" && -x "$SCRIPT_DIR/yt-play" ]]; then
    YT_SEARCH="$SCRIPT_DIR/yt-search"
    YT_PLAY="$SCRIPT_DIR/yt-play"
elif [[ -x "$SCRIPT_DIR/../../shell-scripts/yt-search" && -x "$SCRIPT_DIR/../../shell-scripts/yt-play" ]]; then
    YT_SEARCH="$SCRIPT_DIR/../../shell-scripts/yt-search"
    YT_PLAY="$SCRIPT_DIR/../../shell-scripts/yt-play"
elif command -v yt-search >/dev/null 2>&1 && command -v yt-play >/dev/null 2>&1; then
    YT_SEARCH=$(command -v yt-search)
    YT_PLAY=$(command -v yt-play)
else
    echo "yt-tui: cannot locate yt-search / yt-play" >&2
    exit 1
fi

print_usage() {
    cat <<'EOF'
yt-tui — interactive terminal browser for YouTube

Usage:
  yt-tui [options] [search query]

With no query, prompts for one (interactive). Requires a terminal.

Search options (forwarded to yt-search):
  -n NUM    Number of results to fetch (default: 25)
  -m SEC    Minimum duration in seconds
  -M SEC    Maximum duration in seconds
  -s FIELD  Sort field: relevance | view_count | duration (default: relevance)

Menu options:
  -f MODE   Playback mode (default: audio): audio | video | fast
            (playback is detached — ascii/viz need a terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: unset -> mpv's own default;
              launch-time only, no live volume-cycle key)
  -p NUM    Rows per page (default: 10, capped to the terminal height)
  --color MODE  Color: auto | always | never (default: auto)
  --theme NAME  Palette: minimal (default) | mono | catppuccin | tokyonight | nord
                | gruvbox | onedark. Every theme = one signature accent + one status
                green; mono = gray hierarchy only, no hue. Community themes emit
                24-bit color when COLORTERM=truecolor, else ANSI-16 fallbacks.
                Light/dark picks the theme's own light variant (see YT_BG below).
  -h        This help

Keys (List View):
  ↑/↓      move selection              ←/→  change page
  Enter    play / switch track (non-blocking background playback)
  Tab / p  cycle view: List → Now Playing card → mini player → List
  Esc      (in card / mini player) back to List View
  Space    pause / resume playback
  s        stop playback
  9 / 0    volume down / up (via IPC)
  [ / ]    seek backward / forward 10s (via IPC; works in every view)
  v        cycle playback mode: audio → video → fast (applies to next play)
  l        switch chrome language (en <-> zh), any view
  t        cycle palette family live (minimal → catppuccin → tokyonight → nord →
           gruvbox → onedark → mono), any view; no-op when colors are off
  n        new search (fetch a different query without interrupting music)
  m        more results (re-fetch current query, +25 to count)
  o        rotate sort field / order (relevance → view_count → duration), re-fetch
  /        live filter — type to narrow instantly; ↑/↓ select, Enter play, Esc clear
  q        quit (stops background playback on exit)

Keys (Now Playing card / mini player):
  ←/→      seek backward / forward 5s   ↑/↓  volume down / up
  Tab      next view                    Esc  back to List View
  Space    pause / resume               s    stop playback     q  quit

Environment:
  YT_ASCII=1       Use ASCII glyphs (♫ ● ○ ❯ · ▶ ❚❚ • … → — arrows → ASCII) for
                   terminals whose font can't draw them. Auto-on for non-UTF-8 locales.
                   Shared with the rest of the suite. Legacy alias: YT_TUI_ASCII.
  YT_LANG=en|zh    Language of the menu chrome. Default: zh under a zh* locale,
                   English otherwise (help text and errors are always English).
  YT_THEME=minimal|mono|catppuccin|tokyonight|nord|gruvbox|onedark
                   Palette family (same as --theme; default: minimal).
  YT_BG=auto|light|dark  Background mode. auto: $COLORFGBG, then an OSC 11 terminal
                   query, then dark. For minimal/mono, light swaps cyan for blue; for
                   community themes it picks the theme's own light variant.
  YT_SYNC=0|1|auto  Synchronized redraws (DCS 1q/2q; default auto: on, off under tmux).
  YT_BRAND=1       Header wordmark in mathematical sans-serif bold ("𝗬 𝗧  𝗧 𝗨 𝗜").
                   OPT-IN: your terminal font must cover the U+1D5D4 block, else tofu.
                   ASCII mode (YT_ASCII=1) always wins.
  NO_COLOR=1       Disables color in --color auto mode (an explicit --color wins).
  YT_AMBIG_WIDE=1  Measure East-Asian-Ambiguous glyphs (· — • … arrows ─ ━ ○ ● ▶) as
                   TWO cells. Only needed if your terminal is set to treat ambiguous
                   width as double-width; every terminal ships with that option off.
EOF
}

die() {
    echo "yt-tui: $1" >&2
    exit 1
}

require_cmd() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "requires '$c' (not found on PATH)"
    done
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Parse: search-shaping flags forwarded to yt-search (and captured for status line);
# -f/-p/--color are menu-local. The rest is query. Reject anything else.
SEARCH_ARGS=()
RESULT_N=25          # fetch count; -n overrides. Runtime-mutable: m adds 25 (more_results).
PLAY_MODE="audio"        # -f flag overrides. Runtime-mutable: v key rotates it (cycle_mode).
MODE_CYCLE=(audio video fast)  # order the v key steps through
PLAY_VOLUME=""           # --volume flag overrides
COLOR_MODE="auto"
THEME="minimal"          # --theme / YT_THEME override: minimal | mono (palette family)
BG_MODE="auto"           # YT_BG override: auto | light | dark (accent hue selection)
BG="dark"
[[ -n "${YT_THEME:-}" ]] && THEME="$YT_THEME"
[[ -n "${YT_BG:-}" ]] && BG_MODE="$YT_BG"
PAGE_OPT=10
SORT_FIELD="relevance"   # -s flag overrides. Runtime-mutable: o key rotates it (cycle_sort).
SORT_CYCLE=(relevance view_count duration)  # order the o key steps through
MIN_DISP="0"
MAX_DISP="0"
query=()
while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    -n)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESULT_N="$2"; shift 2 ;;
    -s)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SORT_FIELD="$2"; shift 2 ;;
    -m)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MIN_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -M)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MAX_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -f)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_MODE="$2"; shift 2 ;;   # validated against MODE_CYCLE below
    -p)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PAGE_OPT="$2"; shift 2 ;;
    --color)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        COLOR_MODE="$2"; shift 2 ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --theme)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        THEME="$2"; shift 2 ;;
    --theme=*) THEME="${1#*=}"; shift ;;
    --volume)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_VOLUME="$2"; shift 2 ;;
    --volume=*) PLAY_VOLUME="${1#*=}"; shift ;;
    --)
        shift
        while (($#)); do query+=("$1"); shift; done
        break ;;
    -*) die "unknown flag '$1' (yt-tui flags: -n -m -M -s -f -p --color --theme --volume); run 'yt-tui -h'" ;;
    *) query+=("$1"); shift ;;
    esac
done

is_uint "$PAGE_OPT" && ((PAGE_OPT > 0)) || die "-p must be a positive integer"
is_uint "$RESULT_N" && ((RESULT_N > 0)) || die "-n must be a positive integer"
case " ${SORT_CYCLE[*]} " in *" $SORT_FIELD "*) ;; *) die "-s must be one of: ${SORT_CYCLE[*]}" ;; esac
# Playback is DETACHED here (yt-play -d), and a detached player has no terminal, so the
# terminal-rendering modes (ascii/viz) cannot work — the core rejects them for -d. Validate
# up front instead of letting an Enter fail silently. Same list the v key cycles.
case " ${MODE_CYCLE[*]} " in *" $PLAY_MODE "*) ;; *) die "-f must be one of: ${MODE_CYCLE[*]} (ascii/viz need a terminal, which detached playback has none of)" ;; esac
case "$COLOR_MODE" in auto | always | never) ;; *) die "--color must be one of: auto, always, never" ;; esac
case "$THEME" in minimal | mono | catppuccin | tokyonight | nord | gruvbox | onedark) ;; *) die "--theme must be one of: minimal, mono, catppuccin, tokyonight, nord, gruvbox, onedark" ;; esac
case "$BG_MODE" in auto | light | dark) ;; *) die "YT_BG must be one of: auto, light, dark" ;; esac

# nc as well as jq: every transport key (pause, seek, volume) and every time readout goes
# through `nc -U` on the player's socket, so a machine without it loses half the TUI at the
# first keypress rather than at start-up.
require_cmd jq nc
# The self-rendered menu reads keys from stdin and draws to stdout, so BOTH must be a real
# terminal; refuse cleanly rather than hang/garble when piped (e.g. an agent).
{ [[ -t 0 ]] && [[ -t 1 ]]; } || die "requires a terminal (interactive menu); use yt-search / yt-play headless"

# ── Theme & Colors (init_theme): palette family + light/dark + protocol knobs ───────────
# Minimalist palette, terminal-native: minimal/mono use ANSI 16 indexed codes only, so the
# chrome follows the user's terminal theme, never imposes its own. The community themes
# (catppuccin/tokyonight/nord/gruvbox/onedark) emit 24-bit RGB only when the terminal
# advertises COLORTERM=truecolor; otherwise they fall back to the nearest ANSI-16 index.
# Every theme passes through the same minimalist filter: hierarchy by gray levels
# (dim → normal → bold), hue is ONE accent (C_CYAN) plus ONE status hue (C_GREEN).
# C_YELLOW is retired — it stays defined ("" in every theme) so the five sites that still
# read it render default foreground; deleting it would be eight site edits for zero
# behavior change. C_MARK is the selection/filter marker (bold + accent). Light/dark
# (YT_BG=auto → $COLORFGBG → OSC 11 query → dark) picks the theme's own light variant
# (mocha/latte, night/day, polar-night/snow-storm, gruvbox dark/light, onedark/one-light);
# for minimal it swaps cyan for blue, readable on white.
# --color auto honors NO_COLOR. YT_SYNC: synchronized redraws (DCS 1 q/2 q), on by default,
# off under tmux (see display_menu).
C_RESET=''; C_BOLD=''; C_CYAN=''; C_YELLOW=''; C_DIM=''; C_GREEN=''; C_MARK=''
SYNC_ON=0
COLORTERM_TC=0
COLORS_ON=0             # set by init_colors; gates the live theme cycle (t key)
# TrueColor support: kitty/ghostty/wezterm/alacritty/konsole advertise COLORTERM.
# The community themes below emit 24-bit RGB ONLY then; otherwise they fall back to
# the nearest ANSI-16 index, so the chrome stays correct on limited terminals.
init_colorterm() {
    case "${COLORTERM:-}" in
    truecolor | 24bit) COLORTERM_TC=1 ;;
    esac
}
set_theme() {
    # Community themes (catppuccin/tokyonight/nord/gruvbox/onedark) pass through the
    # same minimalist filter as minimal: ONE signature accent + ONE status green,
    # gray hierarchy for everything else. Hexes are the official palettes; light/dark
    # is the theme's own light variant (catppuccin mocha/latte, tokyonight night/day,
    # nord polar-night/snow-storm, gruvbox dark/light, onedark/one-light).
    local acc_r acc_g acc_b st_r st_g st_b a16
    case "$THEME" in
    minimal)
        C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YELLOW=''
        C_MARK=$'\033[1;36m'
        if [[ "$BG" == light ]]; then
            C_CYAN=$'\033[34m'; C_MARK=$'\033[1;34m'
        fi
        ;;
    mono)
        C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_MARK=$'\033[1m'
        ;;
    catppuccin | tokyonight | nord | gruvbox | onedark)
        C_YELLOW=''
        case "$THEME:$BG" in
        catppuccin:dark)  acc_r=203; acc_g=166; acc_b=247; st_r=166; st_g=227; st_b=161; a16=35 ;;
        catppuccin:light) acc_r=136; acc_g=57;  acc_b=239; st_r=64;  st_g=160; st_b=43;  a16=35 ;;
        tokyonight:dark)  acc_r=122; acc_g=162; acc_b=247; st_r=158; st_g=206; st_b=106; a16=34 ;;
        tokyonight:light) acc_r=46;  acc_g=125; acc_b=233; st_r=88;  st_g=117; st_b=57;  a16=34 ;;
        nord:dark)        acc_r=136; acc_g=192; acc_b=208; st_r=163; st_g=190; st_b=140; a16=36 ;;
        nord:light)       acc_r=94;  acc_g=129; acc_b=172; st_r=163; st_g=190; st_b=140; a16=36 ;;
        gruvbox:dark)     acc_r=214; acc_g=93;  acc_b=14;  st_r=152; st_g=151; st_b=26;  a16=33 ;;
        gruvbox:light)    acc_r=175; acc_g=58;  acc_b=3;   st_r=121; st_g=116; st_b=14;  a16=31 ;;
        onedark:dark)     acc_r=97;  acc_g=175; acc_b=239; st_r=152; st_g=195; st_b=121; a16=34 ;;
        onedark:light)    acc_r=64;  acc_g=120; acc_b=242; st_r=80;  st_g=161; st_b=79;  a16=34 ;;
        esac
        if ((COLORTERM_TC)); then
            printf -v C_CYAN '\033[38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            printf -v C_MARK '\033[1;38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            printf -v C_GREEN '\033[38;2;%d;%d;%dm' "$st_r" "$st_g" "$st_b"
        else
            C_CYAN=$'\033['"$a16"m
            C_MARK=$'\033[1;'"$a16"m
            C_GREEN=$'\033[32m'
        fi
        ;;
    esac
}
init_colors() {
    local on=0
    case "$COLOR_MODE" in
    auto) [[ -t 1 && -z "${NO_COLOR:-}" ]] && on=1 ;;
    always) on=1 ;;
    never) on=0 ;;
    esac
    COLORS_ON=0
    if ((on)); then
        COLORS_ON=1
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        set_theme
    fi
}
init_sync() {
    case "${YT_SYNC:-auto}" in
    0 | off) SYNC_ON=0 ;;
    1 | on) SYNC_ON=1 ;;
    auto) [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]] && SYNC_ON=1 || SYNC_ON=0 ;;
    *) die "YT_SYNC must be 0, 1 or auto (got '$YT_SYNC')" ;;
    esac
}
detect_bg() {
    local fgbg b resp="" rgb rr gg bb
    case "$BG_MODE" in
    light) BG=light; return ;;
    dark) BG=dark; return ;;
    auto) ;;
    *) die "YT_BG must be one of: auto, light, dark (got '$BG_MODE')" ;;
    esac
    # $COLORFGBG is "fg;bg" (rxvt family): bg == 15 (white) → light. Non-numeric → no signal.
    fgbg="${COLORFGBG:-}"
    if [[ "$fgbg" == *";"* ]]; then
        b="${fgbg##*;}"
        if [[ "$b" =~ ^[0-9]+$ ]]; then
            if ((b == 15)); then BG=light; else BG=dark; fi
            return
        fi
    fi
    # OSC 11 background query (kitty/ghostty/wezterm/iTerm2/xterm-family answer; tmux and
    # dumb terminals don't — skip so auto costs no startup stall there). bash 3.2's read -t
    # takes only WHOLE seconds, so one unanswered probe costs 1 s once at startup.
    if [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]]; then
        printf '\033]11;?\033\\'
        # Assemble the reply byte-by-byte (3.2 has no read -d) until BEL or ST ends it.
        while IFS= read -rsn1 -t 1 b; do
            resp+="$b"
            case "$resp" in
            *$'\a'*) break ;;
            *$'\033\\'*) break ;;
            esac
            if ((${#resp} > 64)); then break; fi
        done
        # kitty answers "rgb:1c1c/1c1c/1c1c" (16-bit); xterm "rgb:1c/1c/1c" (8-bit).
        rgb="${resp#*rgb:}"; rgb="${rgb%%[$'\a'$'\033'\\]*}"
        if [[ "$rgb" == *"/"* ]]; then
            rr=""; gg=""; bb=""
            IFS='/' read -r rr gg bb <<<"$rgb" || true
            if [[ "$rr" =~ ^[0-9a-fA-F]{2,4}$ && "$gg" =~ ^[0-9a-fA-F]{2,4}$ && "$bb" =~ ^[0-9a-fA-F]{2,4}$ ]]; then
                local r8=$((16#$rr)) g8=$((16#$gg)) b8=$((16#$bb))
                if (( ${#rr} == 4 )); then r8=$((r8 / 257)); fi
                if (( ${#gg} == 4 )); then g8=$((g8 / 257)); fi
                if (( ${#bb} == 4 )); then b8=$((b8 / 257)); fi
                if ((r8 + g8 + b8 > 384)); then BG=light; else BG=dark; fi  # mid-gray boundary
            fi
        fi
    fi
}
init_theme() {
    detect_bg
    init_sync
    init_colorterm
    init_colors
}
init_theme

# ── UI language (init_ui_strings): Chinese under a zh locale, English otherwise ─────────
# The chrome's labels were Chinese literals while help text, errors and field labels are
# English, so the tool read as two languages at once and was unusable for a non-Chinese
# reader. UI_LANG picks one: YT_LANG=en|zh wins, else a zh* locale selects Chinese, else
# English (which also covers cron/CI, where LANG is usually unset). Strings are resolved
# ONCE into globals rather than looked up per draw — bash 3.2 has no associative arrays,
# and a lookup function would fork or re-branch on every redraw.
UI_LANG=""
# set_ui_lang <en|zh> — fill the table. Kept separate from the initial choice below so the
# `l` key can re-resolve it live without re-reading the environment.
set_ui_lang() {
    UI_LANG=$1
    if [[ "$UI_LANG" == "zh" ]]; then
        S_NAV="导航:"
        S_SELECT="选择"; S_PAGE="翻页"; S_PLAY="播放"; S_VIEW="视图"; S_MODE="模式"
        S_SEARCH="搜索"; S_MORE="更多"; S_SORT="排序"; S_FILTER="过滤"
        S_STOP="停止"; S_QUIT="退出"; S_LANGKEY="语言"
        S_FOCUS="专注卡片"; S_PAUSE="暂停"; S_VOL="音量"
        S_BACK_LIST="返回列表选单"; S_PAUSE_RESUME="暂停 / 继续"; S_SEEK5="快退 / 快进 5s"
        S_VOL_ADJUST="调节音量"; S_STOP_PLAY="停止播放"
        S_LIST_MENU="列表选单"; S_SEEK5_SHORT="5s快进退"
        S_NOTHING="(暂无正在播放的音频)"; S_BACK_SEARCH="返回搜索列表"; S_PLAY_SEL="播放选中歌曲"
    else
        S_NAV="Navigation:"
        S_SELECT="select"; S_PAGE="page"; S_PLAY="play"; S_VIEW="view"; S_MODE="mode"
        S_SEARCH="search"; S_MORE="more"; S_SORT="sort"; S_FILTER="filter"
        S_STOP="stop"; S_QUIT="quit"; S_LANGKEY="language"
        S_FOCUS="focus card"; S_PAUSE="pause"; S_VOL="volume"
        S_BACK_LIST="back to list"; S_PAUSE_RESUME="pause / resume"; S_SEEK5="seek -/+ 5s"
        S_VOL_ADJUST="volume"; S_STOP_PLAY="stop playback"
        S_LIST_MENU="list menu"; S_SEEK5_SHORT="seek 5s"
        S_NOTHING="(nothing playing)"; S_BACK_SEARCH="back to results"; S_PLAY_SEL="play selection"
    fi
}

# Toggle the chrome language in place (key: l). The card and mini player redraw on their
# 1s tick; the list view redraws when the menu loop comes back around.
cycle_ui_lang() {
    if [[ "$UI_LANG" == "zh" ]]; then set_ui_lang en; else set_ui_lang zh; fi
}

# Cycle the palette family in place (key: t). set_theme is a pure function of
# (THEME, BG, COLORTERM_TC), so a live re-resolve is safe — the same function startup
# used. Gated on COLORS_ON so --color never / NO_COLOR / non-TTY sessions cannot paint
# the chrome mid-session. Order: minimal → catppuccin → tokyonight → nord → gruvbox →
# onedark → mono → back.
THEME_CYCLE=(minimal catppuccin tokyonight nord gruvbox onedark mono)
cycle_theme() {
    ((COLORS_ON)) || return 0
    local i n=${#THEME_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${THEME_CYCLE[$i]}" == "$THEME" ]] && { cur=$i; break; }
    done
    THEME="${THEME_CYCLE[$(( (cur + 1) % n ))]}"
    set_theme
}

init_ui_strings() {
    case "${YT_LANG:-}" in
    en | zh) set_ui_lang "$YT_LANG" ;;
    "")
        case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
        zh* | *_zh*) set_ui_lang zh ;;
        *) set_ui_lang en ;;
        esac
        ;;
    *) die "YT_LANG must be en or zh (got '$YT_LANG')" ;;
    esac
}
init_ui_strings

# ── Glyphs (init_glyphs): Unicode by default; ASCII fallbacks ───────────────────────────
GL_NOTE="♫"; GL_LIVE="● LIVE"; GL_SEP="·"; GL_CARET="❯"; ASCII_GLYPHS=0
# Everything else the chrome draws. These used to be hardcoded, so YT_ASCII=1 still left
# ▶ / ❚❚ / ● and the arrow hints as tofu on a font that can't draw them.
GL_PLAY="▶"; GL_PAUSE="❚❚"; GL_DOT="●"; GL_DOT_OFF="○"; GL_AV="↑/↓"; GL_AH="←/→"; GL_ENTER="↵"
GL_BULLET="•"; GL_ELL="…"; GL_ARROW="→"; GL_DASH="—"
init_glyphs() {
    # One switch for the whole suite: YT_ASCII, with YT_TUI_ASCII kept as a legacy alias
    # (the core reads the same pair — a font that can't draw ♫ can't draw it anywhere).
    case "${YT_ASCII:-${YT_TUI_ASCII:-}}" in
    1 | true | yes | on) ASCII_GLYPHS=1 ;;
    *)
        case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8* | *utf-8* | *UTF8* | *utf8*) ASCII_GLYPHS=0 ;;
        *) ASCII_GLYPHS=1 ;;   # empty / non-UTF-8 locale → assume a limited terminal
        esac
        ;;
    esac
    if ((ASCII_GLYPHS)); then
        GL_NOTE=""; GL_LIVE="LIVE"; GL_SEP="|"; GL_CARET=">"
        GL_PLAY=">"; GL_PAUSE="||"; GL_DOT="*"; GL_DOT_OFF="o"; GL_AV="Up/Dn"; GL_AH="Lt/Rt"; GL_ENTER="Enter"
        GL_BULLET="-"; GL_ELL="..."; GL_ARROW="->"; GL_DASH="-"
    fi
    # Brand wordmark (YT_BRAND=1): the three view headers render "𝗬 𝗧  𝗧 𝗨 𝗜" in
    # mathematical sans-serif bold (U+1D5D4 block). OPT-IN on purpose: terminal fonts
    # vary, and a font without that block shows tofu — your call, your eyes. Width is
    # whatever the font gives; char_w's conservative 2-cell overcount keeps the query
    # elision safe in either case (over-count packs early, never overflows). ASCII mode
    # always wins — a font that cannot draw ♫ cannot draw these either.
    GL_BRAND="yt-tui"
    case "${YT_BRAND:-}" in
    1 | true | yes | on) ((ASCII_GLYPHS)) || GL_BRAND="𝗬 𝗧  𝗧 𝗨 𝗜" ;;
    esac
}
init_glyphs

# Field separator inside the row records that build_all_rows emits and load_rows /
# apply_filter split: ASCII US (0x1f), deliberately NOT tab. See build_all_rows.
US=$'\x1f'

# ── Playback & View State Model ─────────────────────────────────────────────────────────
TUI_VIEW_MODE="list"       # "list" (Search List) | "card" (Mode A: Focus Card) | "mini" (Mode B: Mini Player)

CURRENT_PLAY_ID=""
CURRENT_PLAY_PID=""
CURRENT_PLAY_URL=""
CURRENT_PLAY_TITLE=""
CURRENT_PLAY_CHANNEL=""
CURRENT_PLAY_DURATION=""
CURRENT_PLAY_MODE=""
CURRENT_PLAY_SOCK=""
CURRENT_PLAY_PAUSED=0
# A live stream has no meaningful position: mpv reports time-pos on the whole
# broadcast-so-far timeline with duration = the live edge, so percent-pos sits at
# ~99.98% from the first second and the progress bar is pinned full. Track liveness
# (from the row's own live_status, which build_all_rows already renders as GL_LIVE) and
# show elapsed listening time instead of a fake position. Measured on a 24/7 radio:
# time-pos=77390 duration=77403 percent-pos=99.98.
CURRENT_PLAY_IS_LIVE=0
CURRENT_PLAY_STARTED=0     # epoch seconds when WE attached, for the elapsed readout

# Cursor helpers
# Terminal size. NOT `$(tput cols)`: inside command substitution ncurses can miss the
# window-size ioctl and silently answer with terminfo's default 80x24 — measured here, a
# 60-column tmux pane reported 80, so the card drew 80-wide rails and every line (rails,
# wrapped title, progress bar) wrapped. `stty size` reads the real ioctl through /dev/tty,
# which this UI is guaranteed to have (it refuses to start without a TTY on stdin+stdout).
# tput stays as the fallback, then a hard default.
term_size() {
    local sz
    sz=$(stty size </dev/tty 2>/dev/null || true)
    TERM_LINES=${sz%% *}
    TERM_COLS=${sz##* }
    [[ "$TERM_COLS" =~ ^[0-9]+$ ]] || TERM_COLS=$(tput cols 2>/dev/null || echo 80)
    [[ "$TERM_LINES" =~ ^[0-9]+$ ]] || TERM_LINES=$(tput lines 2>/dev/null || echo 24)
}

cursor_hide() { tput civis 2>/dev/null || true; }
cursor_show() { tput cnorm 2>/dev/null || true; }

# ── IPC & Playback Controls ─────────────────────────────────────────────────────────────
send_mpv_ipc() {
    local cmd="$1"
    # return 0, not 1, on a missing socket: fire-and-forget is this function's contract (the
    # nc failure below is already swallowed), and it is the LAST command of toggle_pause /
    # seek_relative / adjust_volume — a 1 here becomes the function's status, reaches the
    # case arm, and set -e kills the TUI on a keypress whose effect is optional anyway.
    [[ -n "$CURRENT_PLAY_SOCK" && -S "$CURRENT_PLAY_SOCK" ]] || return 0
    printf '%s\n' "$cmd" | nc -U -w1 "$CURRENT_PLAY_SOCK" >/dev/null 2>&1 || true
}

# The read side of the same socket: one property, on stdout, empty on any failure. Callers
# check the socket once and then ask for several properties (see fetch_play_times).
mpv_get_prop() {
    printf '{"command":["get_property","%s"]}\n' "$1" |
        nc -U -w1 "$CURRENT_PLAY_SOCK" 2>/dev/null | jq -r '.data // empty' 2>/dev/null || true
}

fmt_sec() {
    local s=${1%.*}
    [[ "$s" =~ ^[0-9]+$ ]] || { echo "--:--"; return; }
    local h=$((s / 3600))
    local m=$(((s % 3600) / 60))
    local sec=$((s % 60))
    if ((h > 0)); then
        printf "%02d:%02d:%02d" "$h" "$m" "$sec"
    else
        printf "%02d:%02d" "$m" "$sec"
    fi
}

# The envelope's duration_fmt (`06h:10m:58s`, or `1d 00h:37m:03s` past a day) is a wire
# format, not a column: 11 cells of zero padding and unit letters for what reads as 6:10:58.
# Sets SHORT_DUR. Unparseable or empty -> "--:--"; a LIVE row is NOT detected here, because
# the row carries live_status as its own field and the caller reads that instead of
# inferring liveness from a missing duration.
# Pure bash by the same rule as the width layer: this runs once per row per redraw, so a
# sed/awk here would be one fork per row per keystroke in filter mode.
SHORT_DUR=""
short_dur() {
    local s=$1 d h m sec
    if [[ "$s" =~ ^(([0-9]+)d[[:space:]]+)?([0-9]+)h:([0-9]+)m:([0-9]+)s$ ]]; then
        d=${BASH_REMATCH[2]:-0}
        # 10# on every field: "06" and "08" are octal to $(( )), and "08" is not even valid
        # octal — an 8-minute video would have aborted the redraw.
        h=$((10#${BASH_REMATCH[3]} + 24 * 10#$d))
        m=$((10#${BASH_REMATCH[4]}))
        sec=$((10#${BASH_REMATCH[5]}))
        if ((h > 0)); then
            printf -v SHORT_DUR '%d:%02d:%02d' "$h" "$m" "$sec"
        else
            printf -v SHORT_DUR '%d:%02d' "$m" "$sec"
        fi
        return 0
    fi
    SHORT_DUR="--:--"
}

# 27264629 -> 27,264,629. Sets COMMAS. Same no-fork rule as short_dur (`sed -e :a -e
# s/.../` per row per redraw was the alternative). Non-numeric input passes through.
COMMAS=""
commas() {
    local n=$1 out=""
    if [[ ! "$n" =~ ^[0-9]+$ ]]; then
        COMMAS="$n"
        return 0
    fi
    while ((${#n} > 3)); do
        out=",${n: -3}$out"
        n=${n:0:${#n} - 3}
    done
    COMMAS="$n$out"
}

# Repeat a single-cell glyph n times (n may be 0). NOT `printf 'x%.0s' $(seq 1 $n)`:
# printf always walks its format at least once, so with zero arguments that idiom emits
# one stray cell — which is what made the bar 46 cells wide at 0% and 47 at 100%.
# Returns through GLYPH_RUN, the same no-fork discipline as the width layer below: every
# caller sits on the once-a-second redraw path, where $(...) is a subshell per call.
GLYPH_RUN=""
repeat_glyph() {
    local glyph=$1 n=$2 out=""
    while ((n > 0)); do
        out+="$glyph"
        ((n--))
    done
    GLYPH_RUN="$out"
}

# The width every view lays out against: the real terminal width, floored at 40 (below that
# nothing fits, and clamping beats drawing garbage) and optionally capped at <max>. Sets
# LAYOUT_COLS. All three views carried this clamp trio inline. The cap is deliberately not
# uniform — the two player cards pass 80 so their rails do not stretch across an ultrawide
# window, the list view passes nothing and uses the full width for its rows — and passing it
# as an argument is what makes that asymmetry visible instead of looking like a lost line.
LAYOUT_COLS=0
layout_cols() {
    local max=${1:-0}
    term_size
    LAYOUT_COLS=$TERM_COLS
    ((max > 0 && LAYOUT_COLS > max)) && LAYOUT_COLS=$max
    ((LAYOUT_COLS < 40)) && LAYOUT_COLS=40
    return 0
}

# Divider rail for the player cards, cached on (width, glyph mode): it is redrawn every
# second and only changes when the terminal is resized or the glyph mode flips. Sets
# DIV_STR. This was `printf '─%.0s' $(seq 1 "$cols")` — a fork plus precisely the idiom
# repeat_glyph exists to replace — run twice, once to build the Unicode rail and again to
# throw it away in ASCII mode.
DIV_STR=""
DIV_KEY=""
card_divider() {
    local cols=$1 glyph='─' key
    ((ASCII_GLYPHS)) && glyph='-'
    key="$cols/$glyph"
    if [[ "$key" != "$DIV_KEY" ]]; then
        repeat_glyph "$glyph" "$cols"
        DIV_STR="$GLYPH_RUN"
        DIV_KEY="$key"
    fi
    return 0
}

# ── Adaptive chrome layout ──────────────────────────────────────────────────────────────
# ── Cell width: ONE rule, in ONE place (char_w) ──────────────────────────────────────────
# The rule: a non-ASCII character counts as TWO cells — exact for CJK (East-Asian Wide) and
# conservative for everything else, which is the safety property. Over-counting packs a row
# a cell or two early and can never run off the edge; under-counting overflows. So the
# default stays two, and only characters MEASURED to be otherwise are tabled below.
#
# The chrome's own glyphs are one such table, and they are safe to table because the suite's
# glyph inventory is deliberately all text-presentation — "non-graphical". There is no emoji
# anywhere in yt / yt-search / yt-play / yt-tui, so none of these characters can carry a
# U+FE0F and silently become a 2-cell emoji glyph behind the table's back. All 17 measured
# at ONE cell (tmux over Ghostty, `tmux display-message -p '#{cursor_x}'`):
#   Neutral EAW    ↵ ♫ ❚ ❯                      one cell in EVERY terminal
#   Ambiguous EAW  · — • … ← ↑ → ↓ ─ ━ ○ ● ▶    one cell unless a terminal is explicitly
#                                               configured ambiguous-wide
# The split is read off the UCD (unicodedata.east_asian_width), not guessed: ♫ U+266B is
# Neutral, so it stays one cell even under YT_AMBIG_WIDE.
# One cell is the DEFAULT everywhere in use here: Ghostty (grapheme-width-method = unicode),
# and Terminal.app / iTerm2 / tmux, where "treat ambiguous-width as double-width" is an
# opt-in that ships off. YT_AMBIG_WIDE=1 restores the conservative 2 for the Ambiguous row
# if that option is ON. It is an explicit knob and not a locale guess, because the locale
# says nothing: Ghostty under a zh_CN locale still renders these one cell.
# Note the bar already assumed this — render_prog_bar promises a string of exactly <total>
# cells built from ━ ─ ●, which only holds at one cell each.
# The table applies wherever these characters occur, titles included, not only to chrome.
#
# What IS corrected is the zero-width class, where "two cells" is wrong in every terminal.
# The base character is still counted as two, so each of these makes the whole sequence come
# out EXACT rather than merely conservative:
#   U+200D ZWJ, U+FE0E/U+FE0F VS15/VS16    joiner and presentation selectors  ☕️ = 2 (was 4)
#   U+1F3FB..U+1F3FF skin-tone modifiers                                      👍🏽 = 2 (was 4)
#   U+0300..U+036F, U+20D0..U+20F0, U+FE20..U+FE2F combining marks         e+◌́ = 1 (was 2)
# Regional indicators (U+1F1E6..U+1F1FF) count ONE each, so a flag pair is 2 (was 4).
# Combining marks outside those blocks (Arabic, Devanagari, Thai) are not in the table and
# stay over-counted — conservative, never short. A ZWJ emoji sequence still over-counts
# (👨‍👩‍👧 measures 6, drawn as 2); collapsing that needs a real grapheme-cluster walk, which is
# not worth its weight in bash 3.2.
#
# The tables are byte-built at startup instead of written as string literals: a source line
# full of invisible combining marks is unreadable and un-editable.
CW_ZWJ=$'\xe2\x80\x8d'
CW_ZERO=""      # characters that add no cells
CW_NARROW=""    # non-ASCII characters that still take only one, in any terminal
CW_AMBIG='·—•…←↑→↓─━○●▶'    # East-Asian Ambiguous: one cell, or two under YT_AMBIG_WIDE
CW_AMBIG_W=1
CW_RANGE=""
cw_range() {
    local prefix=$1 lo=$2 hi=$3 pat ch
    CW_RANGE=""
    while ((lo <= hi)); do
        printf -v pat '%s\\x%02x' "$prefix" "$lo"
        printf -v ch "$pat"
        CW_RANGE+="$ch"
        ((lo++))
    done
}
init_cell_tables() {
    CW_ZERO="$CW_ZWJ"
    cw_range '\xef\xb8'     142 143; CW_ZERO+="$CW_RANGE"    # U+FE0E..U+FE0F  variation selectors
    cw_range '\xcc'         128 191; CW_ZERO+="$CW_RANGE"    # U+0300..U+033F  combining marks
    cw_range '\xcd'         128 175; CW_ZERO+="$CW_RANGE"    # U+0340..U+036F  combining marks
    cw_range '\xe2\x83'     144 176; CW_ZERO+="$CW_RANGE"    # U+20D0..U+20F0  marks for symbols
    cw_range '\xef\xb8'     160 175; CW_ZERO+="$CW_RANGE"    # U+FE20..U+FE2F  half marks
    cw_range '\xf0\x9f\x8f' 187 191; CW_ZERO+="$CW_RANGE"    # U+1F3FB..U+1F3FF skin tones
    cw_range '\xf0\x9f\x87' 166 191                          # U+1F1E6..U+1F1FF regional indicators
    CW_NARROW="↵♫❚❯$CW_RANGE"                                # U+21B5 U+266B U+275A U+276F: Neutral EAW
    case "${YT_AMBIG_WIDE:-}" in
    1 | true | yes | on) CW_AMBIG_W=2 ;;
    esac
}
init_cell_tables

# Cells taken by ONE character. Returns through CHAR_W: this is the innermost loop of every
# measurement, so no subshell, no command substitution. All four measuring sites (disp_w,
# truncate_disp, and both of wrap_print's loops) go through here — when the rule lived
# inline in each of them, a fix to one silently disagreed with the other three, and
# measurement disagreeing with line-breaking is worse than a uniform over-count.
CHAR_W=0
char_w() {
    local c=$1
    if [[ "$c" == [[:ascii:]] ]]; then CHAR_W=1; return; fi
    if [[ "$CW_ZERO" == *"$c"* ]]; then CHAR_W=0; return; fi
    if [[ "$CW_NARROW" == *"$c"* ]]; then CHAR_W=1; return; fi
    if [[ "$CW_AMBIG" == *"$c"* ]]; then CHAR_W=$CW_AMBIG_W; return; fi
    CHAR_W=2
}

# Display width of PLAIN text. Colours are applied at print time and never measured. Returns
# through a global (DISP_W) rather than stdout: this runs several times per redraw, and
# $(...) would mean a subshell fork per measurement. Pure-ASCII strings — most of the chrome
# — skip the per-character walk entirely, so this is FASTER than the inline test it replaced
# (300 measurements of the mini-player hint row: 94ms before, 5ms after).
# Accumulate with `n=$((n + CHAR_W))`, never `((n += CHAR_W))`: an arithmetic command whose
# result is 0 returns exit status 1, and a leading zero-width character would abort the whole
# script under `set -e`.
DISP_W=0
disp_w() {
    local s=$1 i n=0
    if [[ "$s" != *[![:ascii:]]* ]]; then
        DISP_W=${#s}
        return
    fi
    for ((i = 0; i < ${#s}; i++)); do
        char_w "${s:$i:1}"
        n=$((n + CHAR_W))
    done
    DISP_W=$n
}

# Pull a cut point back out of the middle of a grapheme cluster. Severing a base character
# from its combining mark, joiner or flag partner does not merely mis-measure — it draws the
# WRONG GLYPH: half a flag renders as a lone letter tile, an orphaned VS16 or ZWJ attaches
# itself to the ellipsis instead. Given <text> and the index of the first character NOT being
# emitted, walk left until that index is a real cluster boundary. Sets CUT_AT.
#
# The live cases are a ZWJ sequence ("…👨" + a cut joiner) and a flag split between its two
# regional indicators — note an RI only blocks the cut when the character BEFORE it is also
# an RI, or every cut landing in front of a flag would needlessly eat the character before
# it. The zero-width test is a guard, not a live path: a 0-cell character never trips a
# budget test, so a cut can never land directly on one.
CUT_AT=0
cluster_back() {
    local text=$1 i=$2 c p
    while ((i > 0)); do
        c="${text:$i:1}"                 # first character NOT being emitted
        p="${text:$((i - 1)):1}"         # last character being emitted
        if [[ "$CW_ZERO" == *"$c"* || "$p" == "$CW_ZWJ" ]] ||
            [[ "$CW_NARROW" == *"$c"* && "$CW_NARROW" == *"$p"* ]]; then
            ((i--))
            continue
        fi
        break
    done
    CUT_AT=$i
}

# Cut PLAIN text to at most <cells> display columns, marking an elision. Sets TRUNC_TEXT
# (same no-fork discipline as disp_w). Used where a variable-length value shares a
# single-line budget with fixed chrome — the list view's Now-Playing banner.
TRUNC_TEXT=""
truncate_disp() {
    local text=$1 max=$2 mark="$GL_ELL" i w=0
    disp_w "$text"
    if ((DISP_W <= max)); then
        TRUNC_TEXT="$text"
        return
    fi
    disp_w "$mark"
    local budget=$((max - DISP_W))
    # The one promise this function makes is "at most <max> cells". Clamping the budget up
    # to 1 broke it: at max=1 it emitted a character AND the mark, two cells. When the
    # budget cannot hold the mark, the mark goes. No caller reaches this today (they all
    # clamp their budget to >= 8) — it is the guard on the function's only contract.
    if ((budget < 1)); then
        mark=""
        budget=$max
    fi
    if ((budget < 1)); then
        TRUNC_TEXT=""
        return
    fi
    for ((i = 0; i < ${#text}; i++)); do
        char_w "${text:$i:1}"
        ((w + CHAR_W > budget)) && break
        w=$((w + CHAR_W))
    done
    cluster_back "$text" "$i"
    TRUNC_TEXT="${text:0:$CUT_AT}${mark}"
}

# print_hints <width> <first_prefix> <cont_prefix> "key<TAB>label" | "field" …
# Packs items into as few lines as fit <width>, two spaces between items; an item with no
# TAB is a plain field (no label). The chrome used to print each view's hints as ONE fixed
# string, which simply ran off the right edge and wrapped mid-item below ~72 columns —
# sooner still because the labels are CJK, i.e. double-width. Every emitted line carries
# \033[K for the in-place card/mini renders. HINT_KEY_COLOR overrides the key style for
# one call (the status row wants its fields dim, not key-bold). HINT_LINES reports how many
# lines were emitted: this block is variable-height by design, and the list view has to know
# its real height to decide how many result rows fit (see the reflow in display_list_menu).
# HINT_MEASURE=1 runs the identical packing and reports HINT_LINES without drawing anything,
# so a caller can ask "how tall would this block be?" before committing the space to it. Same
# code path deliberately: a separate estimator would be free to disagree with the printer.
HINT_KEY_COLOR=""
HINT_LINES=0
HINT_MEASURE=0
print_hints() {
    local width=$1 first_p=$2 cont_p=$3
    shift 3
    HINT_LINES=0
    local item key label out="" out_w=0 iw ind_w first=1
    local kc=${HINT_KEY_COLOR:-$C_BOLD}
    disp_w "$first_p"
    ind_w=$DISP_W
    out_w=$ind_w
    for item in "$@"; do
        key=${item%%$'\t'*}
        label=""
        [[ "$item" == *$'\t'* ]] && label=${item#*$'\t'}
        disp_w "$key"
        iw=$DISP_W
        if [[ -n "$label" ]]; then
            disp_w "$label"
            ((iw += 1 + DISP_W))
        fi
        if [[ -n "$out" ]] && ((out_w + 2 + iw > width)); then
            if ((first)); then
                ((HINT_MEASURE)) || printf '%s%s%s%s\033[K\n' "$C_BOLD" "$first_p" "$C_RESET" "$out"
                first=0
                disp_w "$cont_p"
                ind_w=$DISP_W
            else
                ((HINT_MEASURE)) || printf '%s%s\033[K\n' "$cont_p" "$out"
            fi
            HINT_LINES=$((HINT_LINES + 1))
            out=""
            out_w=$ind_w
        fi
        if [[ -n "$out" ]]; then
            out+="  "
            ((out_w += 2))
        fi
        if [[ -n "$label" ]]; then
            out+="${kc}${key}${C_RESET} ${C_DIM}${label}${C_RESET}"
        else
            out+="${kc}${key}${C_RESET}"
        fi
        ((out_w += iw))
    done
    if [[ -n "$out" ]]; then
        if ((first)); then
            ((HINT_MEASURE)) || printf '%s%s%s%s\033[K\n' "$C_BOLD" "$first_p" "$C_RESET" "$out"
        else
            ((HINT_MEASURE)) || printf '%s%s\033[K\n' "$cont_p" "$out"
        fi
        HINT_LINES=$((HINT_LINES + 1))
    fi
}

# Elapsed wall-clock since we attached to a stream, as HH:MM:SS / MM:SS. Used for live
# streams, where mpv's own time-pos is a position on the broadcast timeline (hours in) and
# says nothing about how long this listener has been tuned in.
elapsed_since_play() {
    ((CURRENT_PLAY_STARTED > 0)) || { printf '%s' "--:--"; return; }
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    ((now >= CURRENT_PLAY_STARTED)) || { printf '%s' "--:--"; return; }
    fmt_sec $((now - CURRENT_PLAY_STARTED))
}

# Position / duration / percent for the attached mpv, fetched in ONE place: sets PT_CUR,
# PT_TOTAL and PT_PCT (PT_PCT empty means "draw no bar"). Both player views inlined the same
# three nc|jq pipelines and had already drifted — the card built its percent string and bar
# inline, the mini deferred the bar to a later block. The live special case belongs here too:
# "mpv's clock describes the broadcast, not this listen" is a fact about the fetch, not about
# a view, and returning early also spares three IPC round-trips per second that the live path
# only fetched to discard.
PT_CUR=""
PT_TOTAL=""
PT_PCT=""
fetch_play_times() {
    PT_CUR="--:--"
    PT_TOTAL="$CURRENT_PLAY_DURATION"
    PT_PCT=""
    if ((CURRENT_PLAY_IS_LIVE)); then
        PT_CUR=$(elapsed_since_play)
        PT_TOTAL="$GL_LIVE"
        return 0
    fi
    [[ -n "$CURRENT_PLAY_SOCK" && -S "$CURRENT_PLAY_SOCK" ]] || return 0
    local raw_pos raw_dur raw_pct
    raw_pos=$(mpv_get_prop time-pos)
    raw_dur=$(mpv_get_prop duration)
    raw_pct=$(mpv_get_prop percent-pos)
    [[ -n "$raw_pos" && "$raw_pos" != "null" ]] && PT_CUR=$(fmt_sec "$raw_pos")
    [[ -n "$raw_dur" && "$raw_dur" != "null" ]] && PT_TOTAL=$(fmt_sec "$raw_dur")
    [[ -n "$raw_pct" && "$raw_pct" != "null" ]] && PT_PCT=${raw_pct%.*}
    return 0
}

# Progress bar sized to the caller's layout. $2 is the FULL cell width the bar may occupy,
# brackets included, so a caller can line its right edge up with the card's divider rails
# (or the mini player's content edge) instead of the old hardcoded 44 columns that ignored
# the terminal width entirely. The rendered string is ALWAYS exactly that many cells —
# the head glyph is part of the track, and `filled` is capped at width-1 so it stays so at
# 100%; a bar whose length changed with position made the whole line jitter every second.
PROG_BAR=""
render_prog_bar() {
    local pct=${1%.*} total=${2:-44}
    PROG_BAR=""
    [[ "$pct" =~ ^[0-9]+$ ]] || return 0
    ((pct > 100)) && pct=100
    ((pct < 0)) && pct=0
    ((total < 10)) && total=10

    local width=$((total - 2))            # the track, minus the two brackets
    local filled=$((pct * width / 100))
    ((filled > width - 1)) && filled=$((width - 1))
    local empty=$((width - filled - 1))   # track = filled + head + empty

    local f_str e_str head='●' fill='━' rest='─'
    if ((ASCII_GLYPHS)); then
        head='#'
        fill='='
        rest='-'
    fi
    repeat_glyph "$fill" "$filled"; f_str=$GLYPH_RUN
    repeat_glyph "$rest" "$empty"; e_str=$GLYPH_RUN
    PROG_BAR="[${f_str}${head}${e_str}]"
}

# One emit point for every line wrap_print produces, so WRAP_LINES and the measure switch
# cannot drift from the printer (a separate estimator would be free to disagree — the same
# reason print_hints measures through its own packing code).
WRAP_LINES=0
WRAP_MEASURE=0
wrap_emit() {
    ((WRAP_MEASURE)) || printf '%s%s\033[K\n' "$1" "$2"
    WRAP_LINES=$((WRAP_LINES + 1))
}

wrap_print() {
    local text="$1" max_w="$2" first_p="$3" cont_p="$4"
    WRAP_LINES=0
    local words=()
    read -ra words <<< "$text"

    local line="" cur_w=0 first=1
    local w w_len i c c_w

    for w in "${words[@]}"; do
        disp_w "$w"
        w_len=$DISP_W

        if ((w_len > max_w)); then
            if [[ -n "$line" ]]; then
                if ((first)); then
                    wrap_emit "$first_p" "$line"
                    first=0
                else
                    wrap_emit "$cont_p" "$line"
                fi
                line=""
                cur_w=0
            fi
            # A zero-width character has c_w=0, so it can never trip the test below and
            # never starts a continuation line — combining marks, VS and ZWJ stay attached to
            # their base for free. A flag pair (two 1-cell regional indicators) can still be
            # split here; this branch only runs for a single word wider than the whole line,
            # so it is not worth a cluster_back walk.
            for (( i = 0; i < ${#w}; i++ )); do
                c="${w:$i:1}"
                char_w "$c"
                c_w=$CHAR_W
                if ((cur_w + c_w > max_w)); then
                    if ((first)); then
                        wrap_emit "$first_p" "$line"
                        first=0
                    else
                        wrap_emit "$cont_p" "$line"
                    fi
                    line="$c"
                    cur_w=$c_w
                else
                    line+="$c"
                    cur_w=$((cur_w + c_w))
                fi
            done
            continue
        fi

        local need_w=$w_len
        [[ -n "$line" ]] && ((need_w += 1))

        if ((cur_w + need_w > max_w)); then
            if ((first)); then
                wrap_emit "$first_p" "$line"
                first=0
            else
                wrap_emit "$cont_p" "$line"
            fi
            line="$w"
            cur_w=$w_len
        else
            if [[ -z "$line" ]]; then
                line="$w"
                cur_w=$w_len
            else
                line="$line $w"
                ((cur_w += w_len + 1))
            fi
        fi
    done

    if [[ -n "$line" ]]; then
        if ((first)); then
            wrap_emit "$first_p" "$line"
        else
            wrap_emit "$cont_p" "$line"
        fi
    fi
}

# print_details <width> <index> — the details section under the list: a rail, the FULL
# title wrapped over as many lines as it needs, and one dim metadata line. This is the half
# of a result a single row cannot show: the rows spend their width on titles and a duration
# rail, and the full title, channel, view count and video id live here for the SELECTED row
# only. Recovering the full title is the reason the block exists — it is the one field a row
# can never show whole — so it is wrapped, not elided, and takes the height it needs.
#
# DETAIL_MEASURE=1 runs the identical code path and reports DETAIL_LINES without drawing,
# mirroring HINT_MEASURE / print_hints. The measure mode is not a convenience: the block
# prints AFTER the rows but its height has to be known BEFORE them, or a long title costs
# the header instead of a row.
DETAIL_LINES=0
DETAIL_MEASURE=0
print_details() {
    local width=$1 i=$2 dur views vid meta
    DETAIL_LINES=0
    ((i >= 0 && i < NUM_ENTRIES)) || return 0
    if [[ "${R_LIVE[$i]}" == "is_live" ]]; then
        # Here a glyph reads as a badge, so the details line gets the "● LIVE" form the rows
        # deliberately do not (a numeric column wants no glyph in it).
        dur="$GL_LIVE"
        views="live now"
    else
        short_dur "${R_DUR[$i]}"
        dur="$SHORT_DUR"
        # An absent view count is NOT zero views: the envelope reports null when the count
        # was not published, and printing "0 views" for it states a fact we do not have.
        if [[ -n "${R_VIEWS[$i]}" ]]; then
            commas "${R_VIEWS[$i]}"
            views="$COMMAS views"
        else
            views=""
        fi
    fi
    card_divider "$width"
    ((DETAIL_MEASURE)) || printf '%s%s%s\n' "$C_DIM" "$DIV_STR" "$C_RESET"
    DETAIL_LINES=1
    # The same clean-ed title the row measured, so a row and its details cannot disagree
    # about what the video is called.
    WRAP_MEASURE=$DETAIL_MEASURE
    wrap_print "${R_TITLE[$i]}" $((width - 2)) "  " "  "
    WRAP_MEASURE=0
    DETAIL_LINES=$((DETAIL_LINES + WRAP_LINES))
    # The id is DERIVED from the url rather than carried as a seventh field. The '?' below is
    # a glob metacharacter in this expansion and matches the literal '?' of "watch?v=".
    vid="${urls[$i]}"
    vid="${vid#*watch?v=}"
    meta="${R_CHAN[$i]} $GL_SEP $dur"
    [[ -n "$views" ]] && meta+=" $GL_SEP $views"
    meta+=" $GL_SEP $vid"
    truncate_disp "$meta" $((width - 2))
    ((DETAIL_MEASURE)) || printf '  %s%s%s\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
    DETAIL_LINES=$((DETAIL_LINES + 1))
}

toggle_pause() {
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    # Assignment form, not ((CURRENT_PLAY_PAUSED = 1 - CURRENT_PLAY_PAUSED)): an arithmetic
    # command evaluating to 0 returns status 1, so UNPAUSING (1 -> 0) aborted the whole
    # script under set -e — the second Space press killed the TUI. Same trap as char_w and
    # the banner's b_fixed, which already carry this note.
    CURRENT_PLAY_PAUSED=$((1 - CURRENT_PLAY_PAUSED))
    send_mpv_ipc '{"command":["cycle","pause"]}'
}

seek_relative() {
    local offset="$1"
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    send_mpv_ipc "{\"command\":[\"seek\",$offset,\"relative\"]}"
}

adjust_volume() {
    local delta="$1"
    [[ -n "$CURRENT_PLAY_ID" ]] || return 0
    send_mpv_ipc "{\"command\":[\"add\",\"volume\",$delta]}"
}

stop_current_playback() {
    if [[ -n "$CURRENT_PLAY_ID" ]]; then
        "$YT_PLAY" --stop --id "$CURRENT_PLAY_ID" -j >/dev/null 2>&1 || true
        CURRENT_PLAY_ID=""
        CURRENT_PLAY_PID=""
        CURRENT_PLAY_SOCK=""
        CURRENT_PLAY_TITLE=""
        CURRENT_PLAY_CHANNEL=""
        CURRENT_PLAY_DURATION=""
        CURRENT_PLAY_MODE=""
        CURRENT_PLAY_PAUSED=0
        CURRENT_PLAY_IS_LIVE=0
        CURRENT_PLAY_STARTED=0
    fi
}

cleanup_on_exit() {
    cursor_show
    stop_current_playback
}
trap cleanup_on_exit EXIT INT TERM HUP

# Page size: default 10, provisionally capped to terminal height so the FIRST load_rows has a
# NUM_PAGES to work with. It is only provisional: display_list_menu reflows PAGE_SIZE against
# the chrome it actually measured, every redraw (see the reflow block there).
term_size; LINES_N=$TERM_LINES
PAGE_SIZE=$PAGE_OPT
PAGE_CAP=$(( LINES_N - 8 ))
((PAGE_CAP >= 3)) || PAGE_CAP=3
((PAGE_SIZE <= PAGE_CAP)) || PAGE_SIZE=$PAGE_CAP

# Interactive: with no query on command line, prompt for one. Empty / Ctrl-D cancels.
if ((${#query[@]} == 0)); then
    printf '%s Search YouTube: ' "$GL_CARET" >&2
    IFS= read -r _q || { printf '\n' >&2; exit 0; }
    [[ -n "${_q//[[:space:]]/}" ]] || { echo "yt-tui: no query entered" >&2; exit 0; }
    query=("$_q")
fi
QUERY_LABEL="${query[*]}"

# ── SEARCH delegate ─────────────────────────────────────────────────────────────────────
SEARCH_ERR=""
fetch_json() {
    local out cnt errfile rc=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/yt-tui-search-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/yt-tui-search-err.$$"
    out=$("$YT_SEARCH" -j -n "$RESULT_N" -s "$SORT_FIELD" ${SEARCH_ARGS[@]+"${SEARCH_ARGS[@]}"} -- "$QUERY_LABEL" 2>"$errfile") || rc=$?
    SEARCH_ERR=$(<"$errfile")
    rm -f "$errfile"
    ((rc == 0)) || return 1
    cnt=$(printf '%s' "$out" | jq -r '.count // 0' 2>/dev/null || echo 0)
    [[ "$cnt" != "0" ]] || return 2
    json="$out"
    return 0
}

# ONE record per result: six raw fields, no composed display string. The composed string
# was the whole bug — a row was `title · dur · views · channel` elided from the right, so a
# narrow terminal spent the entire truncation budget on the metadata and left a chopped
# title with nothing beside it. Now the row renders title + duration rail, print_details
# renders the rest for the selected row, and apply_filter synthesizes its own haystack.
#
# Joined by US (0x1f), NOT tab: `IFS=$'\t' read` COLLAPSES RUNS OF TABS because tab is an
# IFS *whitespace* character, so one empty field shifts every field after it — and a live
# row has an empty duration_fmt, which is exactly how the mockup came to read a channel
# name as a view count. US is not IFS whitespace, so empty fields survive the split.
# `oneline` on the channel for the same reason `clean` collapses the title: a newline in a
# field would split one record into two.
build_all_rows() {
    ALL_ROWS=$(printf '%s' "$json" | jq -r '
      def clean:
        gsub("[\\x{1F000}-\\x{1FAFF}\\x{2190}-\\x{21FF}\\x{2300}-\\x{27BF}\\x{2B00}-\\x{2BFF}\\x{FE00}-\\x{FE0F}\\x{200D}\\x{2122}\\x{2139}]"; "")
        | gsub("\\s+"; " ") | gsub("^ | $"; "");
      def oneline: gsub("\\s+"; " ") | gsub("^ | $"; "");
      .results[]
      | [ .url,
          (.title // "" | clean),
          (.duration_fmt // ""),
          (.view_count | if . == null then "" else tostring end),
          (.channel // "?" | oneline),
          (.live_status // "")
        ] | join("\u001f")')
}

apply_search_results() {
    build_all_rows
    FILTER_LABEL=""
    FILTER_MODE=0
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
}

# Split the records into parallel arrays (bash 3.2 — no associative arrays, no array of
# arrays). `urls` keeps its name and its job: the play target. The R_ arrays are the fields
# the row rail and the details block read; nothing here is pre-rendered, so both can render
# from the same numbers and cannot disagree about a row.
load_rows() {
    urls=()
    R_TITLE=(); R_DUR=(); R_VIEWS=(); R_CHAN=(); R_LIVE=()
    local url title dur views chan live
    while IFS="$US" read -r url title dur views chan live; do
        [[ -n "$url" ]] || continue
        urls+=("$url")
        R_TITLE+=("$title")
        R_DUR+=("$dur")
        R_VIEWS+=("$views")
        R_CHAN+=("$chan")
        R_LIVE+=("$live")
    done <<<"$1"
    NUM_ENTRIES=${#urls[@]}
    NUM_PAGES=$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))
    ((NUM_PAGES > 0)) || NUM_PAGES=1
}

# ── VIEW RENDERERS ──────────────────────────────────────────────────────────────────────

# Mode B: List View + Mini-Player Banner
display_list_menu() {
    local page=$1 start end i n disp status_extra p dots row_w rail rail_w
    # One size read per redraw, shared by the banner (title elision), the result rows and the
    # packed navigation hints below. No width cap: unlike the player cards, the list wants the
    # whole width for its rows. LINES_N is refreshed here too — it is what the reflow below
    # divides up, so a resize has to reach it.
    local nav_cols chrome_h=0
    layout_cols
    nav_cols=$LAYOUT_COLS
    LINES_N=$TERM_LINES
    clear
    # Title. Elided like every other row: a long query used to wrap and push the whole layout
    # down a line.
    local t_head="${GL_NOTE:+$GL_NOTE }$GL_BRAND  query="
    disp_w "$t_head"
    truncate_disp "'$QUERY_LABEL'" $((nav_cols - DISP_W))
    printf '%s%s%s%s%s  query=%s\n' "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$GL_BRAND" "$C_RESET" "$TRUNC_TEXT"
    chrome_h=$((chrome_h + 1))
    
    # Status line
    if [[ "$PLAY_MODE" == "audio" ]]; then status_extra="audio-only"; else status_extra="video-enabled"; fi
    # Fields are packed like every other chrome row, and min=/max= appear only when set:
    # at their 0s default they were pure width, and the line overflowed a 60-column
    # terminal because of them.
    local st_items=("results=$NUM_ENTRIES" "sort=$SORT_FIELD")
    [[ "$MIN_DISP" != "0" ]] && st_items+=("min=${MIN_DISP}s")
    [[ "$MAX_DISP" != "0" ]] && st_items+=("max=${MAX_DISP}s")
    st_items+=("mode=$PLAY_MODE ($status_extra)")
    [[ -n "$PLAY_VOLUME" ]] && st_items+=("volume=$PLAY_VOLUME")
    HINT_KEY_COLOR="$C_DIM"
    print_hints "$nav_cols" "" "" "${st_items[@]}"
    HINT_KEY_COLOR=""
    chrome_h=$((chrome_h + HINT_LINES))
    
    # Key navigation hints are measured BEFORE the banner: the banner's inline key tail
    # and this block are ONE job, and two adjacent chrome lines must not both document
    # keys. When this block prints (its gate below passes), the banner stays pure status
    # — one key source per screen, and the playing title gains the tail's ~30 cells; when
    # the gate drops this block on a short terminal, the banner's tail carries
    # Tab/Space/s/9/0 instead. A rail sits UNDER the block (Option B): one boundary
    # between the chrome band (status + banner + keys) and the result rows — the card's
    # rail language. It prints only with the block: no Navigation, no rail.
    disp_w "$S_NAV"
    local nav_pad
    printf -v nav_pad '%*s' $((DISP_W + 1)) ''
    local nav_items=(
        "$GL_AV	$S_SELECT" "$GL_AH	$S_PAGE" "$GL_ENTER	$S_PLAY" "Tab	$S_VIEW" "v	$S_MODE"
        "n	$S_SEARCH" "m	$S_MORE" "o	$S_SORT" "/	$S_FILTER" "l	$S_LANGKEY"
        "s	$S_STOP" "q	$S_QUIT"
    )
    # Measure the block before committing the space: on a very short terminal it is 4 lines of
    # a 10-line screen, and printing it would push the header off the top no matter how the
    # rows are repaged. Then the keys go and the results stay — the card view still
    # documents the keys.
    HINT_MEASURE=1
    print_hints "$nav_cols" "$S_NAV " "$nav_pad" "${nav_items[@]}"
    HINT_MEASURE=0
    local nav_h=$HINT_LINES
    # 4 = the blank line after the block, one result row, the blank line after the rows, the
    # cursor's resting row. Plus one more for the PAGINATION row whenever the list can
    # paginate at all: this gate only bites on a short terminal, and on a short terminal more
    # than one entry always means more than one page. Measured without that +1 (and true of
    # the shipped version too, at any width where the block fits in one fewer line than the
    # gate believes): a 62x10 terminal kept the block and then printed 7 chrome lines, one
    # row, a blank and the page counter — eleven lines into ten, and the header went off the
    # top, which is the one thing this reflow exists to prevent.
    local nav_need=4
    ((NUM_ENTRIES > 1)) && nav_need=5
    # The banner row counts here whether it prints or stands as a blank (+1); the rail
    # under the block counts too (+1) — it prints whenever the block does.
    local nav_ok=0
    if ((LINES_N - chrome_h - 1 - nav_h - 1 >= nav_need)); then nav_ok=1; fi

    # Persistent Mini-Player Banner (when background playback is active)
    if [[ -n "$CURRENT_PLAY_ID" ]]; then
        local p_icon="$GL_PLAY" p_label="Playing" p_color="$C_GREEN"
        if ((CURRENT_PLAY_PAUSED)); then
            p_icon="$GL_PAUSE"
            p_label="Paused"
            p_color=""      # retired yellow → default fg, same as the card/mini paused state
        fi
        # Pure status line: shares ONE line with a variable-length title, so measure the
        # fixed parts and give the title what is left (elided). The key tail appears only
        # when the Navigation block above was dropped (short-terminal fallback).
        local b_head="$p_icon $p_label: " b_tail=" $GL_SEP $CURRENT_PLAY_DURATION"
        local b_hint="" b_fixed=0
        if ((!nav_ok)); then
            b_hint="  [Tab $S_FOCUS | Space $S_PAUSE | s $S_STOP | 9/0 $S_VOL]"
        fi
        # Assignment form, not ((b_fixed += DISP_W)): an arithmetic command evaluating to 0
        # returns status 1, which `set -e` would take as a failure (see char_w).
        disp_w "$b_head"; b_fixed=$((b_fixed + DISP_W))
        disp_w "$b_tail"; b_fixed=$((b_fixed + DISP_W))
        disp_w "$b_hint"; local hint_w=$DISP_W
        local title_room=$((nav_cols - b_fixed - hint_w))
        if ((title_room < 12)); then
            b_hint=""
            title_room=$((nav_cols - b_fixed))
        fi
        ((title_room < 8)) && title_room=8
        truncate_disp "$CURRENT_PLAY_TITLE" "$title_room"
        printf '%s%s %s:%s %s%s%s%s%s%s%s%s%s\n' \
            "$p_color" "$p_icon" "$p_label" "$C_RESET" \
            "$C_CYAN" "$TRUNC_TEXT" "$C_RESET" \
            "$C_DIM" "$b_tail" "$C_RESET" \
            "$C_DIM" "$b_hint" "$C_RESET"
    else
        printf '\n'
    fi
    chrome_h=$((chrome_h + 1))    # the banner row, or the blank line standing in for it

    if ((nav_ok)); then
        print_hints "$nav_cols" "$S_NAV " "$nav_pad" "${nav_items[@]}"
        chrome_h=$((chrome_h + nav_h))
        # Rail under the Navigation block: one boundary between the chrome band and the
        # result rows (card_divider caches on width+glyph, like the card rails).
        card_divider "$nav_cols"
        printf '%s%s%s\n' "$C_DIM" "$DIV_STR" "$C_RESET"
        chrome_h=$((chrome_h + 1))
    fi
    printf '\n'
    chrome_h=$((chrome_h + 1))

    # ── Reflow: how many rows fit is MEASURED, not guessed ──────────────────────────────
    # This replaced `PAGE_CAP = LINES_N - 8`, which hardcoded the chrome at 8 lines. The
    # chrome is variable-height by construction: print_hints packs to the terminal width, so
    # the status and navigation blocks take 1-4 lines depending on width and chrome language.
    # The constant is only right at ~72+ columns in English; at 40x20 the real chrome is 11
    # lines, so ten one-line rows plus the footer came to 21 lines in a 20-line terminal and
    # scrolled the header and status row off the top — the same failure one-line rows were
    # meant to end, arriving from the other side. Recomputed every redraw, so a resize or a
    # language switch repages instead of overflowing.
    local avail psize filter_h=1
    if ((FILTER_MODE)); then
        disp_w "> $FILTER_LABEL"
        filter_h=$((filter_h + 1 + (DISP_W + nav_cols - 1) / nav_cols))
    fi
    # ── The details block is CHROME, and variable-height chrome at that ─────────────────
    # Its height is however far the selected title wraps, so it has to be charged against
    # the row budget before a single row is printed — measure it after the rows and a long
    # title costs the header instead of a row. The order below is what keeps that
    # non-circular: clamp the selection (needs no page geometry), measure the block for it,
    # derive PAGE_SIZE from the measured chrome, then derive the page from the selection.
    # Because the page follows the selection, the row this block describes is always on
    # screen, so the page can never move the selection out from under the measurement and
    # there is nothing to settle over multiple frames. PAGE_SIZE therefore changes by one as
    # the selection crosses a one-line/three-line title — the accepted cost of decision 1
    # (the block takes the space it needs; no fixed reservation, no cap on the title).
    ((selected < 0)) && selected=0
    ((NUM_ENTRIES > 0 && selected > NUM_ENTRIES - 1)) && selected=$((NUM_ENTRIES - 1))
    local detail_h=0 show_details=0
    if ((NUM_ENTRIES > 0)); then
        DETAIL_MEASURE=1
        print_details "$nav_cols" "$selected"
        DETAIL_MEASURE=0
        detail_h=$DETAIL_LINES
        # A terminal too short to pay for both drops the block and keeps the rows — the same
        # trade the navigation hints make above, and the reason "no cap on the title" is safe:
        # 2 = one result row and the pagination row it would otherwise have eaten.
        if ((LINES_N - chrome_h - filter_h - 1 - detail_h >= 2)); then
            show_details=1
        else
            detail_h=0
        fi
    fi
    # -1 for the cursor's resting row: filling the last line and emitting its newline scrolls
    # the screen up by one, which would cost the header again.
    avail=$((LINES_N - chrome_h - filter_h - detail_h - 1))
    psize=$PAGE_OPT
    ((psize > avail)) && psize=$avail
    # The pagination dots only cost a line when there IS more than one page. Checking against
    # the no-dots size first is what keeps that from being circular: if everything fits on one
    # page without the dots row, growing the page cannot introduce a second page.
    if ((NUM_ENTRIES > psize)); then
        ((psize > avail - 1)) && psize=$((avail - 1))
    fi
    ((psize < 1)) && psize=1
    if ((psize != PAGE_SIZE)); then
        PAGE_SIZE=$psize
        NUM_PAGES=$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))
        ((NUM_PAGES > 0)) || NUM_PAGES=1
        # Across a repage the SELECTION is the anchor, not the page number: the user is
        # looking at a row. Deriving the page from `selected` keeps that row on screen —
        # clamping the selection into the old page number instead teleports it (measured:
        # resizing 24 -> 12 rows dropped the page from 10 entries to 2, and the selection on
        # row 15 snapped back to row 4, page 2's new window).
        ((selected < 0)) && selected=0
        page=$(( selected / PAGE_SIZE + 1 ))
    fi
    # Repaging can leave the caller's page/selection outside the new bounds, so clamp both
    # here and hand `page_index` back — the renderer owns the page geometry now, and the menu
    # loop reads it back on the next iteration.
    ((page > NUM_PAGES)) && page=$NUM_PAGES
    ((page < 1)) && page=1
    page_index=$page
    start=$(( (page - 1) * PAGE_SIZE ))
    end=$(( start + PAGE_SIZE - 1 ))
    if ((NUM_ENTRIES > 0)); then
        ((selected < start)) && selected=$start
        ((selected > end)) && selected=$end
        ((selected > NUM_ENTRIES - 1)) && selected=$((NUM_ENTRIES - 1))
        ((selected < 0)) && selected=0
    fi

    # Result rows
    if ((NUM_ENTRIES == 0)); then
        truncate_disp "(no matches $GL_DASH press / to change filter, or n for new search)" "$nav_cols"
        printf '%s%s%s\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
    else
        for (( i = start; i <= end && i < NUM_ENTRIES; i++ )); do
            n=$(( i + 1 ))
            # A row is a TITLE and a duration rail — nothing else. It used to be
            # `title · duration · views · channel` composed into one string and elided from
            # the right, which spent the whole truncation budget on the metadata: at 62
            # columns the ellipsis ate duration, views and channel first and left a chopped
            # title with no metadata beside it. Views and channel moved to print_details.
            # The rail prints a bare LIVE rather than the "● LIVE" badge: this is a numeric
            # column, and a glyph in it reads as noise (the badge form is in the details).
            if [[ "${R_LIVE[$i]}" == "is_live" ]]; then
                rail="LIVE"
            else
                short_dur "${R_DUR[$i]}"
                rail="$SHORT_DUR"
            fi
            disp_w "$rail"
            rail_w=$DISP_W
            # "> 10. " / "  10. " is 4 cells plus the digits; 2 more keep the longest title
            # off the rail. Truncating to that is what gives the rail room BY CONSTRUCTION —
            # the jump below only repairs measurement drift, it does not license overflow.
            row_w=$(( nav_cols - 4 - ${#n} - 2 - rail_w ))
            ((row_w < 12)) && row_w=12
            truncate_disp "${R_TITLE[$i]}" "$row_w"
            disp="$TRUNC_TEXT"
            # The rail is placed with CHA (\033[<n>G, cursor horizontal absolute), NOT with
            # computed padding. Padding emits `room - DISP_W` spaces, so the column lands
            # wherever OUR measurement says it should — and our width rule over-counts by
            # design (a non-ASCII character is two cells unless measured otherwise), so a
            # title of mathematical-bold letters (2 measured, 1 drawn) parks its duration
            # ~5 columns left of the row above it. Ragged, on the one column that exists to
            # be scanned. CHA ignores what came before and lands on the same cell every
            # time. Columns are 1-based, so a right-flush field of rail_w cells starts at
            # nav_cols - rail_w + 1. If a title ever rendered WIDER than measured, the jump
            # moves backwards and cleanly overwrites the title tail instead of pushing the
            # rail into a wrap — the failure mode we want, and one the width layer's
            # over-counting rule already refuses to produce.
            if ((i == selected)); then
                # Marker + number in C_MARK (accent), title in bold, rail back to its own
                # dim — the selected line no longer inherits one hue end-to-end.
                printf '%s> %s. %s%s%s\033[%dG%s%s%s\n' \
                    "$C_MARK" "$n" "$C_BOLD" "$disp" "$C_RESET" \
                    $((nav_cols - rail_w + 1)) "$C_DIM" "$rail" "$C_RESET"
            else
                printf '  %s. %s%s\033[%dG%s%s\n' \
                    "$n" "$disp" "$C_DIM" $((nav_cols - rail_w + 1)) "$rail" "$C_RESET"
            fi
        done
    fi
    printf '\n'

    # Footer: pagination
    if ((NUM_PAGES > 1)); then
        if ((ASCII_GLYPHS == 0 && NUM_PAGES <= 12)); then
            dots=""
            for (( p = 1; p <= NUM_PAGES; p++ )); do
                # Through the glyph table, not literals: hardcoded ● ○ here were the last
                # two glyphs YT_ASCII could not reach, and ○ had no GL_ name at all.
                # Active page dot in accent (C_CYAN): the dots are state, not decoration.
                # mono resolves C_CYAN to "" → bold active dot, exactly today's look.
                if ((p == page)); then dots+="$C_BOLD$C_CYAN$GL_DOT$C_RESET"
                else dots+="$C_BOLD$GL_DOT_OFF$C_RESET"; fi
            done
            printf '%s%s\n' "$dots" "$C_RESET"
        else
            dots="page $page/$NUM_PAGES"
            printf '%s%s%s\n' "$C_BOLD" "$dots" "$C_RESET"
        fi
    fi

    # Details for the selected row. Below the pagination dots: the dots belong to the list,
    # this is a separate section under it.
    ((show_details)) && print_details "$nav_cols" "$selected"

    # Live filter input caret
    if ((FILTER_MODE)); then
        # Elided to one line like every other chrome row: this copy is 48 cells and wrapped
        # at 40 columns, costing a line the reflow above had already handed to a result row.
        truncate_disp "filter (type to narrow, Enter plays, Esc clears)" "$nav_cols"
        printf '%s%s%s\n' "$C_DIM" "$TRUNC_TEXT" "$C_RESET"
        printf '%s>%s %s' "$C_MARK" "$C_RESET" "$FILTER_LABEL"
        cursor_show
    else
        cursor_hide
    fi
}

# Mode A: Dedicated Now Playing Focus Card (Flicker-Free In-Place Render)
display_now_playing_card() {
    cursor_hide
    # Reposition cursor to top-left without blanking the screen (eliminates flicker)
    printf '\033[H'
    printf '%s%s%s%s%s  %s  %sNOW PLAYING FOCUS%s\033[K\n\033[K\n' \
        "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$GL_BRAND" "$C_RESET" "$GL_BULLET" "$C_BOLD" "$C_RESET"

    local p_status="$GL_DOT Playing" p_color="$C_GREEN"
    if ((CURRENT_PLAY_PAUSED)); then
        p_status="$GL_PAUSE Paused"
        p_color="$C_YELLOW"
    fi

    local cols div
    layout_cols 80
    cols=$LAYOUT_COLS
    card_divider "$cols"
    div="$DIV_STR"

    if [[ -z "$CURRENT_PLAY_ID" ]]; then
        printf '%s%s%s\033[K\n' "$C_DIM" "$div" "$C_RESET"
        printf '  %s%s%s\033[K\n\033[K\n' "$C_DIM" "$S_NOTHING" "$C_RESET"
        # 60 CJK cells of copy: pack it like the hint rows so it cannot run off a narrow
        # terminal (the empty state is the one place a full sentence is drawn).
        print_hints "$cols" "  " "  " \
            "[Tab]/[Esc]	$S_BACK_SEARCH" "[Enter]	$S_PLAY_SEL"
        printf '%s%s%s\033[K\n' "$C_DIM" "$div" "$C_RESET"
    else
        # fetch_play_times owns the IPC and the live special case (elapsed listening time,
        # no percent, no bar — mpv's own position would be pinned at 100%).
        local pct_str="" bar_str="" cur_time total_time
        fetch_play_times
        cur_time="$PT_CUR"
        total_time="$PT_TOTAL"
        if [[ -n "$PT_PCT" ]]; then
            pct_str=" (${PT_PCT}%)"
            # The bar is indented like the rest of the card body (4 cells) and ends
            # flush with the divider rails, which are `cols` wide from column 0.
            render_prog_bar "$PT_PCT" $((cols - 4))
            bar_str="$PROG_BAR"
        fi

        local text_w=$((cols - 15))
        ((text_w < 25)) && text_w=25

        printf '%s%s%s\033[K\n' "$C_DIM" "$div" "$C_RESET"
        wrap_print "$CURRENT_PLAY_TITLE" "$text_w" "  ${C_BOLD}${GL_PLAY} Title:${C_RESET}     " "               "
        wrap_print "$CURRENT_PLAY_CHANNEL" "$text_w" "    ${C_DIM}Channel:${C_RESET}   " "               "
        local time_label="Time:" time_sep="/"
        if ((CURRENT_PLAY_IS_LIVE)); then
            time_label="Tuned:"
            time_sep="$GL_SEP"
        fi
        # One line when it fits, two when it does not: this row is the widest fixed text in
        # the card (~72 cells with a CJK-free status) and used to wrap mid-word below that.
        # 15 = 4 indent + 8 label field + 3 gap; the segments are measured, not guessed.
        local seg_time="$cur_time $time_sep $total_time$pct_str" need=15
        disp_w "$seg_time"; ((need += DISP_W))
        disp_w "Mode: $CURRENT_PLAY_MODE"; ((need += 4 + DISP_W))
        disp_w "Status: $p_status"; ((need += 4 + DISP_W))
        if ((need <= cols)); then
            printf '    %s%-8s%s   %s    %sMode:%s %s    %sStatus:%s %s%s%s\033[K\n' \
                "$C_DIM" "$time_label" "$C_RESET" "$seg_time" \
                "$C_DIM" "$C_RESET" "$CURRENT_PLAY_MODE" \
                "$C_DIM" "$C_RESET" "$p_color" "$p_status" "$C_RESET"
        else
            printf '    %s%-8s%s   %s\033[K\n' "$C_DIM" "$time_label" "$C_RESET" "$seg_time"
            printf '    %sMode:%s %s    %sStatus:%s %s%s%s\033[K\n' \
                "$C_DIM" "$C_RESET" "$CURRENT_PLAY_MODE" \
                "$C_DIM" "$C_RESET" "$p_color" "$p_status" "$C_RESET"
        fi
        if [[ -n "$bar_str" ]]; then
            # \033[K on the spacer row too: the card grows by two rows the moment the
            # bar appears (mpv has no time-pos for the first second or so), so an
            # uncleared spacer kept showing the divider rail the previous frame drew there.
            printf '\033[K\n    %s%s%s\033[K\n' "$C_CYAN" "$bar_str" "$C_RESET"
        fi
        # No rail between the bar and Controls: the readout sits directly above the bar
        # it labels, and the controls flow straight after it — the mini player already
        # renders this way, and the bottom rail below Controls closes the card.
        print_hints "$cols" "  Controls:   " "              " \
            "[Tab/Esc]	$S_BACK_LIST" "[Space]	$S_PAUSE_RESUME" "[$GL_AH]	$S_SEEK5" \
            "[9/0]	$S_VOL_ADJUST" "[s]	$S_STOP_PLAY" "[q]	$S_QUIT"
        printf '%s%s%s\033[K\n' "$C_DIM" "$div" "$C_RESET"
    fi
    # Clean up any leftover lines below
    printf '\033[J'
}

# Mode B: Dedicated Minimalist Mini-Player (Flicker-Free In-Place Render)
display_mini_player() {
    cursor_hide
    printf '\033[H'
    printf '%s%s%s%s%s  %s  %sMINI PLAYER%s\033[K\n\033[K\n' \
        "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$GL_BRAND" "$C_RESET" "$GL_BULLET" "$C_BOLD" "$C_RESET"

    local cols
    layout_cols 80
    cols=$LAYOUT_COLS

    if [[ -z "$CURRENT_PLAY_ID" ]]; then
        printf '  %s%s%s\033[K\n\033[K\n' "$C_DIM" "$S_NOTHING" "$C_RESET"
        # 60 CJK cells of copy: pack it like the hint rows so it cannot run off a narrow
        # terminal (the empty state is the one place a full sentence is drawn).
        print_hints "$cols" "  " "  " \
            "[Tab]/[Esc]	$S_BACK_SEARCH" "[Enter]	$S_PLAY_SEL"
    else
        local p_icon="$GL_PLAY" p_color="$C_GREEN"
        if ((CURRENT_PLAY_PAUSED)); then
            p_icon="$GL_PAUSE"
            p_color="$C_YELLOW"
        fi

        local text_w=$((cols - 6))
        ((text_w < 30)) && text_w=30

        # Same single fetch as the card, live special case included.
        local pct_str="" bar_str="" cur_time total_time
        fetch_play_times
        cur_time="$PT_CUR"
        total_time="$PT_TOTAL"
        [[ -n "$PT_PCT" ]] && pct_str=" (${PT_PCT}%)"

        # The bar shares its line with the time readout, so it gets whatever the readout
        # leaves and ends at the same right edge as the wrapped title above (cols). All the
        # prefix cells are ASCII, so ${#var} is their display width: 2 indent + "cur / tot"
        # + " (NN%)" + 2 separating spaces.
        if [[ -n "$PT_PCT" ]]; then
            local bar_total=$((cols - (2 + ${#cur_time} + 3 + ${#total_time} + ${#pct_str} + 2)))
            ((bar_total < 12)) && bar_total=12
            render_prog_bar "$PT_PCT" "$bar_total"
            bar_str="$PROG_BAR"
        fi

        wrap_print "$CURRENT_PLAY_TITLE" "$text_w" "  ${p_color}${p_icon}${C_RESET} ${C_BOLD}" "    ${C_BOLD}"
        local mini_sep="/"
        ((CURRENT_PLAY_IS_LIVE)) && mini_sep="$GL_SEP"
        printf '  %s%s %s %s%s%s  %s%s%s\033[K\n\033[K\n' "$C_DIM" "$cur_time" "$mini_sep" "$total_time" "$pct_str" "$C_RESET" "$C_CYAN" "$bar_str" "$C_RESET"
        print_hints "$cols" "  " "  " \
            "[Tab/Esc]	$S_LIST_MENU" "[Space]	$S_PAUSE" "[$GL_AH]	$S_SEEK5_SHORT" \
            "[9/0]	$S_VOL" "[s]	$S_STOP" "[q]	$S_QUIT"
    fi
    printf '\033[J'
}

display_menu() {
    # Kitty-spec DCS 1 q / 2 q frame hold: the terminal shows the repaint only when DCS
    # 2 q arrives, so a full-screen redraw cannot flash a half-rendered frame. Skipped
    # under tmux by default (it buffers output and needs terminal-overrides passthrough).
    if ((SYNC_ON)); then printf '\033P=1q'; fi
    case "$TUI_VIEW_MODE" in
    card) display_now_playing_card ;;
    mini) display_mini_player ;;
    *) display_list_menu "$1" ;;
    esac
    if ((SYNC_ON)); then printf '\033P=2q'; fi
}

# ── PLAY delegate (Asynchronous / Non-blocking) ─────────────────────────────────────────
play_selected() {
    ((NUM_ENTRIES > 0)) || return 0
    local url="${urls[$selected]}"
    local out id pid

    stop_current_playback

    local sock
    out=$("$YT_PLAY" -d -j -f "$PLAY_MODE" ${PLAY_VOLUME:+--volume "$PLAY_VOLUME"} -- "$url" 2>/dev/null) || return 1
    # id/pid/sock in one jq pass. The socket path is READ FROM THE ENVELOPE, never rebuilt:
    # it is the core's private state layout, and hardcoding "$TMPDIR/yt-cli-$(id -u)/mpv-
    # $id.sock" here duplicated it in a second script that would break silently if the core
    # ever moved its state dir. DESIGN-yt.md §9.3.
    # US, not tab, for the same reason build_all_rows uses it: all three fields default to
    # "" here, and a run of tabs collapses, so a player that reported no pid would have had
    # its socket path read into `pid` — and then the guard below would reject a play that
    # actually started.
    IFS="$US" read -r id pid sock < <(
        printf '%s' "$out" | jq -r '[.id // "", .pid // "", .sock // ""] | join("\u001f")' 2>/dev/null
    ) || true

    [[ -n "$id" && -n "$sock" ]] || return 1

    CURRENT_PLAY_ID="$id"
    CURRENT_PLAY_PID="$pid"
    CURRENT_PLAY_URL="$url"
    CURRENT_PLAY_MODE="$PLAY_MODE"
    CURRENT_PLAY_SOCK="$sock"
    CURRENT_PLAY_PAUSED=0

    # Metadata straight out of the row arrays. This used to re-parse the composed display
    # string by splitting on " $GL_SEP " — which mis-split any title that itself contained
    # that separator, and had to be kept in step with the compose step at the other end of
    # the file. Liveness now comes from the row's own live_status field rather than from
    # recognising a rendered badge.
    CURRENT_PLAY_TITLE="${R_TITLE[$selected]:-Unknown}"
    CURRENT_PLAY_CHANNEL="${R_CHAN[$selected]:-Unknown}"
    if [[ "${R_LIVE[$selected]}" == "is_live" ]]; then
        CURRENT_PLAY_IS_LIVE=1
        CURRENT_PLAY_DURATION="$GL_LIVE"
    else
        CURRENT_PLAY_IS_LIVE=0
        # short_dur here too, not the envelope's `11h:53m:45s`: the banner sits three lines
        # above the same video's row and details line, and two spellings of one duration in
        # one screen read as two different numbers. It also matches the form fetch_play_times
        # replaces it with once mpv answers (fmt_sec), so the readout does not change shape
        # a second after playback starts.
        short_dur "${R_DUR[$selected]}"
        CURRENT_PLAY_DURATION="$SHORT_DUR"
    fi
    CURRENT_PLAY_STARTED=$(date +%s 2>/dev/null || echo 0)
}

# ── MODE action (key: v) ────────────────────────────────────────────────────────────────
cycle_mode() {
    local i n=${#MODE_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${MODE_CYCLE[$i]}" == "$PLAY_MODE" ]] && { cur=$i; break; }
    done
    PLAY_MODE="${MODE_CYCLE[$(( (cur + 1) % n ))]}"
}

# ── SEARCH action (key: n) ──────────────────────────────────────────────────────────────
new_search() {
    local q prev="$QUERY_LABEL" rc=0
    printf '\n%s%s New search%s (Esc or empty to cancel): ' "$C_BOLD" "$GL_CARET" "$C_RESET"
    read_query_input || return 0
    q="$QUERY_INPUT"
    [[ -n "${q//[[:space:]]/}" ]] || return 0
    QUERY_LABEL="$q"
    printf 'searching%s\n' "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        if ((rc == 2)); then
            printf 'no results for "%s". ' "$q"
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key%s' "$GL_ELL"
        IFS= read -rsn1 _ || true
        QUERY_LABEL="$prev"
        return 0
    fi
    apply_search_results
}

# ── MORE action (key: m) ────────────────────────────────────────────────────────────────
more_results() {
    local prev="$RESULT_N" rc=0
    RESULT_N=$(( RESULT_N + 25 ))
    printf '\n%sMore%s %s re-fetching "%s" for %s results%s\n' "$C_BOLD" "$C_RESET" "$GL_DASH" "$QUERY_LABEL" "$RESULT_N" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        RESULT_N="$prev"
        if ((rc == 2)); then
            printf 'no results. '
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key%s' "$GL_ELL"
        IFS= read -rsn1 _ || true
        return 0
    fi
    apply_search_results
}

# ── SORT action (key: o) ────────────────────────────────────────────────────────────────
cycle_sort() {
    local prev="$SORT_FIELD" i n=${#SORT_CYCLE[@]} cur=0 rc=0
    for (( i = 0; i < n; i++ )); do
        [[ "${SORT_CYCLE[$i]}" == "$SORT_FIELD" ]] && { cur=$i; break; }
    done
    SORT_FIELD="${SORT_CYCLE[$(( (cur + 1) % n ))]}"
    printf '\n%sSort%s %s %s %s re-fetching "%s"%s\n' "$C_BOLD" "$C_RESET" "$GL_ARROW" "$SORT_FIELD" "$GL_DASH" "$QUERY_LABEL" "$GL_ELL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        SORT_FIELD="$prev"
        if ((rc == 2)); then
            printf 'no results. '
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key%s' "$GL_ELL"
        IFS= read -rsn1 _ || true
        return 0
    fi
    apply_search_results
}

# ── FILTER action (key: /) — LIVE incremental narrow ─────────────────────────────────────
apply_filter() {
    local q="$1" url title dur views chan live hay tok ok matched="" tokens=()
    selected=0
    page_index=1
    if [[ -z "${q//[[:space:]]/}" ]]; then
        FILTER_LABEL=""
        load_rows "$ALL_ROWS"
        return 0
    fi
    FILTER_LABEL="$q"
    read -ra tokens <<<"$q"
    shopt -s nocasematch
    while IFS="$US" read -r url title dur views chan live; do
        [[ -n "$url" ]] || continue
        # The haystack is SYNTHESIZED here, not carried as a seventh field: the row already
        # has the pieces, it is never printed, and a stored key would be one more thing to
        # keep in step with the renderer. It holds BOTH duration forms on purpose — the
        # envelope's `11h:53m:45s` for parity with what the filter always matched, and
        # short_dur's `11:53:45` because that is the form the rail actually shows, and a
        # filter that will not match what is on the screen is a filter that looks broken.
        # The literal LIVE is what keeps typing `live` working now that no row carries a
        # rendered "● LIVE" string to match against.
        short_dur "$dur"
        hay="$title $chan $dur $SHORT_DUR $views"
        [[ "$live" == "is_live" ]] && hay+=" LIVE"
        ok=1
        for tok in ${tokens[@]+"${tokens[@]}"}; do
            if [[ "$hay" != *"$tok"* ]]; then ok=0; break; fi
        done
        # Re-emitted unchanged, so ALL_ROWS stays the one source and a filter never
        # degrades a row.
        ((ok)) && matched+="${url}${US}${title}${US}${dur}${US}${views}${US}${chan}${US}${live}"$'\n'
    done <<<"$ALL_ROWS"
    shopt -u nocasematch
    load_rows "$matched"
}

filter_live() {
    local query=""
    FILTER_MODE=1
    apply_filter ""
    while true; do
        display_menu "$page_index"
        read_nav_input || continue
        case "$READ_NAV_KEY" in
        "" | $'\n' | $'\r') play_selected || true ;;  # Enter → play highlighted match in background
        ESC) break ;;                            # Esc → leave filter mode
        "[A" | "OA" | "["*A | "O"*A | "[B" | "OB" | "["*B | "O"*B | \
        "[C" | "OC" | "["*C | "O"*C | "[D" | "OD" | "["*D | "O"*D)
            move_selection "$READ_NAV_KEY" ;;
        $'\x7f' | $'\b') query="${query%?}"; apply_filter "$query" ;;
        $'\t') ;;   # Tab is a control character, never part of a query — ignore, not append
        ?) query="$query$READ_NAV_KEY"; apply_filter "$query" ;;
        *) ;;
        esac
    done
    FILTER_MODE=0
    apply_filter ""
}

# ── Key Input Readers ───────────────────────────────────────────────────────────────────
READ_NAV_KEY=""
read_nav_input() {
    READ_NAV_KEY=""
    local input="" next="" seq=""
    local -a t_opt=()
    if [[ "$TUI_VIEW_MODE" == "card" || "$TUI_VIEW_MODE" == "mini" ]]; then
        t_opt=(-t 1)
    fi
    if ! IFS= read -rsn1 ${t_opt[@]+"${t_opt[@]}"} input; then
        return 1
    fi
    if [[ "$input" != $'\x1b' ]]; then
        READ_NAV_KEY="$input"
        return 0
    fi
    if ! IFS= read -rsn1 -t 1 next; then
        READ_NAV_KEY="ESC"
        return 0
    fi
    if [[ "$next" != "[" && "$next" != "O" ]]; then
        READ_NAV_KEY="ESC"
        return 0
    fi
    seq="$next"
    while IFS= read -rsn1 -t 1 next; do
        seq+="$next"
        case "$next" in
        [[:alpha:]~]) break ;;
        esac
    done
    READ_NAV_KEY="$seq"
    return 0
}

read_query_input() {
    local char="" query=""
    cursor_show
    while true; do
        IFS= read -rsn1 char || return 1
        case "$char" in
        "" | $'\n' | $'\r') printf '\n'; QUERY_INPUT="$query"; return 0 ;;
        $'\x1b') printf '\n'; return 2 ;;
        $'\x7f' | $'\b') [[ -n "$query" ]] && { query=${query%?}; printf '\b \b'; } ;;
        *) query+="$char"; printf '%s' "$char" ;;
        esac
    done
}

move_selection() {
    local input="$1" pmin pmax
    pmin=$(( (page_index - 1) * PAGE_SIZE ))
    pmax=$(( pmin + PAGE_SIZE - 1 ))
    case "$input" in
    "[A" | "OA" | "["*A | "O"*A) # up
        if ((selected > 0)); then
            selected=$(( selected - 1 ))
            if ((selected < pmin && page_index > 1)); then
                page_index=$(( page_index - 1 )); selected=$(( page_index * PAGE_SIZE - 1 ))
            fi
        fi ;;
    "[B" | "OB" | "["*B | "O"*B) # down
        if ((selected < NUM_ENTRIES - 1)); then
            selected=$(( selected + 1 ))
            if ((selected > pmax && page_index < NUM_PAGES)); then
                page_index=$(( page_index + 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
            fi
        fi ;;
    "[C" | "OC" | "["*C | "O"*C) # right → next page
        if ((page_index < NUM_PAGES)); then
            page_index=$(( page_index + 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
        fi ;;
    "[D" | "OD" | "["*D | "O"*D) # left → prev page
        if ((page_index > 1)); then
            page_index=$(( page_index - 1 )); selected=$(( (page_index - 1) * PAGE_SIZE ))
        fi ;;
    esac
}

# ── Initial fetch ───────────────────────────────────────────────────────────────────────
FILTER_LABEL=""
FILTER_MODE=0
selected=0
page_index=1
rc=0
fetch_json || rc=$?
if ((rc != 0)); then
    ((rc == 2)) && die "no results for: $QUERY_LABEL"
    die "${SEARCH_ERR:-search failed}"
fi
apply_search_results

# ── Menu loop ─────────────────────────────────────────────────────────────────────────
while true; do
    page_min=$(( (page_index - 1) * PAGE_SIZE ))
    page_max=$(( page_min + PAGE_SIZE - 1 ))
    if ((selected < page_min)); then selected=$page_min; fi
    if ((selected > page_max && selected < NUM_ENTRIES)); then selected=$page_max; fi

    display_menu "$page_index"

    if ! read_nav_input; then continue; fi

    # Universal View Toggle (Tab or p)
    # Cycles: list (Search List) ──► card (Mode A: Focus Card) ──► mini (Mode B: Mini Player) ──► list
    if [[ "$READ_NAV_KEY" == $'\t' || "$READ_NAV_KEY" == "p" || "$READ_NAV_KEY" == "P" ]]; then
        clear
        case "$TUI_VIEW_MODE" in
        list) TUI_VIEW_MODE="card" ;;
        card) TUI_VIEW_MODE="mini" ;;
        mini) TUI_VIEW_MODE="list" ;;
        *) TUI_VIEW_MODE="list" ;;
        esac
        continue
    fi

    # Universal playback controls (active in all views)
    case "$READ_NAV_KEY" in
    " ") toggle_pause; continue ;;
    s | S) stop_current_playback; continue ;;
    9) adjust_volume -5; continue ;;
    0) adjust_volume 5; continue ;;
    "[") seek_relative -10; continue ;;
    "]") seek_relative 10; continue ;;
    esac

    # Mode A (Card) & Mode B (Mini Player) specific handlers
    if [[ "$TUI_VIEW_MODE" == "card" || "$TUI_VIEW_MODE" == "mini" ]]; then
        case "$READ_NAV_KEY" in
        ESC) clear; TUI_VIEW_MODE="list" ;;
        "[C" | "OC" | "["*C | "O"*C) seek_relative 5 ;;    # right arrow → seek +5s
        "[D" | "OD" | "["*D | "O"*D) seek_relative -5 ;;   # left arrow → seek -5s
        "[A" | "OA" | "["*A | "O"*A) adjust_volume 5 ;;    # up arrow → volume +5
        "[B" | "OB" | "["*B | "O"*B) adjust_volume -5 ;;   # down arrow → volume -5
        l | L) cycle_ui_lang ;;
        t | T) cycle_theme ;;   # cycle palette family live
        q | Q) printf 'Quitting%s\n' "$GL_ELL"; exit 0 ;;
        *) ;;
        esac
        continue
    fi

    # List View specific handlers
    case "$READ_NAV_KEY" in
    "[A" | "OA" | "["*A | "O"*A | "[B" | "OB" | "["*B | "O"*B | \
    "[C" | "OC" | "["*C | "O"*C | "[D" | "OD" | "["*D | "O"*D)
        move_selection "$READ_NAV_KEY" ;;
    "" | $'\n' | $'\r') play_selected || true ;;  # Enter → start/switch track in background
    n | N) new_search ;;      # new search (non-blocking: music continues)
    m | M) more_results ;;    # more results
    o | O) cycle_sort ;;      # rotate sort
    v | V) cycle_mode ;;      # rotate playback mode
    l | L) cycle_ui_lang ;;   # toggle chrome language (en <-> zh)
    t | T) cycle_theme ;;     # cycle palette family live
    "/") filter_live ;;       # LIVE incremental filter
    q | Q) printf 'Quitting%s\n' "$GL_ELL"; exit 0 ;;
    ESC) ;;
    *) ;;
    esac
done
