            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key%s' "$GL_ELL"
        IFS= read -rsn1 _ || true
        return 0
    fi
    apply_search_results
}

# ── SORT action (key: o) ────────────────────────────────────────────────────────────────
cycle_sort() {
    local prev="$SORT_FIELD" i n=${#SORT_CYCLE[@]} cur=0 rc=0
    for (( i = 0; i < n; i++ )); do
        [[ "${SORT_CYCLE[$i]}" == "$SORT_FIELD" ]] && { cur=$i; break; }
