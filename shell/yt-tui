#!/usr/bin/env bash
# yt-tui — interactive terminal browser for YouTube (self-rendered menu). Owned glue, not a
# client: the human-facing surface, ZERO YouTube logic. It composes the headless verbs with jq.
#
# This is the original yt-search-n-play.sh all-in-one TUI skeleton, with its three core jobs
# delegated to headless "function-call" binaries — each is UI-less; yt-tui calls it, gets
# output/exit-code back, and keeps rendering its own menu:
#   search (network fetch) → yt-search -j <query>   (JSON envelope)
#   play                   → yt-play -f MODE -- url  (BLOCKING: mpv owns the terminal, so its
#                            OSD progress bar shows, arrow keys seek, and q returns to the menu)
#   filter (narrow rows)   → pure bash, no external tool (net-new; the original had no filter)
#
# yt-tui renders its OWN menu — it draws every line and reads every key (arrow-key nav,
# pagination, colors, status/hint lines) — so nothing else owns the terminal. No fzf, no
# picker library, no detached background player.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features (no ${v,,}, no mapfile); guard
# empty-array expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). §28.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Locate the sibling verbs. They sit next to this file in both layouts: as symlinks in a
# bin/ dir, or as the real wrappers in shell-scripts/. Fall back to PATH.
if [[ -x "$SCRIPT_DIR/yt-search" && -x "$SCRIPT_DIR/yt-play" ]]; then
    YT_SEARCH="$SCRIPT_DIR/yt-search"
    YT_PLAY="$SCRIPT_DIR/yt-play"
elif command -v yt-search >/dev/null 2>&1 && command -v yt-play >/dev/null 2>&1; then
    YT_SEARCH=$(command -v yt-search)
    YT_PLAY=$(command -v yt-play)
else
    echo "yt-tui: cannot locate yt-search / yt-play" >&2
    exit 1
fi

print_usage() {
    cat <<'EOF'
yt-tui — interactive terminal browser for YouTube

Usage:
  yt-tui [options] [search query]

With no query, prompts for one (interactive). Requires a terminal.

Search options (forwarded to yt-search):
  -n NUM    Number of results to fetch (default: 25)
  -m SEC    Minimum duration in seconds
  -M SEC    Maximum duration in seconds
  -s FIELD  Sort field: relevance | view_count | duration (default: relevance)

Menu options:
  -f MODE   Playback mode (default: audio): audio | video | fast | ascii | viz
  -p NUM    Rows per page (default: 10, capped to the terminal height)
  --color MODE  Color: auto | always | never (default: auto)
  -h        This help

Keys (in the menu):
  ↑/↓      move the selection          ←/→  page
  Enter    play the selected result (blocking: mpv owns the terminal;
             its progress bar shows, arrow keys seek, q returns to the menu)
  v        cycle playback mode: audio → video → fast (applies to the next play)
  n        new search (fetch a different query via yt-search)
  m        more results (re-fetch the current query, +25 to the count)
  o        rotate sort field / order (relevance → view_count → duration → …), re-fetch
  /        filter the current results (case-insensitive, space = AND)
  q        quit

Environment:
  YT_TUI_ASCII=1   Use ASCII glyphs (♫ ● ○ ❯ · → dropped / LIVE / numeric / >) for
                   terminals whose font can't draw them. Auto-on for non-UTF-8 locales.
EOF
}

die() {
    echo "yt-tui: $1" >&2
    exit 1
}

require_cmd() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "requires '$c' (not found on PATH)"
    done
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Parse: search-shaping flags forwarded to yt-search (and captured for the status line);
# -f/-p/--color are menu-local. The rest is the query. Reject anything else.
SEARCH_ARGS=()
RESULT_N=25          # fetch count; -n overrides. Runtime-mutable: S adds 25 (more_results).
PLAY_MODE="audio"        # -f flag overrides. Runtime-mutable: v key rotates it (cycle_mode).
MODE_CYCLE=(audio video fast)  # order the v key steps through
COLOR_MODE="auto"
PAGE_OPT=10
SORT_FIELD="relevance"   # -s flag overrides. Runtime-mutable: o key rotates it (cycle_sort).
SORT_CYCLE=(relevance view_count duration)  # order the o key steps through
MIN_DISP="0"
MAX_DISP="0"
query=()
while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    -n)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESULT_N="$2"; shift 2 ;;
    -s)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SORT_FIELD="$2"; shift 2 ;;
    -m)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MIN_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -M)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MAX_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -f)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_MODE="$2"; shift 2 ;;
    -p)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PAGE_OPT="$2"; shift 2 ;;
    --color)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        COLOR_MODE="$2"; shift 2 ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --)
        shift
        while (($#)); do query+=("$1"); shift; done
        break ;;
    -*) die "unknown flag '$1' (yt-tui flags: -n -m -M -s -f -p --color); run 'yt-tui -h'" ;;
    *) query+=("$1"); shift ;;
    esac
done

is_uint "$PAGE_OPT" && ((PAGE_OPT > 0)) || die "-p must be a positive integer"
is_uint "$RESULT_N" && ((RESULT_N > 0)) || die "-n must be a positive integer"
case " ${SORT_CYCLE[*]} " in *" $SORT_FIELD "*) ;; *) die "-s must be one of: ${SORT_CYCLE[*]}" ;; esac
case "$COLOR_MODE" in auto | always | never) ;; *) die "--color must be one of: auto, always, never" ;; esac

require_cmd jq
# The self-rendered menu reads keys from stdin and draws to stdout, so BOTH must be a real
# terminal; refuse cleanly rather than hang/garble when piped (e.g. an agent).
{ [[ -t 0 ]] && [[ -t 1 ]]; } || die "requires a terminal (interactive menu); use yt-search / yt-play headless"

# ── Colors (init_colors): honour --color auto|always|never, as the original. ────────────
C_RESET=''; C_BOLD=''; C_CYAN=''; C_YELLOW=''; C_DIM=''; C_REVERSE=''
init_colors() {
    local on=0
    case "$COLOR_MODE" in
    auto) [[ -t 1 ]] && on=1 ;;
    always) on=1 ;;
    never) on=0 ;;
    esac
    if ((on)); then
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_CYAN=$'\033[36m'
        C_YELLOW=$'\033[33m'; C_DIM=$'\033[2m'; C_REVERSE=$'\033[7m'
    fi
}
init_colors

# ── Glyphs (init_glyphs): Unicode by default; ASCII fallbacks when the terminal can't draw them.
# Two triggers: YT_TUI_ASCII=1 (explicit — for a UTF-8 terminal whose FONT lacks these glyphs,
# which locale can NOT detect), or a non-UTF-8 locale (auto). The reverse-video selection bar needs
# no fallback (it's an SGR attribute, not a glyph). §16 config: font capability is set-once → env.
GL_NOTE="♫"; GL_LIVE="● LIVE"; GL_SEP="·"; GL_CARET="❯"; ASCII_GLYPHS=0
init_glyphs() {
    case "${YT_TUI_ASCII:-}" in
    1 | true | yes | on) ASCII_GLYPHS=1 ;;
    *)
        case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8* | *utf-8* | *UTF8* | *utf8*) ASCII_GLYPHS=0 ;;
        *) ASCII_GLYPHS=1 ;;   # empty / non-UTF-8 locale → assume a limited terminal
        esac
        ;;
    esac
    if ((ASCII_GLYPHS)); then GL_NOTE=""; GL_LIVE="LIVE"; GL_SEP="|"; GL_CARET=">"; fi
}
init_glyphs

# Cursor: hide it while our self-rendered menu is on screen — a block-style terminal cursor
# otherwise parks on the line below the footer and reads as a stray solid "brick". Restore it on
# ANY exit (quit, error, Ctrl-C) via trap, and whenever we prompt for typed input or play.
cursor_hide() { tput civis 2>/dev/null || true; }
cursor_show() { tput cnorm 2>/dev/null || true; }
trap cursor_show EXIT

# Page size: default 10 (as the original), capped to what the terminal can show so it never
# overflows a short window. Rows themselves are printed untruncated (see display_menu).
LINES_N=$(tput lines 2>/dev/null || echo 24)
PAGE_SIZE=$PAGE_OPT
# Reserve 8 fixed rows (title, status, blank, nav, playback-hint, blank, blank, page footer)
# so a full page never pushes the footer off a short window.
PAGE_CAP=$(( LINES_N - 8 ))
((PAGE_CAP >= 3)) || PAGE_CAP=3
((PAGE_SIZE <= PAGE_CAP)) || PAGE_SIZE=$PAGE_CAP

# Interactive: with no query on the command line, prompt for one. Empty / Ctrl-D cancels.
if ((${#query[@]} == 0)); then
    printf '%s Search YouTube: ' "$GL_CARET" >&2
    IFS= read -r _q || { printf '\n' >&2; exit 0; }
    [[ -n "${_q//[[:space:]]/}" ]] || { echo "yt-tui: no query entered" >&2; exit 0; }
    query=("$_q")
fi
QUERY_LABEL="${query[*]}"

# ── SEARCH delegate ─────────────────────────────────────────────────────────────────────
# Fetch results for the current QUERY_LABEL into $json via the headless yt-search verb.
# Returns: 0 ok; 1 search failed (reason left in $SEARCH_ERR); 2 zero results.
SEARCH_ERR=""
fetch_json() {
    local out cnt errfile rc=0
    errfile=$(mktemp "${TMPDIR:-/tmp}/yt-tui-search-err.XXXXXX" 2>/dev/null) || errfile="${TMPDIR:-/tmp}/yt-tui-search-err.$$"
    out=$("$YT_SEARCH" -j -n "$RESULT_N" -s "$SORT_FIELD" ${SEARCH_ARGS[@]+"${SEARCH_ARGS[@]}"} -- "$QUERY_LABEL" 2>"$errfile") || rc=$?
    SEARCH_ERR=$(<"$errfile")
    rm -f "$errfile"
    ((rc == 0)) || return 1
    cnt=$(printf '%s' "$out" | jq -r '.count // 0' 2>/dev/null || echo 0)
    [[ "$cnt" != "0" ]] || return 2
    json="$out"
    return 0
}

# Build master rows (ALL_ROWS) from $json: one "url<TAB>display" line per result. display =
# "title · dur · views · channel" (NO leading number — the menu numbers rows by visible
# position, which stays correct after a filter re-orders them). `clean` strips emoji; @tsv
# escapes any tab/newline so the hidden url field boundary never breaks. A live stream shows
# "● LIVE" in place of its (zero-length) duration. Metadata cells are single-spaced " · ".
build_all_rows() {
    ALL_ROWS=$(printf '%s' "$json" | jq -r --arg sep " $GL_SEP " --arg live "$GL_LIVE" '
      def clean:
        gsub("[\\x{1F000}-\\x{1FAFF}\\x{2190}-\\x{21FF}\\x{2300}-\\x{27BF}\\x{2B00}-\\x{2BFF}\\x{FE00}-\\x{FE0F}\\x{200D}\\x{2122}\\x{2139}]"; "")
        | gsub("\\s+"; " ") | gsub("^ | $"; "");
      .results[]
      | [ .url,
          "\(.title | clean)\($sep)\(if .live_status == "is_live" then $live else .duration_fmt end)\($sep)\(.view_count // 0) views\($sep)\(.channel // "?")"
        ] | @tsv')
}

# Rebuild the whole view from the just-fetched $json. The ONE post-search path: parse rows,
# clear any filter, reset the cursor to the top, load page 1. Shared by the initial fetch and
# new_search so the two can never drift.
apply_search_results() {
    build_all_rows
    FILTER_LABEL=""
    selected=0
    page_index=1
    load_rows "$ALL_ROWS"
}

# Populate the current view (urls[]/options[]) + pagination from a TSV of "url<TAB>display".
load_rows() {
    urls=()
    options=()
    local url disp
    while IFS=$'\t' read -r url disp; do
        [[ -n "$url" ]] || continue
        urls+=("$url")
        options+=("$disp")
    done <<<"$1"
    NUM_ENTRIES=${#urls[@]}
    NUM_PAGES=$(( (NUM_ENTRIES + PAGE_SIZE - 1) / PAGE_SIZE ))
    ((NUM_PAGES > 0)) || NUM_PAGES=1
}

# Draw the whole menu, sequentially like the original: title, status line, key-hint lines,
# the current page of rows (♫ marker, selection highlighted), the Page-of footer. We own
# every line — plain text + ANSI, no box, no frame.
display_menu() {
    local page=$1 start end i n disp status_extra pb p dots
    clear
    # Title. The ♫ accent lives here — used ONCE, meaningfully — not repeated on every row.
    printf '%s%s%syt-tui%s  query=%s\n' "$C_BOLD" "$C_CYAN" "${GL_NOTE:+$GL_NOTE }" "$C_RESET" "'$QUERY_LABEL'"
    # Status line. No page=X/Y here — the pagination dots in the footer are the single position
    # indicator (was doubled: status page= AND footer "Page X of Y"). filter= shown when active.
    if [[ "$PLAY_MODE" == "audio" ]]; then status_extra="audio-only"; else status_extra="video-enabled"; fi
    printf '%sresults=%s  sort=%s  min=%ss  max=%ss  mode=%s (%s)%s\n' \
        "$C_DIM" "$NUM_ENTRIES" "$SORT_FIELD" "$MIN_DISP" "$MAX_DISP" "$PLAY_MODE" "$status_extra" "$C_RESET"
    [[ -n "$FILTER_LABEL" ]] && printf '%sfilter=%s (/ to change, n for a new search)%s\n' "$C_DIM" "'$FILTER_LABEL'" "$C_RESET"
    printf '\n'
    # Key hints: navigation, then playback (mpv keys during blocking play).
    printf '%sNavigation:%s %s↑/↓%s item  %s←/→%s page  %s↵%s play  %sv%s mode  %sn%s search  %sm%s more  %so%s sort  %s/%s filter  %sq%s quit\n' \
        "$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" \
        "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET"
    if [[ "$PLAY_MODE" == "audio" ]]; then
        pb='(during play) ←/→ seek  q stop and return to menu'
    else
        pb='(during play) _ toggle video  ←/→ seek  q stop and return to menu'
    fi
    printf '%sPlayback:%s %s%s%s\n\n' "$C_BOLD" "$C_RESET" "$C_DIM" "$pb" "$C_RESET"
    # Rows for the current page. Matches the original all-in-one: full title/metadata printed
    # untruncated, letting the terminal wrap a long line rather than cutting it — a hard cutoff
    # loses the tail (often the channel or view count) a user needs to tell entries apart.
    if ((NUM_ENTRIES == 0)); then
        printf '%s(no matches — press / to change the filter, or n for a new search)%s\n' "$C_DIM" "$C_RESET"
    else
        start=$(( (page - 1) * PAGE_SIZE ))
        end=$(( start + PAGE_SIZE - 1 ))
        for (( i = start; i <= end && i < NUM_ENTRIES; i++ )); do
            n=$(( i + 1 ))
            disp="${options[$i]}"
            # Focus marker: a reverse-video block in the left gutter — a solid bar that renders in
            # ANY terminal font (unlike a ▌ block glyph, which some fonts don't draw). Row text
            # stays yellow. No per-row ♫ (repeated glyph = chrome). Mono fallback: an ASCII ">".
            # All three branches keep the number at column 2, so the list stays vertically aligned.
            if ((i == selected)); then
                if [[ -n "$C_REVERSE" ]]; then
                    printf '%s %s %s%s. %s%s\n' "$C_REVERSE" "$C_RESET" "$C_YELLOW" "$n" "$disp" "$C_RESET"
                else
                    printf '> %s. %s\n' "$n" "$disp"
                fi
            else
                printf '  %s. %s\n' "$n" "$disp"
            fi
        done
    fi
    printf '\n'
    # Footer: pagination position — ● current page, ○ the rest (numeric in ASCII mode or beyond a
    # readable dot cap). Shown ONLY when there's more than one page: a lone dot conveys nothing.
    if ((NUM_PAGES > 1)); then
        if ((ASCII_GLYPHS == 0 && NUM_PAGES <= 12)); then
            dots=""
            for (( p = 1; p <= NUM_PAGES; p++ )); do
                if ((p == page)); then dots+="●"; else dots+="○"; fi
            done
        else
            dots="page $page/$NUM_PAGES"   # ASCII mode, or too many pages to dot
        fi
        printf '%s%s%s\n' "$C_BOLD" "$dots" "$C_RESET"
    fi
    cursor_hide   # no stray block cursor parked below the footer
}

# ── PLAY delegate ───────────────────────────────────────────────────────────────────────
# Play the selected row via the headless yt-play verb, BLOCKING: mpv owns the terminal, so its
# OSD progress bar shows, arrow keys seek, and q ends playback and returns here.
play_selected() {
    ((NUM_ENTRIES > 0)) || return 0
    local url="${urls[$selected]}" rc=0
    cursor_show   # mpv owns the terminal during blocking play; next display_menu re-hides
    # DO NOT add `clear` here. This matches the original all-in-one design: play on top
    # of the already-drawn menu so the result list stays visible during playback and mpv's
    # --term-osd-bar prints on the line below the footer. The loop's next display_menu()
    # does its own clear and redraws on return. A `clear` here blanks the list and leaves
    # only mpv's bar on an otherwise-empty screen (the list scrolls into scrollback) — the
    # regression this deliberately avoids.
    "$YT_PLAY" -f "$PLAY_MODE" -- "$url" || rc=$?
    # mpv exits 130 (128+SIGINT) when the user hits q/ctrl-c to stop playback and return to
    # the menu — the documented, expected way to end playback, not a failure. Match the original
    # all-in-one here: no stdin flush after playback. The menu loop's read_nav_input blocks on
    # the next real keypress, so a single q is consumed by mpv and never leaks to the loop.
    # (A prior non-blocking flush HUNG on bash 3.2: `read -n <count>` installs its own termios
    # and waits for input regardless of `stty min 0 time 0`, so it blocked forever when the tty
    # buffer was empty — which is the normal case on every return. See yt-design.md §11/§27.)
    ((rc == 130)) && rc=0
    if ((rc != 0)); then
        printf '\nPlayback failed (exit %s). Check network/cookies/format.\n' "$rc" >&2
        printf 'Press any key to continue…' >&2
        IFS= read -rsn1 _ || true
        printf '\n' >&2
    fi
}

# ── MODE action (key: v) ────────────────────────────────────────────────────────────────
# Rotate PLAY_MODE to the next entry in MODE_CYCLE (audio → video → fast). Playback mode is
# purely local: it only changes the -f handed to yt-play on the NEXT Enter, so this is a
# no-network state flip (unlike cycle_sort, which must re-fetch). The menu loop redraws on
# return, so the status line's mode=… and the Playback hint update immediately. A launch mode
# outside the cycle (-f ascii / -f viz) counts as position 0, so the first v enters at video.
cycle_mode() {
    local i n=${#MODE_CYCLE[@]} cur=0
    for (( i = 0; i < n; i++ )); do
        [[ "${MODE_CYCLE[$i]}" == "$PLAY_MODE" ]] && { cur=$i; break; }
    done
    PLAY_MODE="${MODE_CYCLE[$(( (cur + 1) % n ))]}"
}

# ── SEARCH action (key: n) ──────────────────────────────────────────────────────────────
# New search: fetch a DIFFERENT query and replace the result set. Esc/Ctrl-D or an empty
# line cancels (keeps the current results); the query is read via read_query_input.
new_search() {
    local q prev="$QUERY_LABEL" rc=0
    printf '\n%s%s New search%s (Esc or empty to cancel): ' "$C_BOLD" "$GL_CARET" "$C_RESET"
    read_query_input || return 0               # Esc / Ctrl-D → cancel back to menu
    q="$QUERY_INPUT"
    [[ -n "${q//[[:space:]]/}" ]] || return 0  # blank Enter → keep current results
    QUERY_LABEL="$q"
    printf 'searching…\n'
    fetch_json || rc=$?
    if ((rc != 0)); then
        if ((rc == 2)); then
            printf 'no results for "%s". ' "$q"
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key…'
        IFS= read -rsn1 _ || true
        QUERY_LABEL="$prev"
        return 0
    fi
    apply_search_results
}

# ── MORE action (key: m) ────────────────────────────────────────────────────────────────
# Follow-up search: re-fetch the CURRENT query with 25 more results (25→50→75…).
# On failure, restore the previous count and keep the current results. Clears any filter,
# resets to page 1 — same post-search path as new_search (apply_search_results).
more_results() {
    local prev="$RESULT_N" rc=0
    RESULT_N=$(( RESULT_N + 25 ))
    printf '\n%sMore%s — re-fetching "%s" for %s results…\n' "$C_BOLD" "$C_RESET" "$QUERY_LABEL" "$RESULT_N"
    fetch_json || rc=$?
    if ((rc != 0)); then
        RESULT_N="$prev"
        if ((rc == 2)); then
            printf 'no results. '
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key…'
        IFS= read -rsn1 _ || true
        return 0
    fi
    apply_search_results
}

# ── SORT action (key: o) ────────────────────────────────────────────────────────────────
# Rotate SORT_FIELD to the next entry in SORT_CYCLE and re-fetch the current query. Sorting
# lives in the headless verb (yt owns it), so a sort change is a re-fetch — same pattern as
# more_results — not a local re-order. On failure, restore the previous field and keep the
# current results. Clears any filter, resets to page 1 (apply_search_results).
cycle_sort() {
    local prev="$SORT_FIELD" i n=${#SORT_CYCLE[@]} cur=0 rc=0
    for (( i = 0; i < n; i++ )); do
        [[ "${SORT_CYCLE[$i]}" == "$SORT_FIELD" ]] && { cur=$i; break; }
    done
    SORT_FIELD="${SORT_CYCLE[$(( (cur + 1) % n ))]}"
    printf '\n%sSort%s → %s — re-fetching "%s"…\n' "$C_BOLD" "$C_RESET" "$SORT_FIELD" "$QUERY_LABEL"
    fetch_json || rc=$?
    if ((rc != 0)); then
        SORT_FIELD="$prev"
        if ((rc == 2)); then
            printf 'no results. '
        else
            printf '%s. ' "${SEARCH_ERR:-search failed}"
        fi
        printf 'Press any key…'
        IFS= read -rsn1 _ || true
        return 0
    fi
    apply_search_results
}

# ── FILTER action (key: /) ──────────────────────────────────────────────────────────────
# Narrow the already-fetched rows in pure bash — no network, no external tool. Community-
# standard filter semantics (as fzf's default / git log --grep):
#   • case-insensitive (shopt -s nocasematch, scoped)
#   • space-separated AND tokens: a row matches only if it contains EVERY token, any order
#   • whitespace-trimmed; empty / all-whitespace clears the filter (shows all)
#   • literal tokens: quoted "$tok" in the glob → user's *, [, ? match literally (no injection)
# Only the display field (field 2) is matched; the hidden url (field 1) rides along untouched.
filter_results() {
    local q url disp tok ok matched=""
    printf '\n%s%s Filter%s (Esc to cancel, empty to show all; space = AND): ' "$C_BOLD" "$GL_CARET" "$C_RESET"
    read_query_input || return 0               # Esc / Ctrl-D → cancel, view unchanged
    q="$QUERY_INPUT"
    selected=0
    page_index=1
    if [[ -z "${q//[[:space:]]/}" ]]; then
        FILTER_LABEL=""
        load_rows "$ALL_ROWS"
        return 0
    fi
    FILTER_LABEL="$q"
    local tokens=()
    read -ra tokens <<<"$q"
    shopt -s nocasematch
    while IFS=$'\t' read -r url disp; do
        [[ -n "$url" ]] || continue
        ok=1
        for tok in ${tokens[@]+"${tokens[@]}"}; do
            if [[ "$disp" != *"$tok"* ]]; then ok=0; break; fi
        done
        ((ok)) && matched+="${url}"$'\t'"${disp}"$'\n'
    done <<<"$ALL_ROWS"
    shopt -u nocasematch
    load_rows "$matched"
}

# Read one keypress. Arrow keys arrive as a multi-byte ANSI escape sequence (ESC [ A/B/C/D,
# or ESC O … in application-cursor mode), byte by byte — indistinguishable at the first byte
# from a lone ESC. The -t 1 timeout on the follow-up reads tells them apart: a real sequence's
# bytes arrive instantly, so a 1s wait with nothing more means a bare ESC. The trailing loop
# consumes until an alpha/~ terminator, tolerating modifier digits some terminals insert.
read_nav_input() {
    local input="" next="" seq=""
    if ! IFS= read -rsn1 input; then
        return 1
    fi
    if [[ "$input" != $'\x1b' ]]; then
        printf "%s" "$input"
        return 0
    fi
    if ! IFS= read -rsn1 -t 1 next; then
        printf "ESC"
        return 0
    fi
    if [[ "$next" != "[" && "$next" != "O" ]]; then
        printf "ESC"
        return 0
    fi
    seq="$next"
    while IFS= read -rsn1 -t 1 next; do
        seq+="$next"
        case "$next" in
        [[:alpha:]~]) break ;;
        esac
    done
    printf "%s" "$seq"
}

# Read a line of text (a query/filter term) char-by-char, echoing as we go — the original
# all-in-one's reader, restored so Esc can CANCEL the prompt. Sets QUERY_INPUT and returns:
#   0 = submitted (Enter)    → QUERY_INPUT holds the line (may be empty)
#   2 = cancelled (Esc)      → QUERY_INPUT left untouched
#   1 = EOF (Ctrl-D)         → cancel
# Backspace edits; other bytes append. Shared by new_search and filter_results so the two
# can't drift. (Cooked `read -r` was simpler but couldn't see Esc and would silently append
# a stray Esc byte to the query.)
read_query_input() {
    local char="" query=""
    cursor_show   # a typed prompt needs a visible cursor; menu redraw re-hides afterward
    while true; do
        IFS= read -rsn1 char || return 1
        case "$char" in
        "" | $'\n' | $'\r') printf '\n'; QUERY_INPUT="$query"; return 0 ;;
        $'\x1b') printf '\n'; return 2 ;;
        $'\x7f' | $'\b') [[ -n "$query" ]] && { query=${query%?}; printf '\b \b'; } ;;
        *) query+="$char"; printf '%s' "$char" ;;
        esac
    done
}

# ── Initial fetch ───────────────────────────────────────────────────────────────────────
FILTER_LABEL=""
selected=0
page_index=1
rc=0
fetch_json || rc=$?
if ((rc != 0)); then
    ((rc == 2)) && die "no results for: $QUERY_LABEL"
    die "${SEARCH_ERR:-search failed}"
fi
apply_search_results

# ── Menu loop ─────────────────────────────────────────────────────────────────────────
while true; do
    page_min=$(( (page_index - 1) * PAGE_SIZE ))
    page_max=$(( page_min + PAGE_SIZE - 1 ))
    if ((selected < page_min)); then selected=$page_min; fi
    if ((selected > page_max && selected < NUM_ENTRIES)); then selected=$page_max; fi

    display_menu "$page_index"

    # Match the original all-in-one: a failed read (Ctrl-D / transient EOF) just re-loops.
    if ! input=$(read_nav_input); then continue; fi

    case "$input" in
    "[A" | "OA" | "["*A | "O"*A) # up
        if ((selected > 0)); then
            selected=$(( selected - 1 ))
            if ((selected < page_min && page_index > 1)); then
                page_index=$(( page_index - 1 ))
                selected=$(( page_index * PAGE_SIZE - 1 ))
            fi
        fi
        ;;
    "[B" | "OB" | "["*B | "O"*B) # down
        if ((selected < NUM_ENTRIES - 1)); then
            selected=$(( selected + 1 ))
            if ((selected > page_max && page_index < NUM_PAGES)); then
                page_index=$(( page_index + 1 ))
                selected=$(( (page_index - 1) * PAGE_SIZE ))
            fi
        fi
        ;;
    "[C" | "OC" | "["*C | "O"*C) # right → next page
        if ((page_index < NUM_PAGES)); then
            page_index=$(( page_index + 1 ))
            selected=$(( (page_index - 1) * PAGE_SIZE ))
        fi
        ;;
    "[D" | "OD" | "["*D | "O"*D) # left → prev page
        if ((page_index > 1)); then
            page_index=$(( page_index - 1 ))
            selected=$(( (page_index - 1) * PAGE_SIZE ))
        fi
        ;;
    "") play_selected ;;      # Enter
    n | N) new_search ;;      # new search (re-fetch a different query)
    m | M) more_results ;;    # more: re-fetch current query with 25 more results
    o | O) cycle_sort ;;      # rotate sort field (order): relevance → view_count → duration
    v | V) cycle_mode ;;      # rotate playback mode: audio → video → fast (next Enter)
    "/") filter_results ;;    # filter the current results in-place
    q | Q) echo "Quitting…"; exit 0 ;;
    ESC) ;; # ignore a stray Esc
    *) ;;
    esac
done
