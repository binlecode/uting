#!/usr/bin/env bash
# uting — interactive terminal browser for whatever engines are installed (self-rendered
# menu). Owned glue, not a client: the human-facing surface, ZERO SITE logic. It composes the
# headless verbs with jq.
#
# Delegates core jobs to headless binaries:
#   search (network fetch) → <engine>-search -j <query>   (JSON envelope)
#   play                   → ut-play -d -j -f MODE -- url  (ASYNCHRONOUS: detached background player)
#   filter (narrow rows)   → pure bash, no external tool
#
# uting renders its OWN menu, and there is ONE view: the result list, its live Now-Playing
# status banner, and the details block under it. What used to be a second full-screen
# renderer is a fifth ROW SOURCE — b (a playlist), h (the listening log), c (a video's parts)
# and i (a video's chapters) each replace the rows in place and are pressed again to come
# back. No view toggle, so no Tab.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features (no ${v,,}, no mapfile); guard
# empty-array expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). §28.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entries
# (yt-search / ut-play / uting) are symlinks into a checkout that can live anywhere, so
# `dirname $0` is the symlink's directory, not the code's. This walks the chain to the real file and takes ITS
# directory — which is the one holding the rest of the suite.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually against
# ~/bin instead of against what ~/bin actually points at. Physical resolution is the only one
# that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)

# THE version of the whole suite, declared once, in a data file (CLAUDE.md § one fact, one
# place). Read before any dependency gate, so --version answers on a machine with nothing
# installed.
if [[ -r "$SCRIPT_DIR/../VERSION" ]]; then
    UT_VERSION=$(cat "$SCRIPT_DIR/../VERSION")
else
    UT_VERSION="unknown"
fi

# WHAT THE ENVIRONMENT ALREADY PINS, noted BEFORE the chain below resolves — this is the one
# fact reading the config destroys. ut_read_config skips every key that is already set (that
# is what makes the environment beat a file), so once it has run, "the user exported it" and
# "the file supplied it" are indistinguishable. The write-back path needs the difference: a
# key the environment pins would be written to the file and then IGNORED at the next startup,
# and a file recording a value the program has already decided to throw away is a lie that
# surfaces months later. Ahead of the block below rather than inside it, because that block is
# duplicated verbatim in all eight entry points and this is uting's alone.
PREF_KEYS="UT_DEFAULT_ENGINE YT_THEME UT_PLAY_MODE UT_PLAY_QUALITY UT_SORT_FIELD YT_LANG UT_START_RESULTS UT_KEYS"
PREF_PINNED=""
for _pk in $PREF_KEYS; do
    if eval "[[ -n \"\${$_pk+x}\" ]]"; then PREF_PINNED="$PREF_PINNED $_pk"; fi
done
unset _pk

# CONFIGURATION — the chain is flag > environment > the user's config > the shipped defaults
# in `<checkout>/config`, which is where every default value in the suite is declared once.
# Duplicated VERBATIM in all eight entry points — see the same block in ut-play for why, and
# AS-BUILT-contract.md §5 for the keys.
UT_CONFIG="${UT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/uting/config}"
UT_DEFAULTS="$SCRIPT_DIR/../config"
ut_read_config() {
    local file="$1" line key val
    [[ -r "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        while [[ "$line" == [[:space:]]* ]]; do line="${line#[[:space:]]}"; done
        while [[ "$line" == *[[:space:]] ]]; do line="${line%[[:space:]]}"; done
        [[ -n "$line" && "$line" == *=* ]] || continue
        key="${line%%=*}"
        val="${line#*=}"
        while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
        while [[ "$val" == [[:space:]]* ]]; do val="${val#[[:space:]]}"; done
        [[ "$key" =~ ^(UT|YT|BILI)_[A-Z0-9_]+$ ]] || continue
        case "$key" in
        UT_CONFIG | UT_DEFAULTS | UT_VERSION | YT_IPC_SOCK | YT_DETACHED | YT_PLAYER_ID | YT_DETACHED_LOG) continue ;;
        esac
        if [[ ${#val} -ge 2 ]] && { [[ "$val" == \"*\" ]] || [[ "$val" == \'*\' ]]; }; then
            val="${val#?}"
            val="${val%?}"
        fi
        [[ "$val" == "~/"* ]] && val="$HOME/${val#\~/}"
        eval "[[ -n \"\${$key+x}\" ]]" && continue
        eval "$key=\$val"
    done < "$file"
}
# FAIL FAST AND SAY WHY. There is deliberately no escape hatch for --version or --help: they
# were tried, and letting execution continue past a missing defaults file replaced this one
# clear line with `YT_ASCII_VO: unbound variable` from set -u somewhere further down. A
# checkout missing part of itself is not a dependency gate (yt-dlp, jq and mpv still answer
# --version without being installed) — it is a broken checkout, and 2 is the exit code for a
# failure that is not the caller's usage error.
if [[ ! -r "$UT_DEFAULTS" ]]; then
    printf '%s: cannot read the shipped defaults at %s — that file declares every default value in the suite and is not optional\n' \
        "$(basename "$0")" "$UT_DEFAULTS" >&2
    exit 2
fi
ut_read_config "$UT_CONFIG"
ut_read_config "$UT_DEFAULTS"

# ── PREFERENCE WRITE-BACK ───────────────────────────────────────────────────────────────
# The eight keys above are the ones this TUI changes at runtime, and they are written back to
# the USER's config file in place. A preference that has to be re-pressed every session is not
# a preference; the reasoning is ARCHITECTURE.md §3.6 (reopen triggers: ROADMAP), the key table is
# AS-BUILT-contract.md §5. What the code below is:
#
#   WHICH FILE  the user's own ($UT_CONFIG). The shipped `config` is NEVER written — it is
#               this checkout's declared defaults, not anybody's preferences.
#   WHICH KEYS  PREF_KEYS, and nothing else. pref_value is the whitelist as well as the
#               key→variable map, so a key it does not name has no value to write and the
#               path cannot reach it.
#   WHEN        deferred. A cycle sets a dirty bit and returns; the file is written from
#               nav_tick or from the exit trap. t and l are held down, and a rewrite per
#               keypress would put a whole file rewrite inside the same loop that is
#               reassembling a multi-byte character out of single bytes.
#   HOW         the value on the matching line is replaced and NOTHING else on it is: the
#               key's own spacing, the gap before a trailing comment and the comment itself
#               are carried over byte for byte. Re-padding the comment column was considered
#               and refused — the width layer that knows a CJK comment is two cells per
#               character lives in the RENDERER, and padding by bytes here would misalign
#               every Chinese comment in a file that stays perfectly legal and reports nothing.
#   ROUND TRIP  the only correctness test that matters: what is written must read back
#               identically through ut_read_config. That is what pref_value_ok enforces.
PREF_DIRTY=""      # keys whose value has changed and is not on disk yet
PREF_WRITE_OFF=0   # a write failed once; stop retrying at every tick
PREF_SAID=""       # keys already refused out loud, so the notice is said once each

# The whitelist AND the key→variable map. One case, because two of them would be two places
# to add the ninth key and one place to forget it.
pref_value() {
    case "$1" in
    UT_DEFAULT_ENGINE) printf '%s' "$ENGINE" ;;
    YT_THEME)          printf '%s' "$THEME" ;;
    UT_PLAY_MODE)      printf '%s' "$PLAY_MODE" ;;
    UT_PLAY_QUALITY)   printf '%s' "$PLAY_QUALITY" ;;
    UT_SORT_FIELD)     printf '%s' "$SORT_FIELD" ;;
    YT_LANG)           printf '%s' "$UI_LANG" ;;
    UT_START_RESULTS)  printf '%s' "$RESULT_N" ;;
    UT_KEYS)           printf '%s' "$KEYS_TIER" ;;
    esac
}

# pref_listed <needle> <space-separated haystack>. bash 3.2 has no associative arrays and
# these lists are eight long, so a set is a string and membership is a glob.
pref_listed() {
    case " $2 " in *" $1 "*) return 0 ;; esac
    return 1
}

# A value is acceptable only if ut_read_config would read it back UNCHANGED. The eight are
# enumerations and a number, so this never fires today; it is here so a ninth key cannot
# quietly write a line the loader mangles — `#` starts a comment, one matching quote pair is
# stripped, surrounding space is trimmed and a leading ~/ becomes $HOME.
pref_value_ok() {
    case "$1" in
    "" | *"#"* | *'"'* | *"'"* | "~/"*) return 1 ;;
    esac
    case "$1" in
    [[:space:]]* | *[[:space:]] | *$'\n'*) return 1 ;;
    esac
    return 0
}

# mark_pref <key> — called on the SUCCESS path of a cycle, never before it: a cycle whose
# re-fetch failed has been rolled back on screen, and the file must agree with the screen.
mark_pref() {
    local k="$1"
    if ! pref_listed "$k" "$PREF_KEYS"; then return 0; fi
    # REFUSED, not silently written: the environment wins over the file at every startup, so
    # writing this key would record a value the next run reads and discards.
    if pref_listed "$k" "$PREF_PINNED"; then
        if ! pref_listed "$k" "$PREF_SAID"; then
            PREF_SAID="$PREF_SAID $k"
            store_notice "$S_PREF_ACT:" "$k $S_PREF_PINNED"
        fi
        return 0
    fi
    if ! pref_listed "$k" "$PREF_DIRTY"; then PREF_DIRTY="$PREF_DIRTY $k"; fi
    return 0
}

# write_prefs <keys> — ONE pass over the file, one temp, one rename, however many keys are
# pending. Deliberately no lock: two uting sessions writing the same file is last-writer-wins
# on a whole file that is always internally consistent, and what is lost is one preference,
# not user data. A lock spin inside a key loop would be the worse trade.
write_prefs() {
    local keys="$1" line lhs rhs key val pre gap comment trimmed lead bare tmp
    local out="" seen="" k dest link
    # Resolve $UT_CONFIG along its symlink chain FIRST, and write to what it points at.
    # temp+mv came from ut-playlist, but that store renames over files it created in its own
    # directory; this renames over a file the USER owns — quite possibly a symlink out of a
    # dotfiles repo. Renaming onto the link itself would leave a regular file here, orphan the
    # real dotfile (every later hand-edit there silently stops taking effect) and say nothing.
    # Same chain walk as this script's own self-resolution at the top — bash 3.2 has no
    # `readlink -f`. A dangling link resolves too, so the create path below makes the file the
    # link promises instead of replacing the link with one.
    dest="$UT_CONFIG"
    while [[ -L "$dest" ]]; do
        link=$(readlink "$dest")
        case "$link" in
        /*) dest="$link" ;;
        *)  dest="$(dirname "$dest")/$link" ;;
        esac
    done
    if [[ -e "$dest" ]]; then
        [[ -r "$dest" ]] || return 1
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" == *=* ]]; then
                lhs="${line%%=*}"
                key="$lhs"
                while [[ "$key" == [[:space:]]* ]]; do key="${key#[[:space:]]}"; done
                while [[ "$key" == *[[:space:]] ]]; do key="${key%[[:space:]]}"; done
                # A commented-out line keeps its `#`, so its key never matches and it is
                # carried through untouched — which is the right answer: the user disabled it.
                if pref_listed "$key" "$keys" && ! pref_listed "$key" "$seen"; then
                    val=$(pref_value "$key")
                    if pref_value_ok "$val"; then
                        rhs="${line#*=}"
                        comment=""
                        pre="$rhs"
                        if [[ "$rhs" == *"#"* ]]; then
                            pre="${rhs%%#*}"
                            comment="#${rhs#*#}"
                        fi
                        # Split the value off its own whitespace so both halves survive:
                        # `lead` is what sits between the = and the value, `gap` is the run
                        # of spaces that aligns the comment. Anchored strips only — pattern
                        # SUBSTITUTION is quadratic on bash 3.2 (§28).
                        trimmed="$pre"
                        while [[ "$trimmed" == *[[:space:]] ]]; do trimmed="${trimmed%[[:space:]]}"; done
                        gap="${pre#"$trimmed"}"
                        bare="$trimmed"
                        while [[ "$bare" == [[:space:]]* ]]; do bare="${bare#[[:space:]]}"; done
                        lead="${trimmed%"$bare"}"
                        line="$lhs=$lead$val$gap$comment"
                        seen="$seen $key"
                    fi
                fi
            fi
            out="$out$line"$'\n'
        done < "$dest"
    else
        mkdir -p "$(dirname "$dest")" 2>/dev/null || return 1
        out="# uting — your own settings, and the file uting writes a changed one back to."$'\n'
        out="$out# Hand-edit it freely: comments and layout are preserved, only values move."$'\n'
        out="$out# Precedence: flag > environment > THIS FILE > the shipped <checkout>/config."$'\n'
    fi
    # A key the file does not carry yet is appended. This is the only line the write ADDS,
    # and it is how UT_START_RESULTS — which is deliberately absent from the shipped config,
    # its unset state meaning "follow UT_FETCH_BATCH" — first appears anywhere.
    for k in $keys; do
        if ! pref_listed "$k" "$seen"; then
            val=$(pref_value "$k")
            if pref_value_ok "$val"; then out="$out$k=$val"$'\n'; fi
        fi
    done
    tmp="$dest.tmp.$$"
    # cp -p FIRST, so a config the user chmod'ed 600 comes back 600: the redirect below
    # truncates the copy rather than creating a fresh file at whatever the umask says.
    if [[ -f "$dest" ]]; then cp -p "$dest" "$tmp" 2>/dev/null || true; fi
    if ! printf '%s' "$out" >"$tmp" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
    if ! mv -f "$tmp" "$dest" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
    return 0
}

# The flush. Both call sites are places that already exist: nav_tick, which the reader falls
# into when its read times out, and cleanup_on_exit, which is already trapped on
# EXIT/INT/TERM/HUP. The worst case is no longer "a rewrite per keypress" but "one preference
# lost if the process dies inside a tick window".
flush_prefs() {
    local keys="$PREF_DIRTY"
    [[ -n "$keys" ]] || return 0
    PREF_DIRTY=""
    # if-form, not `((PREF_WRITE_OFF)) && return 0`: a bare arithmetic list that evaluates to
    # zero is a FAILED command, and under set -e that would abort the TUI here (§28).
    if ((PREF_WRITE_OFF)); then return 0; fi
    if ! write_prefs "$keys"; then
        PREF_WRITE_OFF=1
        # Soft failure: a read-only ~/.config must not kill a TUI that is playing music. It
        # must not be silent either — this line goes into the scroll area and the exit repeats
        # it, because the redraw after a tick wipes whatever is there.
        printf '\n%s%s%s %s\n' "$C_BOLD" "$S_PREF_ACT:" "$C_RESET" "$S_PREF_FAILED"
    fi
    return 0
}

if [[ -x "$SCRIPT_DIR/ut-play" ]]; then
    PLAY_BIN="$SCRIPT_DIR/ut-play"
elif command -v ut-play >/dev/null 2>&1; then
    PLAY_BIN=$(command -v ut-play)
else
    echo "uting: cannot locate ut-play" >&2
    exit 1
fi

# The playlist store, located the same way and OPTIONAL. Absent, the two playlist keys say
# so once and the rest of the session is unchanged — the same "a capability is declared by
# being there" rule an engine follows with --transcript. This file never touches
# $UT_STATE_DIR itself: the store owns its layout, exactly as ut-play owns players/.
PLAYLIST_BIN=""
if [[ -x "$SCRIPT_DIR/ut-playlist" ]]; then
    PLAYLIST_BIN="$SCRIPT_DIR/ut-playlist"
elif command -v ut-playlist >/dev/null 2>&1; then
    PLAYLIST_BIN=$(command -v ut-playlist)
fi

# The listening log, located the same way and just as optionally. HISTORY_BIN, not
# UT_HISTORY: that name is already the player's set-once switch for whether a row is
# written at all (AS-BUILT-contract.md §5) — and like its two siblings above, an internal
# does not wear the UT_/YT_/BILI_ prefix, which ut_read_config accepts as settable.
# This file only READS it, and only when h is pressed — the writing is the player's, where
# the fact "a track ended, and why" exists.
HISTORY_BIN=""
if [[ -x "$SCRIPT_DIR/ut-history" ]]; then
    HISTORY_BIN="$SCRIPT_DIR/ut-history"
elif command -v ut-history >/dev/null 2>&1; then
    HISTORY_BIN=$(command -v ut-history)
fi

# THE ENGINE REGISTRY — discovered, not listed. The suite's whole claim is that adding a
# source is adding a PAIR of scripts and changing nothing else; a hardcoded list of engine
# names in this file would make that claim false at the third source, and it would be false
# in the one place nobody looks, because the TUI would still run and simply not offer the
# new one.
#
# So an engine is anything that presents BOTH halves: `<name>-search` and `<name>-resolve`.
# Requiring the pair is not pedantry — a lone `-search` would list results the player cannot
# then resolve, i.e. a source that looks browsable and is not.
#
# Sibling directory first, then PATH, which is the same precedence `ut-play` uses to find a
# resolver: a bare checkout runs with nothing installed, and an installed suite still works
# from anywhere. PATH is scanned only when the checkout yields nothing, so the ordinary case
# costs one glob.
ENGINES=()
engine_seen() {
    local e
    for e in ${ENGINES[@]+"${ENGINES[@]}"}; do
        if [[ "$e" == "$1" ]]; then return 0; fi
    done
    return 1
}
scan_engines() {
    local dir=$1 f name
    # An unmatched glob expands to the pattern itself (no `nullglob` on the 3.2 floor), and
    # the -x test then rejects it, so no guard is needed.
    for f in "$dir"/*-search; do
        [[ -x "$f" ]] || continue
        name=${f##*/}
        name=${name%-search}
        [[ -x "$dir/$name-resolve" ]] || continue
        engine_seen "$name" || ENGINES+=("$name")
    done
    return 0
}
scan_engines "$SCRIPT_DIR"
if ((${#ENGINES[@]} == 0)); then
    _saved_ifs=$IFS
    IFS=:
    for _pdir in $PATH; do
        [[ -n "$_pdir" && -d "$_pdir" ]] && scan_engines "$_pdir"
    done
    IFS=$_saved_ifs
    unset _saved_ifs _pdir
fi
if ((${#ENGINES[@]} == 0)); then
    echo "uting: no engine found — need a <name>-search and <name>-resolve pair beside this file or on PATH" >&2
    exit 1
fi

# Resolve ONE engine's search half, by name, with the same sibling-then-PATH precedence.
# `<name>-search` is a string concatenation, not a table lookup: the engine name IS the
# command prefix, which is exactly what lets this file hold no registry of its own.
engine_search_bin() {
    if [[ -x "$SCRIPT_DIR/$1-search" ]]; then
        printf '%s\n' "$SCRIPT_DIR/$1-search"
        return 0
    fi
    command -v "$1-search" 2>/dev/null
}

# The same lookup for the other half. Two functions rather than one taking a suffix: the
# call sites read as what they fetch, and neither is a table.
#
# `ut-play` has a function of the SAME NAME that DIES when the lookup fails; this one
# returns non-zero and says nothing. Both are right for their own file: the player cannot
# play without an engine, while this file asks for halves it can live without —
# refresh_engine_auth below simply drops the auth field for an engine whose resolve half
# has no --auth, which is how a third engine is never blocked on implementing it. The
# argument is safe to paste into a path because every caller passes a name that already
# passed engine_seen (membership in the discovered registry — stricter than the player's
# name regex), never raw user input.
engine_resolve_bin() {
    if [[ -x "$SCRIPT_DIR/$1-resolve" ]]; then
        printf '%s\n' "$SCRIPT_DIR/$1-resolve"
        return 0
    fi
    command -v "$1-resolve" 2>/dev/null
}

# The auth token in the status line comes from the ENGINE, never from this file: which
# browser a source reads cookies from is site knowledge, and uting holds none. It asks
# `<engine>-resolve --auth`, a local fork with no network and no yt-dlp.
#
# It reports the cookie DECISION, not a valid login — an expired session still answers
# "cookie". The status line therefore says which profile playback will READ, which is the
# question a user can act on; whether the site accepted it is not knowable without a round
# trip this suite does not make.
#
# An engine whose resolve half has no --auth exits non-zero and the field simply
# disappears — the same way a missing --transcript states a missing capability by not
# existing, so a third engine is never blocked on implementing this.
#
# Recomputed on each source switch rather than kept in a map: bash 3.2 has no associative
# array, and one I/O-free fork is cheaper than keeping parallel arrays correct.
ENGINE_AUTH=""
refresh_engine_auth() {
    ENGINE_AUTH=""
    local bin out a b
    bin=$(engine_resolve_bin "$ENGINE") || return 0
    [[ -n "$bin" ]] || return 0
    out=$("$bin" --auth -j 2>/dev/null) || return 0
    a=$(printf '%s' "$out" | jq -r '.auth // empty' 2>/dev/null) || return 0
    case "$a" in
    cookie)
        b=$(printf '%s' "$out" | jq -r '.cookie_browser // empty' 2>/dev/null) || b=""
        ENGINE_AUTH="${b:-cookie}"
        ;;
    anonymous) ENGINE_AUTH="anon" ;;
    esac
    return 0
}

# Does this engine have `--parts`? Asked the way the suite says an engine declares a
# capability — by whether the VERB exists (AS-BUILT-contract.md §1.3) — and asked without
# spending a request: the probe is a HANDLE-LESS call, so an engine that HAS the verb dies in
# its own argv gate ("a BV id … is required") while one that does not dies in the flag gate,
# with the wording every gate in this suite shares. Both exit 1; the stderr is the answer.
#
# One I/O-free fork per source switch, cached, exactly like ENGINE_AUTH above: the hint block
# is measured on every redraw and cannot afford to ask, and `c` must not probe on the
# selection moving.
ENGINE_PARTS_OK=0
refresh_engine_parts() {
    ENGINE_PARTS_OK=0
    local bin err
    bin=$(engine_resolve_bin "$ENGINE") || return 0
    [[ -n "$bin" ]] || return 0
    err=$("$bin" --parts 2>&1 >/dev/null) || true
    case "$err" in
    *"unknown flag"*) ;;
    *) ENGINE_PARTS_OK=1 ;;
    esac
    return 0
}

# Does this engine have `--info`? Asked exactly as --parts is asked, and for the same reason
# the hint block cannot pay for it per redraw: a handle-less call, the argv gate answering for
# an engine that has the verb and the flag gate for one that does not. Both of today's engines
# have it — the probe is here because a capability is read off the VERB in this suite, never
# assumed from the engine list, and `i` must not offer itself to an engine that would answer
# "unknown flag".
ENGINE_INFO_OK=0
refresh_engine_info() {
    ENGINE_INFO_OK=0
    local bin err
    bin=$(engine_resolve_bin "$ENGINE") || return 0
    [[ -n "$bin" ]] || return 0
    err=$("$bin" --info 2>&1 >/dev/null) || true
    case "$err" in
    *"unknown flag"*) ;;
    *) ENGINE_INFO_OK=1 ;;
    esac
    return 0
}

# Every probe, one name for the callers. Three functions because they ask three questions about
# three verbs; one caller-facing name because the two places that switch engines would
# otherwise each list every probe — the shape that drifts the day a fourth one lands, the way
# F11/F12 did (ARCHITECTURE.md).
refresh_engine_caps() {
    refresh_engine_auth
    refresh_engine_parts
    refresh_engine_info
}

# Which engine this session starts on. The SAME variable ut-play reads, not a second one:
# a user who set a default source once should not have to set it again per surface.
ENGINE="$UT_DEFAULT_ENGINE"
engine_seen "$ENGINE" || ENGINE="${ENGINES[0]}"
ENGINE_SEARCH=""

print_usage() {
    cat <<'EOF'
uting — interactive terminal browser for the installed engines

Usage:
  uting [options] [search query]

With no query, prompts for one (interactive). Requires a terminal.

Search options (forwarded to <engine>-search):
  -n NUM    Number of results to fetch (default: 20)
  -m SEC    Minimum duration in seconds
  -M SEC    Maximum duration in seconds
  -s FIELD  Sort field: relevance | view_count | duration (default: relevance)
  --engine NAME  Which source to search. Defaults to UT_DEFAULT_ENGINE (the same variable
            ut-play reads), falling back to the first one installed. An engine is a
            <name>-search + <name>-resolve PAIR found beside this file or on PATH — nothing
            here lists them, so whatever is installed is what the e key offers.

Menu options:
  -f MODE   Playback mode (default: audio): audio | video | fast
            (playback is detached — ascii/viz need a terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: unset -> mpv's own default;
              launch-time only, no live volume-cycle key)
  -p NUM    Rows per page (default: 10, capped to the terminal height)
  --color MODE  Color: auto | always | never (default: auto)
  --theme NAME  Palette: minimal (default) | mono | catppuccin | tokyonight | nord
                | gruvbox | onedark. Every theme = one signature accent, nothing else
                hued; mono = gray hierarchy only, no hue. Community themes emit
                24-bit color when COLORTERM=truecolor, else ANSI-16 fallbacks.
                Light/dark picks the theme's own light variant (see YT_BG below).
  -h        This help
  -V        Print the suite version

Keys (List View):
  ↑/↓      move selection              ←/→  change page (→ past the last page
           fetches one batch more; ← on page 1 drops one, no re-fetch)
  j / k    the same two, for the hand that already lives on them (List View only —
           with / open they are text you are typing)
  Enter    play / switch track (non-blocking background playback); on a chapter row,
           play FROM that chapter — a seek if that item is already playing
  Space    pause / resume playback
  s        stop playback
  9 / 0    volume down / up (via IPC)
  [ / ]    seek backward / forward 10s (via IPC)
  v        cycle playback mode: audio → video → fast (applies to next play)
  f        cycle quality tier: auto → medium → high (applies to next play; the
           engine reads it against the mode, so `high` is 1080p for video and a
           bitrate for audio). UT_QUALITY_CYCLE sets the order and its members
  l        switch chrome language (en <-> zh)
  t        cycle palette family live (minimal → catppuccin → tokyonight → nord →
           gruvbox → onedark → mono); no-op when colors are off
  n        new search (fetch a different query without interrupting music)
  o        rotate sort field / order (relevance → view_count → duration), re-fetch
  e        switch source, re-fetch the same query (only when >1 engine is installed)
  a        add the focused row to a playlist               (needs ut-playlist)
  b        open a stored playlist as the row source; b again
           returns to the search results                    (needs ut-playlist)
  d        remove the focused row from the playlist on screen, after a
           confirmation; playlist rows only                 (needs ut-playlist)
  h        open the listening log as the row source; h again
           returns to the search results                    (needs ut-history)
  c        open the focused row's parts as the row source; c again returns to the
           search results          (only when the engine has --parts; Bilibili does)
  i        open the focused row's CHAPTERS as the row source, with one metadata
           fetch (upload date and likes land on the status line); i again returns
           to the search results. A chapter row is a call: Enter plays from it,
           + queues from it, a stores it
                                    (only when the engine has --info; both do)
  /        live filter — type to narrow instantly; ↑/↓ select, Enter play, Esc clear
  ?        show more / fewer keys (also ？). The hint block has two tiers:
           `core` is this view's own job, `full` is every key above. UT_KEYS pins it
  q        quit (stops background playback on exit)

  The eight settings these keys change — engine, sort field, playback mode, quality tier,
  theme, chrome language, the result count and the key-hint tier — are written back to YOUR config file
  (${XDG_CONFIG_HOME:-~/.config}/uting/config), in place: comments and layout are kept,
  only the value moves. The shipped defaults file is never written. A key you have pinned
  in the environment is left alone, and says so once.

Environment:
  Defaults for every knob below live in <checkout>/config, declared once for the whole
  suite. Override per user in ${XDG_CONFIG_HOME:-~/.config}/uting/config (KEY=value, one
  per line, # comments); UT_CONFIG relocates that file. Chain: flag > environment > your
  config > the shipped defaults. See AS-BUILT-contract.md §5.
  YT_ASCII=1       Use ASCII glyphs (♫ ● ○ ❯ · ▶ ❚❚ • … → — arrows → ASCII) for
                   terminals whose font can't draw them. Auto-on for non-UTF-8 locales.
                   Shared with the rest of the suite. Legacy alias: YT_TUI_ASCII.
  YT_LANG=en|zh    Language of the menu chrome. Default: zh under a zh* locale,
                   English otherwise (help text and errors are always English).
  YT_THEME=minimal|mono|catppuccin|tokyonight|nord|gruvbox|onedark
                   Palette family (same as --theme; default: minimal).
  YT_BG=auto|light|dark  Background mode. auto: $COLORFGBG, then an OSC 11 terminal
                   query, then dark. For minimal/mono, light swaps cyan for blue; for
                   community themes it picks the theme's own light variant.
  YT_SYNC=0|1|auto  Synchronized redraws (DCS 1q/2q; default auto: on, off under tmux).
  YT_ICON=note|phones  Which glyph fills the header's two-cell icon slot: ♫ (padded to
                   two) or 🎧. Unset, it is a coin flip per startup — pin it when a
                   frame has to come out the same twice. ASCII mode (YT_ASCII=1) drops
                   the slot entirely and this knob with it.
  YT_BRAND=1       Header wordmark in mathematical sans-serif bold ("𝗨 𝗧 𝗜 𝗡 𝗚").
                   OPT-IN: your terminal font must cover the U+1D5D4 block, else tofu.
                   ASCII mode (YT_ASCII=1) always wins.
  NO_COLOR=1       Disables color in --color auto mode (an explicit --color wins).
  YT_AMBIG_WIDE=1  Measure East-Asian-Ambiguous glyphs (· — • … arrows ─ ━ ○ ● ▶) as
                   TWO cells. Only needed if your terminal is set to treat ambiguous
                   width as double-width; every terminal ships with that option off.
EOF
}

die() {
    echo "uting: $1" >&2
    exit 1
}

require_cmd() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "requires '$c' (not found on PATH)"
    done
}

# The unix-socket client, resolved once at startup (ut-play carries the same probe — eight
# peers, no shared library). BSD/OpenBSD nc take -U; netcat-traditional and busybox nc do
# not, and there nmap's ncat is the same primitive under its second name. Probed by
# CAPABILITY (' -U' in the -h text), never by version string. ncat's -w bounds only the
# connect, so the idle backstop nc spells -w1 is spelled -i 1 there.
NC_UNIX=()
resolve_nc_unix() {
    if command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
        NC_UNIX=(nc -U -w1)
    elif command -v ncat >/dev/null 2>&1; then
        NC_UNIX=(ncat -U -w 1 -i 1)
    else
        return 1
    fi
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Parse: search-shaping flags forwarded to <engine>-search (and captured for status line);
# -f/-p/--color are menu-local. The rest is query. Reject anything else.
SEARCH_ARGS=()
# THE FETCH BATCH — the STEP the two edges move by: → past the last page adds one, ← on page
# one drops one. One knob, not two: they were the same 20 for the same reason, so a user who
# wants bigger bites should not have to say it twice. 20 because Bilibili's endpoint pages at
# 20 with no page-size knob (bili-search PAGE_SIZE), so it keeps the first fetch — and every
# re-fetch — an exact page count. Cross-engine: this is the TUI's appetite, not a site's page
# size. Separate from UT_SEARCH_RESULTS even though that is 20 too: that one is a TOTAL an
# engine returns once, this one is the STEP each press moves by, so widening one must not
# widen the other. AS-BUILT-contract.md §5.
#
# WHERE THE FIRST FETCH STARTS is a different question from how big a step is, which is why
# UT_START_RESULTS exists and why its unset state means "follow the step". It is the one key
# uting writes back that is NOT in the shipped `config`: a default whose meaning is "the
# value of another key" is a chain a flat KEY=value file cannot express (the same judgement
# that keeps UT_STATE_DIR out of it). AS-BUILT-contract.md §5.
RESULT_N=${UT_START_RESULTS:-$UT_FETCH_BATCH}  # -n overrides; → grows it, ← shrinks it
# The order the v key steps through. Space- or comma-separated; a user who never wants video
# drops it here rather than pressing past it every session.
IFS=' ,' read -r -a MODE_CYCLE <<<"$UT_MODE_CYCLE"
# The -f default, one value shared with ut-play and both resolve halves.
PLAY_MODE="$UT_PLAY_MODE" # -f flag overrides. Runtime-mutable: v key rotates it (cycle_mode).
# The --quality default, forwarded to ut-play on every launch and rotated live by the f key
# (cycle_quality). There is deliberately NO uting flag for it: a tier is set-once tuning, not
# a per-request choice, so it comes from the config chain and the key — CLAUDE.md's flag-vs-key
# rule, and the reason ut-play's own --quality exists for the agent surface.
PLAY_QUALITY="$UT_PLAY_QUALITY"
# Which tier of key hints the view prints, rotated live by the ? key (cycle_keys) and
# written back like the other seven. There is deliberately NO uting flag for it, by the same
# rule as the quality tier above: how much of the keymap you want written down is set-once
# tuning, not a per-request choice. AS-BUILT-tui.md §11.
KEYS_TIER="$UT_KEYS"
PLAY_VOLUME="$UT_VOLUME"  # --volume flag overrides
COLOR_MODE="auto"
THEME="minimal"          # --theme / YT_THEME override: minimal | mono (palette family)
BG_MODE="auto"           # YT_BG override: auto | light | dark (accent hue selection)
BG="dark"
[[ -n "${YT_THEME:-}" ]] && THEME="$YT_THEME"
[[ -n "${YT_BG:-}" ]] && BG_MODE="$YT_BG"
# ROWS PER SCREEN PAGE — the display page, which is a different thing from both the fetch
# batch above and bili-search's PAGE_SIZE (the remote API's own page, which is not a knob at
# all). It is only a request: display_list_menu reflows it down against terminal height.
PAGE_OPT=$UT_PAGE_ROWS
# The order the o key steps through. Space- or comma-separated, like UT_MODE_CYCLE.
IFS=' ,' read -r -a SORT_CYCLE <<<"$UT_SORT_CYCLE"
# The order the f key steps through. The shipped value is a SUBSET of the tier set (auto
# medium high) — a rotation is a thing you land on by accident, and `low` is a choice you
# make on purpose. The validator below still accepts the full set, so a user who wants it
# says so once here, exactly as with the mode cycle.
IFS=' ,' read -r -a QUALITY_CYCLE <<<"$UT_QUALITY_CYCLE"
# The -s default, one value shared with both search halves.
SORT_FIELD="$UT_SORT_FIELD"   # -s flag overrides. Runtime-mutable: o rotates it (cycle_sort).
# The order the t key steps through, defined here rather than beside cycle_theme so all three
# cycles are built before the one block that validates them. Space- or comma-separated: a
# user who wants two themes on the t key instead of seven says so once.
IFS=' ,' read -r -a THEME_CYCLE <<<"$UT_THEME_CYCLE"
MIN_DISP="0"
MAX_DISP="0"
query=()
while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    # The same data file every other entry point reads, read the same way. This used to
    # fork ut-play and awk the last field out of its PROSE — a second command's help-line
    # format turned into a dependency, in a suite whose whole argument is that callers
    # branch on envelopes rather than parse sentences.
    -V | --version) printf 'uting %s\n' "$UT_VERSION"; exit 0 ;;
    --engine)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        ENGINE="$2"; shift 2 ;;
    --engine=*) ENGINE="${1#*=}"; shift ;;
    -n)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESULT_N="$2"; shift 2 ;;
    -s)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SORT_FIELD="$2"; shift 2 ;;
    -m)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MIN_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -M)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MAX_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -f)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_MODE="$2"; shift 2 ;;   # validated against MODE_CYCLE below
    -p)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PAGE_OPT="$2"; shift 2 ;;
    --color)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        COLOR_MODE="$2"; shift 2 ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --theme)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        THEME="$2"; shift 2 ;;
    --theme=*) THEME="${1#*=}"; shift ;;
    --volume)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_VOLUME="$2"; shift 2 ;;
    --volume=*) PLAY_VOLUME="${1#*=}"; shift ;;
    --)
        shift
        while (($#)); do query+=("$1"); shift; done
        break ;;
    -*) die "unknown flag '$1' (uting flags: -n -m -M -s -f -p --color --theme --volume); run 'uting -h'" ;;
    *) query+=("$1"); shift ;;
    esac
done

is_uint "$PAGE_OPT" && ((PAGE_OPT > 0)) || die "-p must be a positive integer (UT_PAGE_ROWS)"
is_uint "$RESULT_N" && ((RESULT_N > 0)) || die "-n must be a positive integer (UT_START_RESULTS / UT_FETCH_BATCH)"

# A CONFIG FILE FAILS LOUDLY OR IT FAILS SILENTLY, and silently is worse: a cycle emptied by
# a typo would abort on the first keypress (an empty array expansion under set -u aborts on
# bash 3.2), and an unknown member would put a mode the engines reject under the v key. Both
# are cheap to catch here, once, naming the key the user actually wrote.
validate_cycle() {
    local key="$1" allowed="$2" m
    shift 2
    (($# > 0)) || die "$key must name at least one value (allowed: $allowed)"
    for m in "$@"; do
        case " $allowed " in
        *" $m "*) : ;;
        *) die "$key: unknown value '$m' (allowed: $allowed)" ;;
        esac
    done
}
validate_cycle UT_MODE_CYCLE "audio video fast" ${MODE_CYCLE[@]+"${MODE_CYCLE[@]}"}
validate_cycle UT_SORT_CYCLE "relevance view_count duration" ${SORT_CYCLE[@]+"${SORT_CYCLE[@]}"}
validate_cycle UT_QUALITY_CYCLE "auto low medium high" ${QUALITY_CYCLE[@]+"${QUALITY_CYCLE[@]}"}
validate_cycle UT_THEME_CYCLE "minimal catppuccin tokyonight nord gruvbox onedark mono" \
    ${THEME_CYCLE[@]+"${THEME_CYCLE[@]}"}
# Duration bounds and volume are forwarded verbatim (-m/-M to yt-search, --volume to ut-play),
# so the core would reject them anyway — but only at the first fetch or the first Enter, where
# it reads as "search failed" / a play that silently does not start. Same three checks the core
# makes (yt's is_non_negative_int), up front, in the core's own wording.
is_uint "$MIN_DISP" || die "-m must be a non-negative integer"
is_uint "$MAX_DISP" || die "-M must be a non-negative integer"
((MAX_DISP == 0 || MAX_DISP > MIN_DISP)) || die "-M must be greater than -m when both are set"
# Validated against the CLOSED SET, not against SORT_CYCLE. The cycle is the order the o key
# rotates through — a user narrowing it to one field is saying "stop showing me the others on
# o", not "reject -s duration". Using the cycle as the validity domain was safe only while it
# was a constant equal to the full set; the moment it became configurable it started rejecting
# values the engines accept, and forced this file's -s default to differ from the engines'.
case "$SORT_FIELD" in relevance | view_count | duration) ;; *) die "-s must be one of: relevance, view_count, duration" ;; esac
# A mistyped engine is caught HERE, against what is actually installed, rather than at the
# first fetch as "search failed". The message lists what there is, because the answer to
# "which sources do I have" is not written down anywhere else.
engine_seen "$ENGINE" || die "--engine must be one of: ${ENGINES[*]}"
ENGINE_SEARCH=$(engine_search_bin "$ENGINE") || ENGINE_SEARCH=""
[[ -n "$ENGINE_SEARCH" ]] || die "engine '$ENGINE' has no '$ENGINE-search' beside this file or on PATH"
refresh_engine_caps
# Playback is DETACHED here (ut-play -d), and a detached player has no terminal, so the
# terminal-rendering modes (ascii/viz) cannot work — the core rejects them for -d. Validate
# up front instead of letting an Enter fail silently. Same list the v key cycles.
# The closed set, for the same reason as -s above.
case "$PLAY_MODE" in audio | video | fast) ;; *) die "-f must be one of: audio, video, fast (ascii/viz need a terminal, which detached playback has none of)" ;; esac
case "$COLOR_MODE" in auto | always | never) ;; *) die "--color must be one of: auto, always, never" ;; esac
case "$THEME" in minimal | mono | catppuccin | tokyonight | nord | gruvbox | onedark) ;; *) die "--theme must be one of: minimal, mono, catppuccin, tokyonight, nord, gruvbox, onedark" ;; esac
case "$BG_MODE" in auto | light | dark) ;; *) die "YT_BG must be one of: auto, light, dark" ;; esac
if [[ -n "$PLAY_VOLUME" ]]; then
    is_uint "$PLAY_VOLUME" && ((PLAY_VOLUME <= 100)) || die "--volume must be an integer 0-100"
fi
# The quality tier rides the same door: a bogus value in the user's config would otherwise
# surface as a play that silently defaults. Empty reads as auto (the engine sends no sort
# for blank or auto alike — AS-BUILT-contract.md §1.3); anything else is a mistyped knob
# and fails loud.
# NORMALISED to the spelling rather than left blank, because the f key rotates this value:
# a blank matches no member of the cycle, so the first press would land on the SECOND tier
# and auto would be reachable only by going all the way round.
case "$PLAY_QUALITY" in
"") PLAY_QUALITY="auto" ;;
auto | low | medium | high) ;;
*) die "UT_PLAY_QUALITY must be one of: auto, low, medium, high" ;;
esac
# The key-hint tier rides the same door, normalised the same way and for the same reason: the
# ? key rotates this value and writes it back, so the word that reaches the file has to be
# one of the two the loader will read back — a blank renders as core and would be written as
# core the moment anyone pressed the key, which is a file disagreeing with itself for one press.
case "$KEYS_TIER" in
"") KEYS_TIER="core" ;;
core | full) ;;
*) die "UT_KEYS must be one of: core, full" ;;
esac
# The resource readout's two knobs ride the same door. Config-only, no flag: whether the
# chrome shows the player's cpu/ram is set-once tuning, not a per-request choice.
case "$UT_RESOURCE" in 0 | 1) ;; *) die "UT_RESOURCE must be 0 or 1" ;; esac
is_uint "$UT_RESOURCE_TICKS" && ((UT_RESOURCE_TICKS > 0)) || die "UT_RESOURCE_TICKS must be a positive integer"

# A unix-socket netcat as well as jq: every transport key (pause, seek, volume) and every
# time readout goes through the player's socket, so a machine without one loses half the
# TUI at the first keypress rather than at start-up. Any -U-capable variant passes —
# BSD/openbsd nc, or ncat (resolve_nc_unix).
require_cmd jq
resolve_nc_unix || die "requires a unix-socket netcat: 'nc' with -U support, or 'ncat'" 
# The self-rendered menu reads keys from stdin and draws to stdout, so BOTH must be a real
# terminal; refuse cleanly rather than hang/garble when piped (e.g. an agent).
{ [[ -t 0 ]] && [[ -t 1 ]]; } || die "requires a terminal (interactive menu); use ${UT_DEFAULT_ENGINE}-search / ut-play headless"

# ── Theme & Colors (init_theme): palette family + light/dark + protocol knobs ───────────
# Minimalist palette, terminal-native: minimal/mono use ANSI 16 indexed codes only, so the
# chrome follows the user's terminal theme, never imposes its own. The community themes
# (catppuccin/tokyonight/nord/gruvbox/onedark) emit 24-bit RGB only when the terminal
# advertises COLORTERM=truecolor; otherwise they fall back to the nearest ANSI-16 index.
# Every theme passes through the same minimalist filter: hierarchy by gray levels
# (dim → normal → bold) and hue is ONE accent (C_CYAN) — nothing else carries color.
# The play status was the last holdout: it used to print in a second hue (a per-theme
# C_GREEN, with C_YELLOW for paused), which read as "not this theme" wherever the accent
# was not green — gruvbox orange chrome beside an olive status. Now both states take the
# accent and the GLYPH carries the state (● playing / ❚❚ paused, the latter dimmed), so
# the card matches its own rails and marker in every palette. Both second-hue variables
# (C_GREEN, C_YELLOW) are gone outright — a variable nothing prints is a trap, not a
# spare, and one kept only so a stale read stays harmless is a rationale with no read
# left to defend. Their per-theme hexes are in git history if a second hue is ever
# wanted back. C_MARK is the selection/filter marker (bold + accent). Light/dark
# (YT_BG=auto → $COLORFGBG → OSC 11 query → dark) picks the theme's own light variant
# (mocha/latte, night/day, polar-night/snow-storm, gruvbox dark/light, onedark/one-light);
# for minimal it swaps cyan for blue, readable on white.
# --color auto honors NO_COLOR. YT_SYNC: synchronized redraws (DCS 1 q/2 q), on by default,
# off under tmux (see display_menu).
C_RESET=''; C_BOLD=''; C_CYAN=''; C_DIM=''; C_MARK=''
SYNC_ON=0
COLORTERM_TC=0
COLORS_ON=0             # set by init_colors; gates the live theme cycle (t key)
# TrueColor support: kitty/ghostty/wezterm/alacritty/konsole advertise COLORTERM.
# The community themes below emit 24-bit RGB ONLY then; otherwise they fall back to
# the nearest ANSI-16 index, so the chrome stays correct on limited terminals.
init_colorterm() {
    case "${COLORTERM:-}" in
    truecolor | 24bit) COLORTERM_TC=1 ;;
    esac
}
set_theme() {
    # Community themes (catppuccin/tokyonight/nord/gruvbox/onedark) pass through the
    # same minimalist filter as minimal: ONE signature accent, gray hierarchy for
    # everything else. Hexes are the official palettes; light/dark
    # is the theme's own light variant (catppuccin mocha/latte, tokyonight night/day,
    # nord polar-night/snow-storm, gruvbox dark/light, onedark/one-light).
    local acc_r acc_g acc_b a16
    case "$THEME" in
    minimal)
        C_CYAN=$'\033[36m'
        C_MARK=$'\033[1;36m'
        if [[ "$BG" == light ]]; then
            C_CYAN=$'\033[34m'; C_MARK=$'\033[1;34m'
        fi
        ;;
    mono)
        C_CYAN=''; C_MARK=$'\033[1m'
        ;;
    catppuccin | tokyonight | nord | gruvbox | onedark)
        case "$THEME:$BG" in
        catppuccin:dark)  acc_r=203; acc_g=166; acc_b=247; a16=35 ;;
        catppuccin:light) acc_r=136; acc_g=57;  acc_b=239; a16=35 ;;
        tokyonight:dark)  acc_r=122; acc_g=162; acc_b=247; a16=34 ;;
        tokyonight:light) acc_r=46;  acc_g=125; acc_b=233; a16=34 ;;
        nord:dark)        acc_r=136; acc_g=192; acc_b=208; a16=36 ;;
        nord:light)       acc_r=94;  acc_g=129; acc_b=172; a16=36 ;;
        gruvbox:dark)     acc_r=214; acc_g=93;  acc_b=14;  a16=33 ;;
        gruvbox:light)    acc_r=175; acc_g=58;  acc_b=3;   a16=31 ;;
        onedark:dark)     acc_r=97;  acc_g=175; acc_b=239; a16=34 ;;
        onedark:light)    acc_r=64;  acc_g=120; acc_b=242; a16=34 ;;
        esac
        if ((COLORTERM_TC)); then
            printf -v C_CYAN '\033[38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            printf -v C_MARK '\033[1;38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
        else
            C_CYAN=$'\033['"$a16"m
            C_MARK=$'\033[1;'"$a16"m
        fi
        ;;
    esac
}
init_colors() {
    local on=0
    case "$COLOR_MODE" in
    auto) [[ -t 1 && -z "${NO_COLOR:-}" ]] && on=1 ;;
    always) on=1 ;;
    never) on=0 ;;
    esac
    COLORS_ON=0
    if ((on)); then
        COLORS_ON=1
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        set_theme
    fi
}
init_sync() {
    case "${YT_SYNC:-auto}" in
    0 | off) SYNC_ON=0 ;;
    1 | on) SYNC_ON=1 ;;
    auto) [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]] && SYNC_ON=1 || SYNC_ON=0 ;;
    *) die "YT_SYNC must be 0, 1 or auto (got '$YT_SYNC')" ;;
    esac
}
detect_bg() {
    local fgbg b resp="" rgb rr gg bb
    case "$BG_MODE" in
    light) BG=light; return ;;
    dark) BG=dark; return ;;
    auto) ;;
    *) die "YT_BG must be one of: auto, light, dark (got '$BG_MODE')" ;;
    esac
    # $COLORFGBG is "fg;bg" (rxvt family): bg == 15 (white) → light. Non-numeric → no signal.
    fgbg="${COLORFGBG:-}"
    if [[ "$fgbg" == *";"* ]]; then
        b="${fgbg##*;}"
        if [[ "$b" =~ ^[0-9]+$ ]]; then
            if ((b == 15)); then BG=light; else BG=dark; fi
            return
        fi
    fi
    # OSC 11 background query (kitty/ghostty/wezterm/iTerm2/xterm-family answer; tmux and
    # dumb terminals don't — skip so auto costs no startup stall there). bash 3.2's read -t
    # takes only WHOLE seconds, so one unanswered probe costs 1 s once at startup.
    if [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]]; then
        printf '\033]11;?\033\\'
        # Assemble the reply byte-by-byte (3.2 has no read -d) until BEL or ST ends it.
        while IFS= read -rsn1 -t 1 b; do
            resp+="$b"
            case "$resp" in
            *$'\a'*) break ;;
            *$'\033\\'*) break ;;
            esac
            if ((${#resp} > 64)); then break; fi
        done
        # kitty answers "rgb:1c1c/1c1c/1c1c" (16-bit); xterm "rgb:1c/1c/1c" (8-bit).
        rgb="${resp#*rgb:}"; rgb="${rgb%%[$'\a'$'\033'\\]*}"
        if [[ "$rgb" == *"/"* ]]; then
            rr=""; gg=""; bb=""
            IFS='/' read -r rr gg bb <<<"$rgb" || true
            if [[ "$rr" =~ ^[0-9a-fA-F]{2,4}$ && "$gg" =~ ^[0-9a-fA-F]{2,4}$ && "$bb" =~ ^[0-9a-fA-F]{2,4}$ ]]; then
                local r8=$((16#$rr)) g8=$((16#$gg)) b8=$((16#$bb))
                if (( ${#rr} == 4 )); then r8=$((r8 / 257)); fi
                if (( ${#gg} == 4 )); then g8=$((g8 / 257)); fi
                if (( ${#bb} == 4 )); then b8=$((b8 / 257)); fi
                if ((r8 + g8 + b8 > 384)); then BG=light; else BG=dark; fi  # mid-gray boundary
            fi
        fi
    fi
}
init_theme() {
    detect_bg
    init_sync
    init_colorterm
    init_colors
}
init_theme

