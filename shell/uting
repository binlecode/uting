#!/usr/bin/env bash
# uting — interactive terminal browser for whatever engines are installed (self-rendered
# menu). Owned glue, not a client: the human-facing surface, ZERO SITE logic. It composes the
# headless verbs with jq.
#
# Delegates core jobs to headless binaries:
#   search (network fetch) → <engine>-search -j <query>   (JSON envelope)
#   play                   → ut-play -d -j -f MODE -- url  (ASYNCHRONOUS: detached background player)
#   filter (narrow rows)   → pure bash, no external tool
#
# uting renders its OWN menu with dual switchable views:
#   List View          → interactive result list + live Now-Playing status banner
#   Now Playing card   → dedicated full-screen Now-Playing metadata & control card
# Toggle between the two with [Tab] at any time without stopping audio.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features (no ${v,,}, no mapfile); guard
# empty-array expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). §28.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entries
# (yt-search / ut-play / uting) are symlinks into a checkout that can live anywhere, so
# `dirname $0` is the symlink's directory, not the code's. This walks the chain to the real file and takes ITS
# directory — which is the one holding the rest of the suite.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually against
# ~/bin instead of against what ~/bin actually points at. Physical resolution is the only one
# that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)
if [[ -x "$SCRIPT_DIR/ut-play" ]]; then
    UT_PLAY="$SCRIPT_DIR/ut-play"
elif command -v ut-play >/dev/null 2>&1; then
    UT_PLAY=$(command -v ut-play)
else
    echo "uting: cannot locate ut-play" >&2
    exit 1
fi

# The playlist store, located the same way and OPTIONAL. Absent, the two playlist keys say
# so once and the rest of the session is unchanged — the same "a capability is declared by
# being there" rule an engine follows with --transcript. This file never touches
# $UT_STATE_DIR itself: the store owns its layout, exactly as ut-play owns players/.
UT_PLAYLIST=""
if [[ -x "$SCRIPT_DIR/ut-playlist" ]]; then
    UT_PLAYLIST="$SCRIPT_DIR/ut-playlist"
elif command -v ut-playlist >/dev/null 2>&1; then
    UT_PLAYLIST=$(command -v ut-playlist)
fi

# THE ENGINE REGISTRY — discovered, not listed. The suite's whole claim is that adding a
# source is adding a PAIR of scripts and changing nothing else; a hardcoded list of engine
# names in this file would make that claim false at the third source, and it would be false
# in the one place nobody looks, because the TUI would still run and simply not offer the
# new one.
#
# So an engine is anything that presents BOTH halves: `<name>-search` and `<name>-resolve`.
# Requiring the pair is not pedantry — a lone `-search` would list results the player cannot
# then resolve, i.e. a source that looks browsable and is not.
#
# Sibling directory first, then PATH, which is the same precedence `ut-play` uses to find a
# resolver: a bare checkout runs with nothing installed, and an installed suite still works
# from anywhere. PATH is scanned only when the checkout yields nothing, so the ordinary case
# costs one glob.
ENGINES=()
engine_seen() {
    local e
    for e in ${ENGINES[@]+"${ENGINES[@]}"}; do
        if [[ "$e" == "$1" ]]; then return 0; fi
    done
    return 1
}
scan_engines() {
    local dir=$1 f name
    # An unmatched glob expands to the pattern itself (no `nullglob` on the 3.2 floor), and
    # the -x test then rejects it, so no guard is needed.
    for f in "$dir"/*-search; do
        [[ -x "$f" ]] || continue
        name=${f##*/}
        name=${name%-search}
        [[ -x "$dir/$name-resolve" ]] || continue
        engine_seen "$name" || ENGINES+=("$name")
    done
    return 0
}
scan_engines "$SCRIPT_DIR"
if ((${#ENGINES[@]} == 0)); then
    _saved_ifs=$IFS
    IFS=:
    for _pdir in $PATH; do
        [[ -n "$_pdir" && -d "$_pdir" ]] && scan_engines "$_pdir"
    done
    IFS=$_saved_ifs
    unset _saved_ifs _pdir
fi
if ((${#ENGINES[@]} == 0)); then
    echo "uting: no engine found — need a <name>-search and <name>-resolve pair beside this file or on PATH" >&2
    exit 1
fi

# Resolve ONE engine's search half, by name, with the same sibling-then-PATH precedence.
# `<name>-search` is a string concatenation, not a table lookup: the engine name IS the
# command prefix, which is exactly what lets this file hold no registry of its own.
engine_search_bin() {
    if [[ -x "$SCRIPT_DIR/$1-search" ]]; then
        printf '%s\n' "$SCRIPT_DIR/$1-search"
        return 0
    fi
    command -v "$1-search" 2>/dev/null
}

# Which engine this session starts on. The SAME variable ut-play reads, not a second one:
# a user who set a default source once should not have to set it again per surface.
: "${UT_DEFAULT_ENGINE:=yt}"
ENGINE="$UT_DEFAULT_ENGINE"
engine_seen "$ENGINE" || ENGINE="${ENGINES[0]}"
ENGINE_SEARCH=""

print_usage() {
    cat <<'EOF'
uting — interactive terminal browser for the installed engines

Usage:
  uting [options] [search query]

With no query, prompts for one (interactive). Requires a terminal.

Search options (forwarded to <engine>-search):
  -n NUM    Number of results to fetch (default: 25)
  -m SEC    Minimum duration in seconds
  -M SEC    Maximum duration in seconds
  -s FIELD  Sort field: relevance | view_count | duration (default: relevance)
  --engine NAME  Which source to search. Defaults to UT_DEFAULT_ENGINE (the same variable
            ut-play reads), falling back to the first one installed. An engine is a
            <name>-search + <name>-resolve PAIR found beside this file or on PATH — nothing
            here lists them, so whatever is installed is what the e key offers.

Menu options:
  -f MODE   Playback mode (default: audio): audio | video | fast
            (playback is detached — ascii/viz need a terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: unset -> mpv's own default;
              launch-time only, no live volume-cycle key)
  -p NUM    Rows per page (default: 10, capped to the terminal height)
  --color MODE  Color: auto | always | never (default: auto)
  --theme NAME  Palette: minimal (default) | mono | catppuccin | tokyonight | nord
                | gruvbox | onedark. Every theme = one signature accent, nothing else
                hued; mono = gray hierarchy only, no hue. Community themes emit
                24-bit color when COLORTERM=truecolor, else ANSI-16 fallbacks.
                Light/dark picks the theme's own light variant (see YT_BG below).
  -h        This help
  -V        Print the suite version

Keys (List View):
  ↑/↓      move selection              ←/→  change page
  Enter    play / switch track (non-blocking background playback)
  Tab / p  toggle view: List <-> Now Playing card
  Esc      (in the card) back to List View
  Space    pause / resume playback
  s        stop playback
  9 / 0    volume down / up (via IPC)
  [ / ]    seek backward / forward 10s (via IPC; works in every view)
  v        cycle playback mode: audio → video → fast (applies to next play)
  l        switch chrome language (en <-> zh), any view
  t        cycle palette family live (minimal → catppuccin → tokyonight → nord →
           gruvbox → onedark → mono), any view; no-op when colors are off
  n        new search (fetch a different query without interrupting music)
  m        more results (re-fetch current query, +25 to count)
  o        rotate sort field / order (relevance → view_count → duration), re-fetch
  e        switch source, re-fetch the same query (only when >1 engine is installed)
  /        live filter — type to narrow instantly; ↑/↓ select, Enter play, Esc clear
  q        quit (stops background playback on exit)

Keys (Now Playing card):
  ←/→      seek backward / forward 5s   ↑/↓  volume down / up
  Tab      back to List View            Esc  back to List View
  Space    pause / resume               s    stop playback     q  quit

Environment:
  YT_ASCII=1       Use ASCII glyphs (♫ ● ○ ❯ · ▶ ❚❚ • … → — arrows → ASCII) for
                   terminals whose font can't draw them. Auto-on for non-UTF-8 locales.
                   Shared with the rest of the suite. Legacy alias: YT_TUI_ASCII.
  YT_LANG=en|zh    Language of the menu chrome. Default: zh under a zh* locale,
                   English otherwise (help text and errors are always English).
  YT_THEME=minimal|mono|catppuccin|tokyonight|nord|gruvbox|onedark
                   Palette family (same as --theme; default: minimal).
  YT_BG=auto|light|dark  Background mode. auto: $COLORFGBG, then an OSC 11 terminal
                   query, then dark. For minimal/mono, light swaps cyan for blue; for
                   community themes it picks the theme's own light variant.
  YT_SYNC=0|1|auto  Synchronized redraws (DCS 1q/2q; default auto: on, off under tmux).
  YT_BRAND=1       Header wordmark in mathematical sans-serif bold ("𝗨 𝗧 𝗜 𝗡 𝗚").
                   OPT-IN: your terminal font must cover the U+1D5D4 block, else tofu.
                   ASCII mode (YT_ASCII=1) always wins.
  NO_COLOR=1       Disables color in --color auto mode (an explicit --color wins).
  YT_AMBIG_WIDE=1  Measure East-Asian-Ambiguous glyphs (· — • … arrows ─ ━ ○ ● ▶) as
                   TWO cells. Only needed if your terminal is set to treat ambiguous
                   width as double-width; every terminal ships with that option off.
EOF
}

die() {
    echo "uting: $1" >&2
    exit 1
}

require_cmd() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "requires '$c' (not found on PATH)"
    done
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Parse: search-shaping flags forwarded to <engine>-search (and captured for status line);
# -f/-p/--color are menu-local. The rest is query. Reject anything else.
SEARCH_ARGS=()
RESULT_N=25          # fetch count; -n overrides. Runtime-mutable: m adds 25 (more_results).
PLAY_MODE="audio"        # -f flag overrides. Runtime-mutable: v key rotates it (cycle_mode).
MODE_CYCLE=(audio video fast)  # order the v key steps through
PLAY_VOLUME=""           # --volume flag overrides
COLOR_MODE="auto"
THEME="minimal"          # --theme / YT_THEME override: minimal | mono (palette family)
BG_MODE="auto"           # YT_BG override: auto | light | dark (accent hue selection)
BG="dark"
[[ -n "${YT_THEME:-}" ]] && THEME="$YT_THEME"
[[ -n "${YT_BG:-}" ]] && BG_MODE="$YT_BG"
PAGE_OPT=10
SORT_FIELD="relevance"   # -s flag overrides. Runtime-mutable: o key rotates it (cycle_sort).
SORT_CYCLE=(relevance view_count duration)  # order the o key steps through
MIN_DISP="0"
MAX_DISP="0"
query=()
while (($#)); do
    case "$1" in
    -h | --help) print_usage; exit 0 ;;
    # Same single source as the engines: ask a verb, print our own name. It asks ut-play
    # rather than a search half because ut-play is resolved before this loop and is the one
    # component that exists whatever engines are installed — the version is one file
    # (shell/VERSION) that all of them read, so any of them would answer the same.
    -V | --version) printf 'uting %s\n' "$("$UT_PLAY" --version | awk '{print $NF}')"; exit 0 ;;
    --engine)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        ENGINE="$2"; shift 2 ;;
    --engine=*) ENGINE="${1#*=}"; shift ;;
    -n)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        RESULT_N="$2"; shift 2 ;;
    -s)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        SORT_FIELD="$2"; shift 2 ;;
    -m)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MIN_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -M)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        MAX_DISP="$2"; SEARCH_ARGS+=("$1" "$2"); shift 2 ;;
    -f)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_MODE="$2"; shift 2 ;;   # validated against MODE_CYCLE below
    -p)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PAGE_OPT="$2"; shift 2 ;;
    --color)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        COLOR_MODE="$2"; shift 2 ;;
    --color=*) COLOR_MODE="${1#*=}"; shift ;;
    --theme)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        THEME="$2"; shift 2 ;;
    --theme=*) THEME="${1#*=}"; shift ;;
    --volume)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        PLAY_VOLUME="$2"; shift 2 ;;
    --volume=*) PLAY_VOLUME="${1#*=}"; shift ;;
    --)
        shift
        while (($#)); do query+=("$1"); shift; done
        break ;;
    -*) die "unknown flag '$1' (uting flags: -n -m -M -s -f -p --color --theme --volume); run 'uting -h'" ;;
    *) query+=("$1"); shift ;;
    esac
done

is_uint "$PAGE_OPT" && ((PAGE_OPT > 0)) || die "-p must be a positive integer"
is_uint "$RESULT_N" && ((RESULT_N > 0)) || die "-n must be a positive integer"
# Duration bounds and volume are forwarded verbatim (-m/-M to yt-search, --volume to ut-play),
# so the core would reject them anyway — but only at the first fetch or the first Enter, where
# it reads as "search failed" / a play that silently does not start. Same three checks the core
# makes (yt's is_non_negative_int), up front, in the core's own wording.
is_uint "$MIN_DISP" || die "-m must be a non-negative integer"
is_uint "$MAX_DISP" || die "-M must be a non-negative integer"
((MAX_DISP == 0 || MAX_DISP > MIN_DISP)) || die "-M must be greater than -m when both are set"
case " ${SORT_CYCLE[*]} " in *" $SORT_FIELD "*) ;; *) die "-s must be one of: ${SORT_CYCLE[*]}" ;; esac
# A mistyped engine is caught HERE, against what is actually installed, rather than at the
# first fetch as "search failed". The message lists what there is, because the answer to
# "which sources do I have" is not written down anywhere else.
engine_seen "$ENGINE" || die "--engine must be one of: ${ENGINES[*]}"
ENGINE_SEARCH=$(engine_search_bin "$ENGINE") || ENGINE_SEARCH=""
[[ -n "$ENGINE_SEARCH" ]] || die "engine '$ENGINE' has no '$ENGINE-search' beside this file or on PATH"
# Playback is DETACHED here (ut-play -d), and a detached player has no terminal, so the
# terminal-rendering modes (ascii/viz) cannot work — the core rejects them for -d. Validate
# up front instead of letting an Enter fail silently. Same list the v key cycles.
case " ${MODE_CYCLE[*]} " in *" $PLAY_MODE "*) ;; *) die "-f must be one of: ${MODE_CYCLE[*]} (ascii/viz need a terminal, which detached playback has none of)" ;; esac
case "$COLOR_MODE" in auto | always | never) ;; *) die "--color must be one of: auto, always, never" ;; esac
case "$THEME" in minimal | mono | catppuccin | tokyonight | nord | gruvbox | onedark) ;; *) die "--theme must be one of: minimal, mono, catppuccin, tokyonight, nord, gruvbox, onedark" ;; esac
case "$BG_MODE" in auto | light | dark) ;; *) die "YT_BG must be one of: auto, light, dark" ;; esac
if [[ -n "$PLAY_VOLUME" ]]; then
    is_uint "$PLAY_VOLUME" && ((PLAY_VOLUME <= 100)) || die "--volume must be an integer 0-100"
fi

# nc as well as jq: every transport key (pause, seek, volume) and every time readout goes
# through `nc -U` on the player's socket, so a machine without it loses half the TUI at the
# first keypress rather than at start-up.
require_cmd jq nc
# The self-rendered menu reads keys from stdin and draws to stdout, so BOTH must be a real
# terminal; refuse cleanly rather than hang/garble when piped (e.g. an agent).
{ [[ -t 0 ]] && [[ -t 1 ]]; } || die "requires a terminal (interactive menu); use yt-search / ut-play headless"

# ── Theme & Colors (init_theme): palette family + light/dark + protocol knobs ───────────
# Minimalist palette, terminal-native: minimal/mono use ANSI 16 indexed codes only, so the
# chrome follows the user's terminal theme, never imposes its own. The community themes
# (catppuccin/tokyonight/nord/gruvbox/onedark) emit 24-bit RGB only when the terminal
# advertises COLORTERM=truecolor; otherwise they fall back to the nearest ANSI-16 index.
# Every theme passes through the same minimalist filter: hierarchy by gray levels
# (dim → normal → bold) and hue is ONE accent (C_CYAN) — nothing else carries color.
# The play status was the last holdout: it used to print in a second hue (a per-theme
# C_GREEN, with C_YELLOW for paused), which read as "not this theme" wherever the accent
# was not green — gruvbox orange chrome beside an olive status. Now both states take the
# accent and the GLYPH carries the state (● playing / ❚❚ paused, the latter dimmed), so
# the card matches its own rails and marker in every palette. C_GREEN and C_YELLOW are
# both retired; C_YELLOW stays defined ("" everywhere) because a stale read of it is
# harmless, while C_GREEN is gone outright — a live variable holding a real color that
# nothing prints is a trap, not a spare. Its per-theme hexes are in git history if a
# second hue is ever wanted back. C_MARK is the selection/filter marker (bold + accent). Light/dark
# (YT_BG=auto → $COLORFGBG → OSC 11 query → dark) picks the theme's own light variant
# (mocha/latte, night/day, polar-night/snow-storm, gruvbox dark/light, onedark/one-light);
# for minimal it swaps cyan for blue, readable on white.
# --color auto honors NO_COLOR. YT_SYNC: synchronized redraws (DCS 1 q/2 q), on by default,
# off under tmux (see display_menu).
C_RESET=''; C_BOLD=''; C_CYAN=''; C_YELLOW=''; C_DIM=''; C_MARK=''
SYNC_ON=0
COLORTERM_TC=0
COLORS_ON=0             # set by init_colors; gates the live theme cycle (t key)
# TrueColor support: kitty/ghostty/wezterm/alacritty/konsole advertise COLORTERM.
# The community themes below emit 24-bit RGB ONLY then; otherwise they fall back to
# the nearest ANSI-16 index, so the chrome stays correct on limited terminals.
init_colorterm() {
    case "${COLORTERM:-}" in
    truecolor | 24bit) COLORTERM_TC=1 ;;
    esac
}
set_theme() {
    # Community themes (catppuccin/tokyonight/nord/gruvbox/onedark) pass through the
    # same minimalist filter as minimal: ONE signature accent, gray hierarchy for
    # everything else. Hexes are the official palettes; light/dark
    # is the theme's own light variant (catppuccin mocha/latte, tokyonight night/day,
    # nord polar-night/snow-storm, gruvbox dark/light, onedark/one-light).
    local acc_r acc_g acc_b a16
    case "$THEME" in
    minimal)
        C_CYAN=$'\033[36m'; C_YELLOW=''
        C_MARK=$'\033[1;36m'
        if [[ "$BG" == light ]]; then
            C_CYAN=$'\033[34m'; C_MARK=$'\033[1;34m'
        fi
        ;;
    mono)
        C_CYAN=''; C_YELLOW=''; C_MARK=$'\033[1m'
        ;;
    catppuccin | tokyonight | nord | gruvbox | onedark)
        C_YELLOW=''
        case "$THEME:$BG" in
        catppuccin:dark)  acc_r=203; acc_g=166; acc_b=247; a16=35 ;;
        catppuccin:light) acc_r=136; acc_g=57;  acc_b=239; a16=35 ;;
        tokyonight:dark)  acc_r=122; acc_g=162; acc_b=247; a16=34 ;;
        tokyonight:light) acc_r=46;  acc_g=125; acc_b=233; a16=34 ;;
        nord:dark)        acc_r=136; acc_g=192; acc_b=208; a16=36 ;;
        nord:light)       acc_r=94;  acc_g=129; acc_b=172; a16=36 ;;
        gruvbox:dark)     acc_r=214; acc_g=93;  acc_b=14;  a16=33 ;;
        gruvbox:light)    acc_r=175; acc_g=58;  acc_b=3;   a16=31 ;;
        onedark:dark)     acc_r=97;  acc_g=175; acc_b=239; a16=34 ;;
        onedark:light)    acc_r=64;  acc_g=120; acc_b=242; a16=34 ;;
        esac
        if ((COLORTERM_TC)); then
            printf -v C_CYAN '\033[38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
            printf -v C_MARK '\033[1;38;2;%d;%d;%dm' "$acc_r" "$acc_g" "$acc_b"
        else
            C_CYAN=$'\033['"$a16"m
            C_MARK=$'\033[1;'"$a16"m
        fi
        ;;
    esac
}
init_colors() {
    local on=0
    case "$COLOR_MODE" in
    auto) [[ -t 1 && -z "${NO_COLOR:-}" ]] && on=1 ;;
    always) on=1 ;;
    never) on=0 ;;
    esac
    COLORS_ON=0
    if ((on)); then
        COLORS_ON=1
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        set_theme
    fi
}
init_sync() {
    case "${YT_SYNC:-auto}" in
    0 | off) SYNC_ON=0 ;;
    1 | on) SYNC_ON=1 ;;
    auto) [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]] && SYNC_ON=1 || SYNC_ON=0 ;;
    *) die "YT_SYNC must be 0, 1 or auto (got '$YT_SYNC')" ;;
    esac
}
detect_bg() {
    local fgbg b resp="" rgb rr gg bb
    case "$BG_MODE" in
    light) BG=light; return ;;
    dark) BG=dark; return ;;
    auto) ;;
    *) die "YT_BG must be one of: auto, light, dark (got '$BG_MODE')" ;;
    esac
    # $COLORFGBG is "fg;bg" (rxvt family): bg == 15 (white) → light. Non-numeric → no signal.
    fgbg="${COLORFGBG:-}"
    if [[ "$fgbg" == *";"* ]]; then
        b="${fgbg##*;}"
        if [[ "$b" =~ ^[0-9]+$ ]]; then
            if ((b == 15)); then BG=light; else BG=dark; fi
            return
        fi
    fi
    # OSC 11 background query (kitty/ghostty/wezterm/iTerm2/xterm-family answer; tmux and
    # dumb terminals don't — skip so auto costs no startup stall there). bash 3.2's read -t
    # takes only WHOLE seconds, so one unanswered probe costs 1 s once at startup.
    if [[ -z "${TMUX:-}" && "${TERM:-}" != dumb ]]; then
        printf '\033]11;?\033\\'
        # Assemble the reply byte-by-byte (3.2 has no read -d) until BEL or ST ends it.
        while IFS= read -rsn1 -t 1 b; do
            resp+="$b"
            case "$resp" in
            *$'\a'*) break ;;
            *$'\033\\'*) break ;;
            esac
            if ((${#resp} > 64)); then break; fi
        done
        # kitty answers "rgb:1c1c/1c1c/1c1c" (16-bit); xterm "rgb:1c/1c/1c" (8-bit).
        rgb="${resp#*rgb:}"; rgb="${rgb%%[$'\a'$'\033'\\]*}"
        if [[ "$rgb" == *"/"* ]]; then
            rr=""; gg=""; bb=""
            IFS='/' read -r rr gg bb <<<"$rgb" || true
            if [[ "$rr" =~ ^[0-9a-fA-F]{2,4}$ && "$gg" =~ ^[0-9a-fA-F]{2,4}$ && "$bb" =~ ^[0-9a-fA-F]{2,4}$ ]]; then
                local r8=$((16#$rr)) g8=$((16#$gg)) b8=$((16#$bb))
                if (( ${#rr} == 4 )); then r8=$((r8 / 257)); fi
                if (( ${#gg} == 4 )); then g8=$((g8 / 257)); fi
                if (( ${#bb} == 4 )); then b8=$((b8 / 257)); fi
                if ((r8 + g8 + b8 > 384)); then BG=light; else BG=dark; fi  # mid-gray boundary
            fi
        fi
    fi
}
init_theme() {
    detect_bg
    init_sync
    init_colorterm
    init_colors
}
init_theme

# ── UI language (init_ui_strings): Chinese under a zh locale, English otherwise ─────────
# The chrome's labels were Chinese literals while help text, errors and field labels are
# English, so the tool read as two languages at once and was unusable for a non-Chinese
# reader. UI_LANG picks one: YT_LANG=en|zh wins, else a zh* locale selects Chinese, else
# English (which also covers cron/CI, where LANG is usually unset). Strings are resolved
# ONCE into globals rather than looked up per draw — bash 3.2 has no associative arrays,
# and a lookup function would fork or re-branch on every redraw.
UI_LANG=""
# set_ui_lang <en|zh> — fill the table. Kept separate from the initial choice below so the
# `l` key can re-resolve it live without re-reading the environment. NOTHING drawn as chrome
# may be a literal at its print site. The last holdouts were the play state (S_PLAYING /
