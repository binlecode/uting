}

die() {
    local red='' reset=''
    case "${COLOR_MODE:-auto}" in
    always)
        red=$'\033[31m'
        reset=$'\033[0m'
        ;;
    auto)
        if [[ -t 2 ]]; then
            red=$'\033[31m'
            reset=$'\033[0m'
        fi
        ;;
    never) ;;
    esac
    echo "${red}Error:${reset} $*" >&2
    exit 1
}

is_non_negative_int() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

validate_enum() {
    local value=$1
    shift
    local allowed
    for allowed in "$@"; do
        if [[ "$value" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

require_cmd() {
    local cmd=$1
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
}

require_deps() {
    local cmd
    for cmd in "$@"; do
        require_cmd "$cmd"
    done
}

mpv_supports_vo() {
    local vo=$1
    mpv --vo=help 2>/dev/null | awk 'NR > 1 {print $1}' | grep -Fxq "$vo"
}

convert_seconds() {
    local total_seconds=${1:-}
    local days hours minutes seconds

    if ! [[ "$total_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo "00h:00m:00s"
        return
    fi

    total_seconds=${total_seconds%.*}
    days=$((total_seconds / 86400))
    hours=$(((total_seconds % 86400) / 3600))
    minutes=$(((total_seconds % 3600) / 60))
    seconds=$((total_seconds % 60))

    if ((days > 0)); then
        printf "%dd %02dh:%02dm:%02ds" "$days" "$hours" "$minutes" "$seconds"
    else
        printf "%02dh:%02dm:%02ds" "$hours" "$minutes" "$seconds"
    fi
}

normalize_playback_mode() {
    case "$1" in
    audio | ba) echo "audio" ;;
    video | bv) echo "video" ;;
    fast | fst) echo "fast" ;;
    ascii | asc) echo "ascii" ;;
    viz | waves | wave) echo "viz" ;;
    *) die "-f must be one of: audio, video, fast, ascii, viz, waves, ba, bv, fst, asc, wave" ;;
    esac
}

# ==============================================================================
# 3. STREAM RESOLUTION & PLAYBACK PIPELINES
# ==============================================================================

# Play a URL with mpv. mpv's built-in ytdl_hook resolves the direct stream URL via
# yt-dlp, then mpv fetches and plays it (this is NOT a yt-dlp|mpv pipe). Cookies, when
# opted into, are forwarded to that ytdl_hook.
run_mpv() {
    local url=$1
    local format=$2
    shift 2
    local mpv_cmd=(mpv)
    local raw_opts=()

    # Optionally load caller-provided mpv input bindings.
    if [[ -n "$YT_MPV_INPUT_CONF" && -r "$YT_MPV_INPUT_CONF" ]]; then
        mpv_cmd+=(--input-conf="$YT_MPV_INPUT_CONF")
    fi

    # Launch-time volume. For a foreground/blocking session this is the only lever
    # (mpv's own volume keys work via the TTY); for detached playback it is just the
    # STARTING volume — live adjustment happens over the per-instance IPC socket
    # (see YT_IPC_SOCK below and do_set_volume). DESIGN-yt.md §26.
    if [[ -n "$VOLUME" ]]; then
        mpv_cmd+=(--volume="$VOLUME")
    fi

    # Runtime control channel: only when launched under detach_play, which exports
    # YT_IPC_SOCK. mpv's --input-ipc-server is per-process, so each detached player
    # points at its own socket and is driven independently. A foreground/blocking
    # session has a real TTY and needs no IPC. DESIGN-yt.md §26.
    if [[ -n "${YT_IPC_SOCK:-}" ]]; then
        mpv_cmd+=(--input-ipc-server="$YT_IPC_SOCK")
    fi

    # Pass format directly to mpv's ytdl integration
    mpv_cmd+=(--ytdl-format="$format")

    # Forward cookies to mpv's ytdl integration only when login is opted into;
    # otherwise set player_client=android so anonymous streaming avoids 403 on range requests.
    if (( ${#YT_COOKIE_ARGS[@]} > 0 )); then
        raw_opts+=("cookies-from-browser=$YT_COOKIE_BROWSER")
    else
        raw_opts+=("extractor-args=youtube:player_client=android")
    fi

    # mpv's --ytdl-raw-options is a single key/value-list flag: multiple keys are
    # joined with commas into one argument (confirmed against mpv -v output), not
    # passed as repeated flags. `local IFS=,` scopes the join separator to this
    # function only, so it can't leak into unrelated word-splitting elsewhere.
    if ((${#raw_opts[@]} > 0)); then
        local IFS=,
        mpv_cmd+=(--ytdl-raw-options="${raw_opts[*]}")
    fi

    # Execute mpv natively with the URL. Filter STDERR only, to drop the macOS CoreText
    # ".LastResort" notes (no mpv flag reaches them) plus any residual libass fontselect
    # warning that emoji-titled video would otherwise flood (see YT_MPV_VIDEO_OPTIONS). The
    # useful --term-osd-bar/AV status prints on STDOUT, so the progress bar is never touched;
    # real (non-noise) errors still pass through to >&2 for the -j classifier. Process
    # substitution (not a pipe) leaves $? as mpv's own exit code. No-op for modes without the
    # noise (audio/ascii/viz).
    "${mpv_cmd[@]}" "$@" "$url" 2> >(grep --line-buffered -vE 'CoreText note|\.LastResort|fontselect' >&2)
}

warn_audio_only_mode() {
    echo "Audio-only mode: no video track. Key '_' cannot turn video on. Use video/ascii mode for visuals." >&2
}

play_audio_url() {
    local url=$1
    run_mpv "$url" "$YT_AUDIO_FORMAT" "${YT_MPV_AUDIO_OPTIONS[@]}"
}

play_video_url() {
    local url=$1
    run_mpv "$url" "$YT_VIDEO_FORMAT" "${YT_MPV_VIDEO_OPTIONS[@]}"
}

play_fast_video_url() {
    local url=$1
    run_mpv "$url" "$YT_VIDEO_FORMAT_FAST" "${YT_MPV_VIDEO_OPTIONS[@]}"
}

play_ascii_url() {
    local url=$1
    run_mpv "$url" "$YT_VIDEO_FORMAT" "${YT_MPV_ASCII_OPTIONS[@]}"
}

play_viz_url() {
    local url=$1
    local width height size
    width=$(tput cols 2>/dev/null || echo 80)
    height=$(tput lines 2>/dev/null || echo 24)
    # Cap size to prevent terminal lag
    if ((width > 120)); then width=120; fi
    if ((height > 30)); then height=30; fi
    size="${width}x${height}"

    # Use showwaves filter with TCT terminal output
    run_mpv "$url" "$YT_AUDIO_FORMAT" \
        --vo=tct \
        --lavfi-complex="[aid1]asplit[ao][v];[v]showwaves=s=${size}:mode=line:colors=cyan|yellow:r=15[vo]"
}

# Single mode-dispatch table for playback, shared by play_url_directly() (prose
# `yt <url>`) and play_url_json() (structured output). Kept as one function so the
# callers can never drift out of sync on which modes exist or what they print.
play_mode_url() {
    local url=$1
    local mode=$2

    case "$mode" in
    video)
        printf "Playing video: %s\n" "$url"
        play_video_url "$url"
        ;;
    fast)
        printf "Playing fast video: %s\n" "$url"
        play_fast_video_url "$url"
        ;;
    ascii)
        printf "Playing ascii video: %s\n" "$url"
        play_ascii_url "$url"
        ;;
    viz)
        printf "Playing audio with live visualizer: %s\n" "$url"
        play_viz_url "$url"
        ;;
    *)
        printf "Playing audio: %s\n" "$url"
        play_audio_url "$url"
        ;;
    esac
}

# The probe path needs curl to test-fetch a byte of the resolved media URL. yt-dlp is
# already a hard dependency (require_deps); curl is near-universal but optional here, so
# we degrade to the play-fail-replay retry when it is absent rather than break.
have_probe_tools() {
    command -v curl >/dev/null 2>&1
}

# True (0) if the given client can actually FETCH this video's media stream — not merely
# resolve a URL, but pull a byte from it. Resolves the direct media URL with yt-dlp using
# the passed client (cookie args, if any), then issues an open-ended ranged HEAD/GET: a signed
# googlevideo URL answers 206/200 when authorized and 403 when it is missing the
# GVS "Proof of Origin" token. That 403 is the exact failure that makes mpv abort mid-load,
# so the probe's verdict matches what playback would do — letting us pick the working
# client BEFORE launching mpv. For HLS playlists (m3u8), the probe inspects the first
# segment URL so manifest 200s with 403 segments are caught. Any resolve/transport failure
# returns non-zero (treated as "this client can't fetch"). Called only from `if` conditions.
probe_media_fetchable() {
    local url=$1 fmt=$2
    shift 2 # remaining args (if any) are the client, e.g. --cookies-from-browser chrome
    local client_args=("$@")
    if (( ${#client_args[@]} == 0 )); then
        client_args=(--extractor-args "youtube:player_client=android")
    fi
    local media
    media=$(yt-dlp -g -f "$fmt" "${client_args[@]}" --no-warnings --quiet "$url" 2>/dev/null) || return 1
    media=${media%%$'\n'*} # video mode yields video+audio lines; the first is enough
    [[ -n "$media" ]] || return 1
    if [[ "$media" == *"m3u8"* || "$media" == *"/hls_playlist/"* ]]; then
        local first_seg
        first_seg=$(curl -sSL --max-time 5 "$media" 2>/dev/null | grep -E '^https?://' | head -n 1 || true)
        [[ -n "$first_seg" ]] && media="$first_seg"
    fi
    local code
    code=$(curl -sSL -o /dev/null -I -r 0- --max-time 10 -w '%{http_code}' "$media" 2>/dev/null) || return 1
    [[ "$code" == 2* ]]
}

# Probe-then-play, kept separate from play_mode_url() (which stays a pure mode dispatcher).
# Cookies are ON by default so login-gated content plays; but some PUBLIC videos 403 with
# cookies (missing GVS PO token) while the anonymous client fetches fine, and login-gated
# videos are the reverse. The naive approach — play, let mpv 403, then replay without
# cookies — dumps mpv's error wall on screen before the retry. Instead we probe up front
# which client actually fetches the media, then launch mpv ONCE with it: no failed first
# attempt, no error dump, in either case. Cost: one extra yt-dlp resolve + a 1-byte HTTP
# probe before playback (a login-gated hit probes once; a cookie-403 public video probes
# twice). `local YT_COOKIE_ARGS=()` shadows the global (bash dynamic scoping) so run_mpv
# drops cookies for this play without touching the real setting. PLAYBACK_RETRIED records
# that we fell back to anonymous, surfaced in the playback JSON's `retried` field.
# With YT_COOKIE_BROWSER=none there is nothing to choose, so we skip the probe entirely.
# When curl is unavailable we cannot probe, so we fall back to the older play-fail-replay
# retry (SIGINT 130 excluded — an intentional stop, not a failure).
play_url_with_probe() {
    local url=$1 mode=$2 rc=0 fmt

    # Global (not local) so the playback JSON emitter can report the anonymous fallback.
    # Reset per call so a prior play doesn't leak.
    PLAYBACK_RETRIED=0

    # Anonymous-only (no cookies to weigh) → play directly, no probe.
    if ((${#YT_COOKIE_ARGS[@]} == 0)); then
        play_mode_url "$url" "$mode" || rc=$?
        return $rc
    fi

    if have_probe_tools; then
        fmt=$(format_for_mode "$mode")
        # Keep cookies if they fetch; otherwise, only switch to anonymous if THAT fetches.
        # If neither does (network down, unresolvable, both 403), keep cookies and let mpv
        # produce the real error/exit code so the JSON reason taxonomy stays accurate.
        if ! probe_media_fetchable "$url" "$fmt" "${YT_COOKIE_ARGS[@]}" &&
            probe_media_fetchable "$url" "$fmt"; then
            PLAYBACK_RETRIED=1
            local YT_COOKIE_ARGS=()
        fi
        play_mode_url "$url" "$mode" || rc=$?
        return $rc
    fi

    # No curl: fall back to play-fail-replay (drop cookies once if the cookies attempt fails).
    play_mode_url "$url" "$mode" || rc=$?
    if ((rc != 0 && rc != 130)); then
        echo "Playback failed (exit $rc); retrying once without cookies (anonymous)..." >&2
        PLAYBACK_RETRIED=1
        local YT_COOKIE_ARGS=()
        rc=0
        play_mode_url "$url" "$mode" || rc=$?
    fi
    return $rc
}

play_url_directly() {
    local url=$1
    play_url_with_probe "$url" "$PLAYBACK_MODE"
}

# Map captured mpv/yt-dlp output + exit code to a small, stable taxonomy so an agent
# caller can branch on `reason` instead of string-matching raw player wording (which
# is not a contract and drifts across versions). `unknown` is the conservative
# default — we never guess a specific cause we didn't positively identify.
classify_playback_error() {
    local text=$1 rc=$2
    if ((rc == 130)); then
        echo "stopped_by_user"
        return
    fi
    if grep -qiE 'HTTP Error 403|[^a-z]403[^0-9]|Forbidden' <<<"$text"; then
        echo "forbidden"
        return
    fi
    if grep -qiE 'Video unavailable|Private video|has been removed|no longer available|does not exist|account.*terminated|members-only|Sign in to confirm' <<<"$text"; then
        echo "unavailable"
        return
    fi
    if grep -qiE 'Requested format is not available|No video formats|requested format|only images are available' <<<"$text"; then
        echo "format_unavailable"
        return
    fi
    if grep -qiE 'Temporary failure in name resolution|Failed to resolve|Name or service not known|Network is unreachable|Connection (refused|timed out|reset)|Could not connect|getaddrinfo|Timed out|Operation timed out' <<<"$text"; then
        echo "network"
        return
    fi
    echo "unknown"
}

# Opt-in structured playback (yt-play -j / OUTPUT_MODE=json). Captures the player's
# stdout+stderr (suppressing its chatter) and emits exactly one final JSON line
# describing the outcome, reusing play_url_with_probe unchanged. rc 130 (user hit
# q/ctrl-c) is a normal stop, reported as status "ok" with reason "stopped_by_user".
# The real non-zero exit is still propagated so the process exit code stays truthful.
play_url_json() {
    local url=$1 mode=$2
    local tmp rc=0
    tmp=$(mktemp "${TMPDIR:-/tmp}/yt-cli-play.XXXXXX" 2>/dev/null) || tmp="${TMPDIR:-/tmp}/yt-cli-play.$$"

    play_url_with_probe "$url" "$mode" >"$tmp" 2>&1 || rc=$?

    local status reason
    if ((rc == 0)); then
        status="ok"
        reason=""
    elif ((rc == 130)); then
        status="ok"
        reason="stopped_by_user"
    else
        status="error"
        reason=$(classify_playback_error "$(cat "$tmp" 2>/dev/null)" "$rc")
    fi
    rm -f "$tmp"

    local retried_json="false"
    ((PLAYBACK_RETRIED)) && retried_json="true"

    jq -nc \
        --arg status "$status" \
        --arg url "$url" \
        --arg mode "$mode" \
        --argjson exit_code "$rc" \
        --arg reason "$reason" \
        --argjson retried "$retried_json" \
        '{status: $status, url: $url, mode: $mode, exit_code: $exit_code, reason: (if $reason == "" then null else $reason end), retried: $retried}'

    ((rc == 130)) && return 0
    return "$rc"
}

# The yt-dlp format string a given playback mode resolves to (used for both the
# detached-state record and --get-url). Mirrors the per-mode choices in the
# play_*_url functions above.
format_for_mode() {
    case "$1" in
    video) echo "$YT_VIDEO_FORMAT" ;;
    fast) echo "$YT_VIDEO_FORMAT_FAST" ;;
    ascii) echo "$YT_VIDEO_FORMAT" ;;
    *) echo "$YT_AUDIO_FORMAT" ;; # audio, viz
    esac
}

# A detached playback is tracked by its PROCESS GROUP, not a PID tree. The child bash
# is launched as its own process-group leader (see detach_play), so its pgid == its
# pid, and every descendant it forks — the probe's yt-dlp/curl, mpv, and (on curl-less
# machines) any late play-fail-replay mpv — inherits that pgid. This is what a PID-tree
# walk cannot handle: a late-spawned mpv appears after any one-time snapshot, and once
# bash exits the mpv reparents to init (ppid=1) so it is no longer findable by parentage.
# The pgid is invariant under reparenting, so group operations always reach it.
# pgrep -g / kill -<pgid> are available on macOS and Linux.

# True if any process in group $pgid is still alive.
group_alive() {
    local pgid=${1:-}
    [[ -n "$pgid" ]] && [[ -n "$(pgrep -g "$pgid" 2>/dev/null)" ]]
}

# Stop the whole process group: SIGINT (mpv treats it as a clean stop, like q), wait
# briefly for graceful exit, then SIGKILL any survivor. Negative PID targets the group.
stop_group() {
    local pgid=$1
    kill -INT -"$pgid" 2>/dev/null || true

    local i
    for ((i = 0; i < 15; i++)); do
        group_alive "$pgid" || return 0
        sleep 0.2
    done

    kill -KILL -"$pgid" 2>/dev/null || true
}

# Per-instance derived paths. Functions, not constants, since they key off the id;
# every detached player owns players/<id>.json, mpv-<id>.sock, mpv-<id>.log.
player_state() { echo "$PLAYERS_DIR/$1.json"; }
player_sock() { echo "$STATE_DIR/mpv-$1.sock"; }
player_log() { echo "$STATE_DIR/mpv-$1.log"; }
player_lock_dir() { echo "$STATE_DIR/lock-$1"; }

# Serialize concurrent read-modify-write patches to the same player state file (e.g.
# detach_title_updater's ~3s-delayed title backfill racing a --set-volume call): both
# do temp+mv RMW with no version check, so without mutual exclusion whichever mv lands
# last silently clobbers the other's field. `mkdir` is atomic on POSIX, making it a
# portable lock on bash 3.2 (no flock binary on stock macOS). Bounded spin (5s) so a
# lock left behind by a crashed holder can't wedge callers forever; on timeout the
# caller proceeds unlocked, same best-effort risk these patches already tolerated
# before this lock existed.
lock_player_state() {
    local id=$1 dir
    dir=$(player_lock_dir "$id")
    local i
    for ((i = 0; i < 50; i++)); do
        mkdir "$dir" 2>/dev/null && return 0
        sleep 0.1
    done
    return 1
}

unlock_player_state() {
    rmdir "$(player_lock_dir "$1")" 2>/dev/null || true
}

# Mint a fresh, collision-free player id by atomically creating a reservation file
# with mktemp; the id is its basename. Done BEFORE launch so the socket path is
# known up front (the child's pid isn't available until $! after launch) and so the
# handle is immune to pid reuse. detach_play removes the bare reservation file once
# the real <id>.json is written.
new_player_id() {
    basename "$(mktemp "$PLAYERS_DIR/XXXXXX")"
}

# Background a playback and record it in a per-player state file (players/<id>.json)
# so a later --status/--stop/--set-volume can find it. Re-execs this script (SELF)
# with a plain, non-detached play invocation via nohup so it survives the launching
# process exiting; the child is tracked by its PROCESS GROUP. Multiple detached
# players run concurrently — each gets its own id, IPC socket, state file, and log,
# so a 2nd -d is NOT refused (that is the point). Audio only in practice: a detached
# process has no controlling terminal, so video/ascii/viz have nowhere to render.
detach_play() {
    local url=$1
    # SECURITY: 0700 so no other local user can traverse in and connect to a player's
    # IPC socket (a control channel — a peer could drive mpv). macOS $TMPDIR is already
    # per-user; the /tmp fallback (Linux) is world-traversable at umask 022, so pin the
    # mode explicitly on both the parent and the players/ dir.
    # mkdir -p is the sole creator of both STATE_DIR (parent) and PLAYERS_DIR; -m 700 only
    # takes on the dir it actually creates, so the following chmod re-asserts 700 on both.
    # Idempotent and cheap (two syscalls) — deliberately re-run every launch as a safety net
    # rather than trust the mode was never widened after creation; nothing in this codebase
    # resets it between launches.
    mkdir -p -m 700 "$PLAYERS_DIR" 2>/dev/null || true
    chmod 700 "$STATE_DIR" "$PLAYERS_DIR" 2>/dev/null || true

    local fmt started_at pid volume_json id sock log
    fmt=$(format_for_mode "$PLAYBACK_MODE")
    started_at=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    volume_json=null
    [[ -n "$VOLUME" ]] && volume_json="$VOLUME"

    # Mint the handle BEFORE launch so the socket path is known up front (see
    # new_player_id): the child's pid isn't available until $! after launch, but the
    # socket must be named at launch via YT_IPC_SOCK. The id is a monotonic token,
    # immune to pid reuse; the pid is stored in the state file for liveness only.
    id=$(new_player_id)
    sock=$(player_sock "$id")
    log=$(player_log "$id")
    rm -f "$sock" 2>/dev/null || true

    # Launch the child in its OWN process group so the whole playback (incl. any
    # fallback mpv) can be stopped as a unit later (see stop_group). Enabling monitor
    # mode (set -m) makes a backgrounded job a process-group leader whose pgid == its
    # pid; nohup + disown detach it from this shell so it survives our exit. YT_IPC_SOCK
    # is exported into the child's environment so its run_mpv adds --input-ipc-server.
    # Job-control chatter is routed away from stdout so -j output stays one JSON line.
    set -m
    YT_IPC_SOCK="$sock" nohup bash "$SELF" -f "$PLAYBACK_MODE" ${VOLUME:+--volume "$VOLUME"} "$url" >"$log" 2>&1 &
    pid=$!
    set +m
    disown "$pid" 2>/dev/null || true

    # Persist state under a guarded write. new_player_id created a bare "$PLAYERS_DIR/$id"
    # (mktemp) to reserve the id; the real state lives in "$id.json". The reservation token
    # is only reaped AFTER the real file lands, so under `set -euo pipefail` a bare jq/mv
    # failure (disk full, permissions changed mid-run by a concurrent reap) would abort
    # before cleanup and orphan the token forever — the *.json reap globs never touch a
    # bare non-.json file. Guard both steps so the token is reaped on every path, and stop
    # the just-launched mpv group if we can't track it (else it plays on as an orphan the
    # lifecycle verbs can't find).
    local sf; sf=$(player_state "$id")
    if ! jq -n \
        --arg id "$id" \
        --argjson pid "$pid" \
        --arg url "$url" \
        --arg mode "$PLAYBACK_MODE" \
        --arg format "$fmt" \
        --arg started_at "$started_at" \
        --arg log "$log" \
        --arg sock "$sock" \
        --argjson volume "$volume_json" \
        '{id: $id, pid: $pid, url: $url, mode: $mode, format: $format, started_at: $started_at, log: $log, sock: $sock, title: null, volume: $volume}' >"$sf.tmp.$pid"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        stop_group "$pid"
        die "failed to write player state for $url"
    fi
    if ! mv -f "$sf.tmp.$pid" "$sf"; then
        rm -f "$sf.tmp.$pid" "$PLAYERS_DIR/$id" 2>/dev/null || true
        stop_group "$pid"
        die "failed to persist player state for $url"
    fi
    rm -f "$PLAYERS_DIR/$id" 2>/dev/null || true

    # Title is unknown here and resolving it is a ~3s yt-dlp round-trip — detach must
    # return immediately, so we do NOT block on it. Spawn an independent background updater
    # that fetches the title and patches it into the state file a few seconds later.
    # --status shows title:null until it lands. See detach_title_updater for the guards.
    detach_title_updater "$id" "$pid" "$url" &
    disown 2>/dev/null || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc \
            --arg id "$id" --argjson pid "$pid" --arg url "$url" --arg mode "$PLAYBACK_MODE" --arg started_at "$started_at" \
            '{status: "started", id: $id, pid: $pid, url: $url, mode: $mode, started_at: $started_at, title: null}'
    else
        printf "Detached playback started (id %s, pid %s, mode %s): %s\n" "$id" "$pid" "$PLAYBACK_MODE" "$url"
        printf "  status: yt-play --status   stop: yt-play --stop --id %s   log: %s\n" "$id" "$log"
    fi
}

# Background metadata backfill for a detached playback: fetch the title (the ~3s yt-dlp
# round-trip we deliberately keep OFF the detach hot path) and patch it into the player's
# state file. Playback-independent — it is not the play child, so it neither blocks the
# detach return nor is stopped by playback lifecycle. Self-guarding: it patches ONLY while
# this pid still owns the state file, so a --stop during the fetch window wins and is never
# clobbered (jq emits nothing when the pid no longer matches, and the empty temp is dropped
# without touching the live file). Honours cookies like playback. Best-effort: any failure
# leaves title:null, which every caller already tolerates. `trap '' HUP INT` lets it outlive
# the returning parent without nohup plumbing.
detach_title_updater() {
    local id=$1 pid=$2 url=$3 title tmp sf
    trap '' HUP INT

    local ycmd=(yt-dlp --print "%(title)s" --skip-download)
    ((${#YT_COOKIE_ARGS[@]} > 0)) && ycmd+=("${YT_COOKIE_ARGS[@]}")
    ycmd+=(--no-warnings --quiet "$url")

    title=$("${ycmd[@]}" 2>/dev/null) || return 0
    [[ -n "$title" ]] || return 0
    sf=$(player_state "$id")
    [[ -f "$sf" ]] || return 0

    tmp="$sf.tmp.$pid"
    lock_player_state "$id"
    if jq --arg t "$title" --arg p "$pid" \
        'if ((.pid | tostring) == $p) then (.title = $t) else empty end' \
        "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"
}

# Scan $PLAYERS_DIR once, reaping any player whose process group is gone (rm its
# state/sock/log). "What counts as dead" (currently: group not alive) lives here in exactly
# one place, shared by resolve_target, do_status, and do_stop --all so those verbs can never
# disagree about which players exist.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...); bash 3.2 arrays don't survive command
# substitution): sets three PARALLEL GLOBAL arrays for the survivors, index-aligned —
#   LIVE_PLAYER_FILES[i] = players/<id>.json path
#   LIVE_PLAYER_IDS[i]   = its .id
#   LIVE_PLAYER_PIDS[i]  = its .pid
# reading .id/.pid once here means no caller has to reopen the file for them.
reap_dead_players() {
    LIVE_PLAYER_FILES=()
    LIVE_PLAYER_IDS=()
    LIVE_PLAYER_PIDS=()
    local f id pid
    [[ -d "$PLAYERS_DIR" ]] || return 0
    for f in "$PLAYERS_DIR"/*.json; do
        [[ -e "$f" ]] || continue
        id=$(jq -r '.id // empty' "$f" 2>/dev/null || true)
        pid=$(jq -r '.pid // empty' "$f" 2>/dev/null || true)
        if group_alive "$pid"; then
            LIVE_PLAYER_FILES+=("$f")
            LIVE_PLAYER_IDS+=("$id")
            LIVE_PLAYER_PIDS+=("$pid")
        else
            rm -f "$f" 2>/dev/null || true
            [[ -n "$id" ]] && rm -f "$(player_sock "$id")" "$(player_log "$id")" 2>/dev/null || true
        fi
    done
}

# Map a request to a single live player, reaping any dead ones along the way. The single
# place --set-volume and --stop share for target selection.
#
# RETURN-VALUE DISCIPLINE (do NOT capture in $(...)): on success sets the GLOBAL
# RESOLVED_ID and returns 0; on failure sets RESOLVE_ERR ("not_playing"|"ambiguous")
# (+ RESOLVE_PLAYERS_JSON for ambiguous) and returns non-zero. Nothing is echoed to
# stdout — the caller decides how to render (a --stop treats not_playing as idempotent
# success; a --set-volume treats it as exit 4), so the error text must not be trapped
# by command substitution.
#   --id given          -> that player if live, else not_playing
#   no --id, exactly 1  -> that player (common case, zero-friction)
#   no --id, 0 players   -> not_playing
#   no --id, 2+ players  -> ambiguous (candidates in RESOLVE_PLAYERS_JSON)
resolve_target() {
    local want_id=$1
    RESOLVED_ID=""
    RESOLVE_ERR=""
    RESOLVE_PLAYERS_JSON="[]"

    # Read the live set from reap_dead_players' globals directly — copying via
    # ("${arr[@]}") would abort under `set -u` on bash 3.2 when the array is empty (the
    # common "nothing playing" case). Index access and count are safe on an empty array.
    reap_dead_players
    local n=${#LIVE_PLAYER_IDS[@]}

    if [[ -n "$want_id" ]]; then
        local i
        for ((i = 0; i < n; i++)); do
            if [[ "${LIVE_PLAYER_IDS[$i]}" == "$want_id" ]]; then
                RESOLVED_ID="$want_id"
                return 0
            fi
        done
        RESOLVE_ERR="not_playing"
        return 1
    fi

    if ((n == 0)); then
        RESOLVE_ERR="not_playing"
        return 1
    elif ((n == 1)); then
        RESOLVED_ID="${LIVE_PLAYER_IDS[0]}"
        return 0
    else
        RESOLVE_ERR="ambiguous"
        RESOLVE_PLAYERS_JSON=$(jq -s '[.[] | {id, pid, title, url}]' "${LIVE_PLAYER_FILES[@]}")
        return 1
    fi
}

# List ALL live detached players (reaping dead ones). Always exits 0 (an agent polling
# status must not see a non-zero exit as failure); empty set is still a success.
do_status() {
    reap_dead_players

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        if ((${#LIVE_PLAYER_FILES[@]})); then
            jq -s '{status: "players", players: [.[] | {id, pid, url, mode, volume, title, started_at}]}' "${LIVE_PLAYER_FILES[@]}"
        else
            echo '{"status":"players","players":[]}'
        fi
    else
        if ((${#LIVE_PLAYER_FILES[@]})); then
            local f id pid mode started_at url title volume vol_suffix
            for f in "${LIVE_PLAYER_FILES[@]}"; do
                vol_suffix=""
                # One jq call for the structural fields (never contain tabs/newlines) via
                # @tsv, instead of five separate per-field forks. title stays on its own
                # jq -r so a title with an embedded tab/newline round-trips byte-for-byte
                # rather than being @tsv-escaped.
                IFS=$'\t' read -r id pid mode started_at url < <(
                    jq -r '[.id, .pid, .mode, .started_at, .url] | @tsv' "$f" 2>/dev/null
                ) || true
                title=$(jq -r '.title // empty' "$f" 2>/dev/null || true)
                volume=$(jq -r '.volume // empty' "$f" 2>/dev/null || true)
                [[ -n "$volume" ]] && vol_suffix=", volume $volume"
                if [[ -n "$title" ]]; then
                    printf "playing (id %s, pid %s, mode %s%s, since %s): %s\n  %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$started_at" "$title" "$url"
                else
                    printf "playing (id %s, pid %s, mode %s%s, since %s): %s\n" \
                        "$id" "$pid" "$mode" "$vol_suffix" "$started_at" "$url"
                fi
            done
        else
            echo "idle (nothing playing)"
        fi
    fi
    exit 0
}

# Stop detached playback. Idempotent: exits 0 when nothing (or nothing matching) is
# playing. --all stops every live player; otherwise a single target is resolved
# (exactly-one is zero-friction; 2+ without --id is ambiguous → exit 4).
do_stop() {
    local want_id=$1 stop_all=$2
    local id any=false

    if ((stop_all)); then
        # reap_dead_players already rm'd every dead player's state/sock/log; the survivors
        # are exactly the ones to stop. Kill each group, then remove its state/sock/log.
        reap_dead_players
        local i n=${#LIVE_PLAYER_FILES[@]}
        ((n > 0)) && any=true
        for ((i = 0; i < n; i++)); do
            stop_group "${LIVE_PLAYER_PIDS[$i]}"
            rm -f "${LIVE_PLAYER_FILES[$i]}" 2>/dev/null || true
            rm -f "$(player_sock "${LIVE_PLAYER_IDS[$i]}")" "$(player_log "${LIVE_PLAYER_IDS[$i]}")" 2>/dev/null || true
        done
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc --argjson stopped "$any" '{status: "stopped", scope: "all", stopped: $stopped}'
        else
            if [[ "$any" == true ]]; then echo "stopped all playback"; else echo "nothing to stop"; fi
        fi
        exit 0
    fi

    if ! resolve_target "$want_id"; then
        if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
            if [[ "$OUTPUT_MODE" == "json" ]]; then
                jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
            else
                echo "multiple players playing; specify --id or --all (see 'yt-play --status')" >&2
            fi
            exit 4
        fi
        # not_playing → idempotent success, not an error.
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            jq -nc '{status: "stopped", stopped: false}'
        else
            echo "nothing to stop"
        fi
        exit 0
    fi

    local sf pid_stop
    id=$RESOLVED_ID
    sf=$(player_state "$id")
    pid_stop=$(jq -r '.pid // empty' "$sf" 2>/dev/null || true)
    if group_alive "$pid_stop"; then
        stop_group "$pid_stop"
        any=true
    fi
    rm -f "$sf" 2>/dev/null || true
    rm -f "$(player_sock "$id")" "$(player_log "$id")" 2>/dev/null || true

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson stopped "$any" '{status: "stopped", id: $id, stopped: $stopped}'
    else
        if [[ "$any" == true ]]; then echo "stopped playback (player $id)"; else echo "nothing to stop"; fi
    fi
    exit 0
}

# Adjust volume on a detached player via mpv's per-instance JSON IPC socket. One-shot:
# open, send, read the matching ack, close, exit (stateless-per-call). Exit 4 for any
# "did not take effect" (no such/no player, ambiguous, or IPC failure); the -j
# status/reason carries the why. See DESIGN-yt.md §14/§15.
do_set_volume() {
    local n=$1 want_id=$2
    is_non_negative_int "$n" || die "--set-volume must be a non-negative integer"
    ((n <= 100)) || die "--set-volume must be between 0 and 100" # symmetry w/ launch --volume

    if ! resolve_target "$want_id"; then
        if [[ "$OUTPUT_MODE" == "json" ]]; then
            if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
                jq -nc --argjson players "$RESOLVE_PLAYERS_JSON" '{status: "ambiguous", reason: "multiple_players", players: $players}'
            else
                echo '{"status":"not_playing"}'
            fi
        else
            if [[ "$RESOLVE_ERR" == "ambiguous" ]]; then
                echo "multiple players playing; specify --id (see 'yt-play --status')" >&2
            else
                echo "nothing playing" >&2
            fi
        fi
        exit 4
    fi

    local id sock
    id=$RESOLVED_ID
    sock=$(player_sock "$id")
    if [[ ! -S "$sock" ]]; then
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"ipc_failed"}' || echo "failed to set volume (no IPC socket)" >&2
        exit 4
    fi

    # request_id correlation: mpv multiplexes ASYNC EVENTS to every client, interleaved
    # with replies (mpv ipc.rst), so head -1 alone can grab an event. Filter by request_id.
    # `|| true` is REQUIRED — under set -euo pipefail the pipeline exits non-zero on nc
    # timeout / SIGPIPE (head closing early) and would abort the script AT the assignment.
    local reply
    reply=$(printf '{"command":["set_property","volume",%d],"request_id":1}\n' "$n" |
        nc -U -w1 "$sock" 2>/dev/null |
        jq -c 'select(.request_id==1)' 2>/dev/null | head -1) || true

    if [[ "$(jq -r '.error // empty' <<<"$reply" 2>/dev/null)" != success ]]; then
        [[ "$OUTPUT_MODE" == "json" ]] && echo '{"status":"error","reason":"ipc_failed"}' || echo "failed to set volume" >&2
        exit 4
    fi

    # Atomic patch of this player's state file (temp+mv, same idiom as detach_title_updater),
    # under the same per-id lock so this can't interleave with a concurrent title backfill.
    local sf tmp
    sf=$(player_state "$id")
    tmp="$sf.tmp.$$"
    lock_player_state "$id"
    if jq --argjson v "$n" '.volume = $v' "$sf" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$sf"
    else
        rm -f "$tmp" 2>/dev/null || true
    fi
    unlock_player_state "$id"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        jq -nc --arg id "$id" --argjson volume "$n" '{status: "ok", id: $id, volume: $volume}'
    else
        echo "volume set to $n (player $id)"
    fi
    exit 0
}

# Resolve the direct stream URL(s) for a video without playing — non-blocking and
# side-effect-free, so an agent can compose playback (fetch the URL, hand it to
# another player, probe availability) instead of only being able to fire-and-block.
# Honours the chosen mode's format plus cookies (when login is opted in), mirroring playback.
resolve_stream_url() {
    local url=$1 fmt
    fmt=$(format_for_mode "$PLAYBACK_MODE")

    local cmd=(yt-dlp -g -f "$fmt")
    if ((${#YT_COOKIE_ARGS[@]} > 0)); then
        cmd+=("${YT_COOKIE_ARGS[@]}")
    else
        cmd+=(--extractor-args "youtube:player_client=android")
    fi
    cmd+=(--no-warnings --quiet "$url")

    local out rc=0
    out=$("${cmd[@]}" 2>/dev/null) || rc=$?

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        local status="ok"
        ((rc != 0)) && status="error"
        printf '%s\n' "$out" | jq -Rn \
            --arg status "$status" --arg url "$url" --arg mode "$PLAYBACK_MODE" --arg format "$fmt" \
            '{status: $status, url: $url, mode: $mode, format: $format, stream_urls: [inputs | select(length > 0)]}'
    else
        if ((rc != 0)); then
            die "could not resolve stream URL for: $url"
        fi
        printf '%s\n' "$out"
    fi
    exit "$rc"
}

# Fetch rich metadata for a video WITHOUT playing — read-only, non-blocking, and
# side-effect-free. Closes the gap where an agent had to leave this ecosystem and drop
# to raw `yt-dlp --dump-json` just to learn what a video is (description, chapters,
# uploader, upload date, like count). Honours cookies like playback so login-gated
# videos resolve. Output mirrors search's field discipline: -j projects a lean,
# high-signal schema (the raw record carries ~40 fields of formats/thumbnails/fragments
# that are pure token ballast for a headless caller); -J returns the full raw record;
# default is a readable text block. duration_fmt is synthesized the same way search
# does, so info and search agree on the shape.
resolve_info() {
    local url=$1

    local cmd=(yt-dlp --dump-single-json --skip-download)
    if ((${#YT_COOKIE_ARGS[@]} > 0)); then
        cmd+=("${YT_COOKIE_ARGS[@]}")
    fi
    cmd+=(--no-warnings --quiet "$url")

    local raw rc=0
    raw=$("${cmd[@]}" 2>/dev/null) || rc=$?

    if ((rc != 0)) || [[ -z "$raw" ]]; then
        if [[ "$OUTPUT_MODE" == "json" || "$OUTPUT_MODE" == "json_full" ]]; then
            jq -nc --arg url "$url" '{status: "error", url: $url, reason: "could not fetch metadata"}'
            exit 1
        fi
        die "could not fetch metadata for: $url"
    fi

    local duration duration_fmt
    duration=$(printf '%s' "$raw" | jq -r '.duration // empty')
    if [[ -n "$duration" ]]; then
        duration_fmt=$(convert_seconds "$duration")
    else
        duration_fmt=""
    fi

    case "$OUTPUT_MODE" in
    json_full)
        printf '%s\n' "$raw" | jq '.'
        ;;
    json)
        printf '%s\n' "$raw" | jq --arg df "$duration_fmt" '{
            status: "ok",
            id, title,
            url: .webpage_url,
            channel, uploader, upload_date,
            duration, duration_fmt: $df,
            view_count, like_count, live_status,
            description,
            chapters: (if (.chapters | type) == "array"
                       then [.chapters[] | {start_time, end_time, title}]
                       else null end)
        }'
        ;;
    *)
        local title channel upload_date view_count like_count live_status webpage_url description
        title=$(printf '%s' "$raw" | jq -r '.title // "(untitled)"')
        channel=$(printf '%s' "$raw" | jq -r '.channel // .uploader // "?"')
        upload_date=$(printf '%s' "$raw" | jq -r '.upload_date // "?"')
        view_count=$(printf '%s' "$raw" | jq -r '.view_count // "?"')
        like_count=$(printf '%s' "$raw" | jq -r '.like_count // "?"')
        live_status=$(printf '%s' "$raw" | jq -r '.live_status // "?"')
        webpage_url=$(printf '%s' "$raw" | jq -r '.webpage_url // empty')
        description=$(printf '%s' "$raw" | jq -r '.description // ""')

        printf '%s %s\n' "$MUSIC_CHAR" "$title"
        printf '  - channel: %s\n' "$channel"
        printf '  - uploaded: %s\n' "$upload_date"
        [[ -n "$duration_fmt" ]] && printf '  - duration: %s\n' "$duration_fmt"
        printf '  - views: %s   likes: %s\n' "$view_count" "$like_count"
        printf '  - live: %s\n' "$live_status"
        [[ -n "$webpage_url" ]] && printf '  - url: %s\n' "$webpage_url"

        local chapters_txt
        chapters_txt=$(printf '%s' "$raw" | jq -r '
            if (.chapters | type) == "array" and (.chapters | length) > 0 then
                .chapters[]
                | ((.start_time // 0) | floor) as $s
                | (($s / 60) | floor) as $m
                | ($s - $m * 60) as $sec
                | "  " + ($m | tostring) + ":" + (if $sec < 10 then "0" else "" end) + ($sec | tostring) + "  " + (.title // "")
            else empty end')
        [[ -n "$chapters_txt" ]] && printf '\nChapters:\n%s\n' "$chapters_txt"

        [[ -n "$description" ]] && printf '\nDescription:\n%s\n' "$description"
        ;;
    esac
    exit "$rc"
}

# ==============================================================================
# 4. SEARCH EXECUTION & INTERACTIVE MENU LOGIC
# ==============================================================================

fetch_results() {
    local match_filter_option="duration > $MIN_DURATION"
    if ((MAX_DURATION > 0)); then
        match_filter_option+=" and duration < $MAX_DURATION"
    fi

    local cmd=(
        yt-dlp
        "ytsearch${NUM_RESULTS}:${QUERY}"
        --match-filter "$match_filter_option"
    )

    if (( ${#YT_COOKIE_ARGS[@]} > 0 )); then
        cmd+=("${YT_COOKIE_ARGS[@]}")
    fi

    cmd+=(
        --flat-playlist
        --dump-single-json
        -f ba
        --skip-download
        --no-warnings
        --ignore-errors
        --quiet
    )

    if [[ -n "$FORMAT_SORT" ]]; then
        cmd+=(--format-sort "$FORMAT_SORT")
    fi

    local result_json
    result_json=$("${cmd[@]}")

    # Sort is a client-side jq re-order of the fetched set. "relevance" keeps YouTube's
    # native ranking (the order ytsearch returned) — no re-sort. The numeric fields sort
    # descending (reverse). view_count/duration are always present in flat search results;
    # like_count/comment_count are NOT (they need per-video extraction — see DESIGN-yt.md).
    local jq_filter='.entries'
    case "$SORT_FIELD" in
    relevance) ;;  # native YouTube ranking; leave order untouched
    duration) jq_filter+=" | sort_by(.duration) | reverse" ;;
    view_count) jq_filter+=" | sort_by(.view_count) | reverse" ;;
    *) echo "yt: unknown sort field '$SORT_FIELD' (relevance|view_count|duration)" >&2; exit 1 ;;
    esac

    local raw_json
    raw_json=$(echo "$result_json" | jq "$jq_filter")

    # Add the synthesized duration_fmt using convert_seconds
    FILTERED_JSON=$(echo "$raw_json" | jq -c '.[]' | while IFS= read -r item; do
        local duration duration_fmt
        duration=$(echo "$item" | jq -r '.duration')
        duration_fmt=$(convert_seconds "$duration")
        echo "$item" | jq --arg df "$duration_fmt" '. + {duration_fmt: $df}'
    done | jq -s '.')
}

print_list() {
    echo "$FILTERED_JSON" | jq 'to_entries | map(.value + {index: (.key + 1)})' | jq -c '.[]' |
        while IFS= read -r line; do
            local index title duration view_count url duration_fmt
            index=$(echo "$line" | jq -r '.index')
            title=$(echo "$line" | jq -r '.title')
            duration=$(echo "$line" | jq -r '.duration')
            view_count=$(echo "$line" | jq -r '.view_count')
            url=$(echo "$line" | jq -r '.url')
            duration_fmt=$(convert_seconds "$duration")
            echo "$MUSIC_CHAR $index. $title"
            echo "  - $duration_fmt"
            echo "  - $view_count views"
            echo "  - $url"
        done
}

# Structured search output for agent callers. Wraps results in a stable
# {query, count, results} envelope so a caller gets the query echoed back and a
# result count without having to derive them. Default (OUTPUT_MODE=json) projects
# each entry to a lean, high-signal 8-field schema — the raw yt-dlp entries carry
# ~23 fields (thumbnail arrays, ie_key, x-forwarded-for, two URL variants, …) that
# are pure token ballast for a headless caller. OUTPUT_MODE=json_full (-J) keeps
# every raw field for the rare case fidelity is needed. FILTERED_JSON's own shape is
# left untouched (print_list still reads it), so we project only here.
emit_search_json() {
    local projection
    if [[ "$OUTPUT_MODE" == "json_full" ]]; then
        projection='.'
    else
        projection='map({id, title, url, channel, duration, duration_fmt, view_count, live_status})'
    fi
    echo "$FILTERED_JSON" | jq --arg q "$QUERY" "{query: \$q, count: length, results: ($projection)}"
}

# ==============================================================================
# 5. CLI OPTIONS PARSING & VALIDATION
# ==============================================================================

NUM_RESULTS=25
MIN_DURATION=0
MAX_DURATION=0
SORT_FIELD="relevance"
PLAYBACK_MODE="audio"
FORMAT_SORT=""
VOLUME=""
COLOR_MODE="auto"
MUSIC_CHAR="♫"
# Default search output is the plain list; -j/-J/-l override. (No interactive menu:
# the core is non-interactive — interactive browsing lives in yt-tui.)
OUTPUT_MODE="list"
FILTERED_JSON=""
# Playback lifecycle / structured-output state.
DETACH=0
ACTION=""            # "" (normal) | status | stop | geturl | info | set-volume
PLAYBACK_RETRIED=0   # set by play_url_with_probe; surfaced in the playback JSON
SET_VOLUME_ARG=""    # value from --set-volume N
TARGET_ID=""         # value from --id (target a specific detached player)
STOP_ALL=0           # --stop --all
RESOLVED_ID=""       # resolve_target out-param: the resolved player id
RESOLVE_ERR=""       # resolve_target out-param: "not_playing" | "ambiguous"
RESOLVE_PLAYERS_JSON="[]"  # resolve_target out-param: candidates on ambiguity
STATE_DIR="${TMPDIR:-/tmp}/yt-cli-$(id -u)"
PLAYERS_DIR="$STATE_DIR/players"   # one <id>.json per detached player

normalized_args=()
while (($#)); do
    case "$1" in
    --help)
        normalized_args+=("-h")
        shift
        ;;
    --color)
        [[ $# -ge 2 ]] || die "--color requires a value"
        COLOR_MODE="$2"
        shift 2
        ;;
    --color=*)
        COLOR_MODE="${1#*=}"
        shift
        ;;
    --volume)
        [[ $# -ge 2 ]] || die "--volume requires a value"
        VOLUME="$2"
        shift 2
        ;;
    --volume=*)
        VOLUME="${1#*=}"
        shift
        ;;
    --list|-l)
        normalized_args+=("-l")
        shift
        ;;
    --json|-j)
        normalized_args+=("-j")
        shift
        ;;
    --json-full)
        normalized_args+=("-J")
        shift
        ;;
    --detach)
        normalized_args+=("-d")
        shift
        ;;
    --status)
        ACTION=status
        shift
        ;;
    --stop)
        ACTION=stop
        shift
        ;;
    --get-url)
        ACTION=geturl
        shift
        ;;
    --info)
        ACTION=info
        shift
        ;;
    --set-volume)
        [[ $# -ge 2 ]] || die "--set-volume requires a value"
        ACTION=set-volume
        SET_VOLUME_ARG="$2"
        shift 2
        ;;
    --set-volume=*)
        ACTION=set-volume
        SET_VOLUME_ARG="${1#*=}"
        shift
        ;;
    --id)
        [[ $# -ge 2 ]] || die "--id requires a value"
        TARGET_ID="$2"
        shift 2
        ;;
    --id=*)
        TARGET_ID="${1#*=}"
        shift
        ;;
    --all)
        STOP_ALL=1
        shift
        ;;
    *)
        normalized_args+=("$1")
        shift
        ;;
    esac
done
if ((${#normalized_args[@]})); then
    set -- "${normalized_args[@]}"
else
    set --
fi

while getopts ":n:m:M:s:f:S:dljJh" opt; do
    case "$opt" in
    n) NUM_RESULTS="$OPTARG" ;;
    m) MIN_DURATION="$OPTARG" ;;
    M) MAX_DURATION="$OPTARG" ;;
    s) SORT_FIELD="$OPTARG" ;;
    f) PLAYBACK_MODE=$(normalize_playback_mode "$OPTARG") ;;
    S) FORMAT_SORT="$OPTARG" ;;
    d) DETACH=1 ;;
    l) OUTPUT_MODE="list" ;;
    j) OUTPUT_MODE="json" ;;
    J) OUTPUT_MODE="json_full" ;;
    h)
        usage
        exit 0
        ;;
    :)
        die "option -$OPTARG requires an argument"
        ;;
    \?)
        die "invalid option: -$OPTARG"
        ;;
    esac
done

shift $((OPTIND - 1))

QUERY="$*"

if ! is_non_negative_int "$NUM_RESULTS"; then
    die "-n must be a non-negative integer"
fi
if ! is_non_negative_int "$MIN_DURATION"; then
    die "-m must be a non-negative integer"
fi
if ! is_non_negative_int "$MAX_DURATION"; then
    die "-M must be a non-negative integer"
fi
if ((MAX_DURATION > 0 && MAX_DURATION <= MIN_DURATION)); then
    die "-M must be greater than -m when both are set"
fi
if ! validate_enum "$SORT_FIELD" relevance view_count duration; then
    die "-s must be one of: relevance, view_count, duration"
fi
if ! validate_enum "$COLOR_MODE" auto always never; then
    die "--color must be one of: auto, always, never"
fi
if [[ -n "$VOLUME" ]]; then
    if ! is_non_negative_int "$VOLUME"; then
        die "--volume must be a non-negative integer"
    fi
    if ((VOLUME > 100)); then
        die "--volume must be between 0 and 100"
    fi
fi

# Detect a URL-shaped query once; both the routing and the guards below key off it.
IS_URL=0
if [[ "$QUERY" =~ ^https?:// || "$QUERY" =~ ^www\. || "$QUERY" =~ ^youtube\.com || "$QUERY" =~ ^youtu\.be ]]; then
    IS_URL=1
fi

# --get-url and --detach act on a specific video, so a URL is mandatory.
if [[ "$ACTION" == "geturl" ]] && ((! IS_URL)); then
    die "--get-url requires a YouTube URL"
fi
if [[ "$ACTION" == "info" ]] && ((! IS_URL)); then
    die "--info requires a YouTube URL"
fi
if ((DETACH)) && ((! IS_URL)); then
    die "--detach requires a YouTube URL"
fi

# A bare invocation (no URL, no query, no lifecycle action) is a usage error (D3).
# Report it before the heavier yt-dlp/mpv dependency check so the message is about
# the missing input, not a missing player. Interactive browsing lives in yt-tui.
if ((! IS_URL)) && [[ -z "${QUERY//[[:space:]]/}" ]] && [[ -z "$ACTION" ]]; then
    die "provide a search query or a URL (for interactive browsing, run yt-tui)"
fi

# Lifecycle queries need only jq and take no URL — handle them before the heavier
# yt-dlp/mpv dependency check and before any URL routing.
if [[ "$ACTION" == "status" ]]; then
    require_cmd jq
    do_status
fi
if [[ "$ACTION" == "stop" ]]; then
    require_cmd jq
    do_stop "${TARGET_ID:-}" "$STOP_ALL"
fi
# --set-volume drives a running player over its IPC socket: needs jq + nc, but NOT
# yt-dlp/mpv and takes no URL. nc is gated lazily HERE (not in require_deps) so a plain
# `yt <query>` search never demands it. BSD `nc -U` is stock on macOS (first use in
# this script); on Linux the -U flag varies by netcat variant (known gap, DESIGN-yt.md).
if [[ "$ACTION" == "set-volume" ]]; then
    require_cmd jq
    require_cmd nc
    do_set_volume "$SET_VOLUME_ARG" "${TARGET_ID:-}"
fi
# --info is a read-only metadata fetch: needs yt-dlp + jq, but NOT mpv (nothing plays).
# Handle it before the playback dependency check so a metadata lookup never demands mpv.
if [[ "$ACTION" == "info" ]]; then
    require_deps yt-dlp jq
    resolve_info "$QUERY"
fi

require_deps yt-dlp jq mpv

if [[ "$PLAYBACK_MODE" == "ascii" ]]; then
    if ! mpv_supports_vo "$YT_ASCII_VO"; then
        die "mpv does not support --vo=$YT_ASCII_VO (run 'mpv --vo=help' to choose a supported terminal VO)"
    fi
fi

# =-----------------------------------------------------------------------------
# ROUTING: Direct play (URLs) or Non-interactive Search output
# =-----------------------------------------------------------------------------
if ((IS_URL)); then
    if [[ "$ACTION" == "geturl" ]]; then
        resolve_stream_url "$QUERY" # resolve-only; exits internally
    fi
    if ((DETACH)); then
        detach_play "$QUERY"
        exit 0
    fi
    if [[ "$OUTPUT_MODE" == "json" ]]; then
        rc=0
        play_url_json "$QUERY" "$PLAYBACK_MODE" || rc=$?
        exit "$rc"
    fi
    play_url_directly "$QUERY"
    exit 0
fi

# =-----------------------------------------------------------------------------
# Non-URL: non-interactive search output. (Empty-query guard is enforced above.)
# =-----------------------------------------------------------------------------
fetch_results
if [[ "$OUTPUT_MODE" == "list" ]]; then
    print_list
else
    emit_search_json
fi
exit 0
