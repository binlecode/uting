#!/usr/bin/env bash

# Portability: must run on bash 3.2 (macOS system bash). No bash-4 features; guard
# every empty-array expansion (a bare "${arr[@]}" on an empty array aborts under
# `set -u` on 3.2). See DESIGN-yt.md §28.
#
# set -e means any unguarded failing command aborts the script. This is desired for
# this core: search and single-URL playback are non-interactive, so if mpv/yt-dlp
# fails the script should abort and propagate a real exit code. Where a failure must
# be captured rather than abort (e.g. classifying a playback error for JSON output),
# the `cmd || rc=$?` idiom keeps set -e from firing — see play_url_json().
set -euo pipefail

# ==============================================================================
# 1. CORE LIBRARY & DEFAULT SETTINGS (Merged from yt-common.sh)
# ==============================================================================
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Path to this script, used to re-exec a detached playback child (see detach_play).
SELF="${BASH_SOURCE[0]}"

: "${YT_COOKIE_BROWSER:=chrome}"
: "${YT_AUDIO_FORMAT:=ba/b}"
# Default to highest quality video+audio. This can start slower than progressive streams.
: "${YT_VIDEO_FORMAT:=bv*+ba/b}"
# Optional fast-start progressive format for interactive playback.
: "${YT_VIDEO_FORMAT_FAST:=b[height<=720][ext=mp4]/b[height<=720]/b[ext=mp4]/b}"
: "${YT_ASCII_VO:=tct}"
# Cookies (login) are ON by default (browser: chrome) so login-gated / members / age-
# restricted videos — invisible to an anonymous client — play. The trade-off: when cookies
# are supplied, yt-dlp switches to YouTube's authenticated client set, whose googlevideo
# media URLs can require a GVS "Proof of Origin" token; without it, mpv's fetch of those
# URLs 403s on some PUBLIC videos. To avoid a visible failed attempt, play_url_with_probe()
# probes up front (yt-dlp resolve + 1-byte ranged GET) which client actually fetches the
# media, then plays ONCE with it — cookies for login-gated, anonymous for cookie-403 public
# videos. So both cases play cleanly with no error dump (curl-less machines degrade to a
# play-fail-replay retry instead). DESIGN-yt.md §8.2.
# Set YT_COOKIE_BROWSER=none to force anonymous-only (skips the keychain read / probe).
# The browser's cookie DB should be readable (Chrome ideally closed) for a clean extraction.
# Optional custom mpv input.conf path; empty means use mpv defaults.
: "${YT_MPV_INPUT_CONF:=}"

YT_MPV_AUDIO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar --no-video)
# Keep video output auto-selected by mpv for compatibility across terminals/displays.
# Video-mode terminal-noise fix (video/fast). mpv draws the media TITLE as a video OSD via
# libass; a title with glyphs no font covers (emoji — pervasive on YouTube) makes libass emit
# a per-frame "[osd/libass] fontselect: failed … glyph" warning AND macOS CoreText a
# ".LastResort" note. At ~30/s these interrupt mpv's in-place status line so it scrolls
# endlessly, burying yt-tui's menu. Two-part fix that KEEPS the on-window OSD/OSC (so the video
# window still shows its seek bar / controls): (1) --msg-level=osd/libass=error suppresses the
# libass warnings at the source while keeping error level for the -j classifier; (2) the
# leftover CoreText notes — which no mpv flag can reach — are dropped by a stderr filter in
# run_mpv. Crucially the useful --term-osd-bar/AV status prints on STDOUT and the noise on
# STDERR, so filtering stderr never touches the progress bar. audio is immune (--no-video → no
# OSD); ascii uses --really-quiet. Rejected: --osd-level=0 (kills the noise but also the
# on-window OSD/OSC); --msg-level=all=error (blanks the status bar); OS_ACTIVITY_MODE=disable
# (does NOT stop CoreText). See DESIGN-yt.md §8.1.
YT_MPV_VIDEO_OPTIONS=(--msg-level=display-tags=warn,osd/libass=error --term-osd-bar)
# mpv docs suggest sw-fast/really-quiet for terminal VOs to reduce glitches and improve speed.
YT_MPV_ASCII_OPTIONS=(--vo="${YT_ASCII_VO}" --profile=sw-fast --really-quiet --term-osd-bar)

# Cookies are ON by default (YT_COOKIE_BROWSER defaults to "chrome"; set "none" to disable).
# Verify the browser profile exists on this platform; if not, run anonymously rather than
# break — so a machine without the configured browser degrades gracefully to no-login.
YT_COOKIE_ARGS=()
if [[ -n "${YT_COOKIE_BROWSER:-}" && "$YT_COOKIE_BROWSER" != "none" ]]; then
    browser_exists=0
    case "$YT_COOKIE_BROWSER" in
    chrome|chromium|brave)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            if [[ -d "$HOME/Library/Application Support/Google/Chrome" || -d "$HOME/Library/Application Support/BraveSoftware" || -d "$HOME/Library/Application Support/Chromium" ]]; then
                browser_exists=1
            fi
        else
            if [[ -d "$HOME/.config/google-chrome" || -d "$HOME/.config/chromium" || -d "$HOME/.config/BraveSoftware" ]]; then
                browser_exists=1
            fi
        fi
        ;;
    safari)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Safari" ]] && browser_exists=1
        fi
        ;;
    firefox)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Firefox" ]] && browser_exists=1
        else
            [[ -d "$HOME/.mozilla/firefox" ]] && browser_exists=1
        fi
        ;;
    edge)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Microsoft Edge" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/microsoft-edge" ]] && browser_exists=1
        fi
        ;;
    opera)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/com.operasoftware.Opera" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/opera" ]] && browser_exists=1
        fi
        ;;
    vivaldi)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            [[ -d "$HOME/Library/Application Support/Vivaldi" ]] && browser_exists=1
        else
            [[ -d "$HOME/.config/vivaldi" ]] && browser_exists=1
        fi
        ;;
    *)
        browser_exists=0
        ;;
    esac

    if ((browser_exists)); then
        YT_COOKIE_ARGS=(--cookies-from-browser "$YT_COOKIE_BROWSER")
    fi
fi

# ==============================================================================
# 2. CORE HELPER FUNCTIONS
# ==============================================================================

