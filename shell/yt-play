#!/usr/bin/env bash
# yt-play — dedicated YouTube URL playback / resolve / lifecycle (narrow, agent-facing).
#
# A real wrapper, not a symlink: owns a play-only --help, accepts only playback and
# lifecycle flags (rejecting search flags with a redirect to yt-search), validates that
# a URL is present when one is required, then delegates to the shared implementation
# `yt` (core). The heavy logic lives once in the impl; this layer's job is to
# give an LLM caller a small, single-purpose contract it cannot misuse.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). SPEC-system.md §28.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entries
# (yt-search / yt-play, and ytt for the TUI) are symlinks into a checkout that can live
# anywhere, so `dirname $0` is
# the symlink's directory, not the code's. This walks the chain to the real file and takes ITS
# directory — which is the one holding the rest of the suite.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually against
# ~/bin instead of against what ~/bin actually points at. Physical resolution is the only one
# that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)
if [[ -f "$SCRIPT_DIR/yt" ]]; then
    IMPL="$SCRIPT_DIR/yt"
else
    echo "yt-play: cannot locate yt (core) next to $SCRIPT_DIR" >&2
    exit 1
fi

print_usage() {
    cat <<'EOF'
yt-play — play, resolve, or manage playback of a YouTube URL

Usage:
  yt-play [-f mode] [--volume N] [-j] <URL>  Play a URL (blocks until done)
  yt-play --info [-j|-J] <URL>            Fetch metadata (title/chapters/desc), do not play
  yt-play --transcript [--sub-lang L] [-j|-J] <URL>  Captions as clean text, do not play
  yt-play --get-url [-f mode] [-j] <URL>  Resolve stream URL(s), do not play
  yt-play -d <URL>                        Detached background audio (concurrent players OK)
  yt-play --status [-j]                   List live detached players (always exit 0)
  yt-play --stop [--id ID | --all] [-j]   Stop one player (or all); idempotent
  yt-play --set-volume N [--id ID] [-j]   Live volume on a detached player (0-100)

Options:
  -f MODE   Playback mode (default: audio):
            audio | video | fast | ascii | viz
            (-d rejects ascii/viz: a detached player has no terminal to draw on)
  --volume N  mpv startup volume, 0-100 (default: unset -> mpv's own default).
              For detached playback this is the STARTING volume; adjust it live
              with --set-volume.
  -d        --detach: background playback; manage with --status / --stop / --set-volume.
            Multiple concurrent detached players are supported, each addressed by --id.
  --set-volume N  Set volume (0-100) on a running detached player. With one player,
            --id is optional; with several, --id is required (else 'ambiguous').
  --id ID   Target a specific detached player (id from --status / a -d launch).
  --all     With --stop: stop every live detached player.
  --info    Fetch rich metadata (read-only, non-blocking): title, channel,
            uploader, upload_date, duration, view/like counts, live_status,
            description, chapters. Text by default; -j lean JSON; -J full raw record
  --transcript  Fetch the caption track and print it as clean text, ready to drop into
            a prompt (read-only, nothing plays). Prefers human-authored captions and
            falls back to auto-generated ones. -j is the lean envelope (text + size
            counters); -J is the same envelope plus the timed segments.
            Alias: --subtitles
  --sub-lang L  Caption language(s) for --transcript: a comma-separated PRIORITY CHAIN,
            the first one the video actually has wins (default: en,zh-Hans,zh,ja).
            Alias: --sub-langs
  --get-url Resolve direct stream URL(s) instead of playing (non-blocking)
  --status  List live detached players (JSON: a 'players' array)
  --stop    Stop a detached player (--id ID), or all (--all)
  -j        JSON output (one line): {status,url,mode,exit_code,reason,retried}
            for playback; {status,...} for --status/--stop/--get-url/--info/--set-volume
  -J        Full raw yt-dlp record (with --info)
  -h        This help
  -V        Print the suite version

Playback error reason (JSON): forbidden | unavailable | format_unavailable |
                              network | stopped_by_user | unknown | null(ok)
  network covers connectivity AND HTTP 429 rate limiting (both retryable); forbidden (403)
  means the opposite — these credentials will not work, retrying will not help
Lifecycle JSON:
  -d            {status:"started",id,pid,url,mode,started_at,title,sock,log}
  --status      {status:"players",players:[{id,pid,url,mode,volume,title,started_at}...]}
                volume is read live from the player; title lands a few seconds after -d
  --stop        {status:"stopped",id,stopped} | {status:"stopped",scope:"all",stopped}
  --set-volume  {status:"ok",id,volume} | {status:"not_playing"}
                | {status:"ambiguous",players:[...]} | {status:"error",reason:"ipc_failed"}
Info JSON (--info -j): {status,id,title,url,channel,uploader,upload_date,duration,
                       duration_fmt,view_count,like_count,live_status,description,chapters}
Transcript JSON (--transcript -j): {status,id,url,lang,is_auto,chars,segment_count,text}
  -J = the same envelope plus segments[{start,duration,text}] in seconds (superset of -j)
  no captions / fetch failure -> {status:"error",url,reason} and exit 1

To search for something to play, use: yt-search <query>
EOF
}

# Collect flags and the URL separately: the impl's getopts stops at the first
# positional, so flags must be emitted before the URL.
action=""       # "" | status | stop | geturl
flags=()
url=()
while (($#)); do
    case "$1" in
    -h | --help)
        print_usage
        exit 0
        ;;
    -V | --version)
        # One version, held by the core (§ YT_VERSION). Asking it and printing OUR name in
        # front is what keeps four entry points from drifting into four version numbers.
        printf '%s %s\n' "yt-play" "$("$IMPL" --version | awk '{print $NF}')"
        exit 0
        ;;
    -j | --json | -J | --json-full | -d | --detach | --all)
        flags+=("$1")
        shift
        ;;
    --status)
        action=status
        flags+=("$1")
        shift
        ;;
    --stop)
        action=stop
        flags+=("$1")
        shift
        ;;
    --get-url)
        action=geturl
        flags+=("$1")
        shift
        ;;
    --info)
        action=info
        flags+=("$1")
        shift
        ;;
    --transcript | --subtitles)
        action=transcript
        flags+=("$1")
        shift
        ;;
    --sub-lang=* | --sub-langs=*)
        flags+=("$1")
        shift
        ;;
    --sub-lang | --sub-langs)
        [[ $# -ge 2 ]] || {
            echo "yt-play: $1 requires a value" >&2
            exit 1
        }
        flags+=("$1" "$2")
        shift 2
        ;;
    --set-volume=*)
        action=set-volume
        flags+=("$1")
        shift
        ;;
    --set-volume)
        [[ $# -ge 2 ]] || {
            echo "yt-play: $1 requires a value" >&2
            exit 1
        }
        action=set-volume
        flags+=("$1" "$2")
        shift 2
        ;;
    --color=* | --volume=* | --id=*)
        flags+=("$1")
        shift
        ;;
    -f | --color | --volume | --id)
        [[ $# -ge 2 ]] || {
            echo "yt-play: $1 requires a value" >&2
            exit 1
        }
        flags+=("$1" "$2")
        shift 2
        ;;
    -n | -m | -M | -s | -S | -l | --list)
        echo "yt-play: $1 is a search flag — use yt-search for searching" >&2
        exit 1
        ;;
    --)
        shift
        while (($#)); do
            url+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "yt-play: unknown flag '$1' (play flags: -f -d -j --get-url --info --transcript --status --stop --set-volume --id --all)" >&2
        exit 1
        ;;
    http://* | https://* | www.* | youtube.com/* | youtu.be/*)
        url+=("$1")
        shift
        ;;
    *)
        echo "yt-play: '$1' is not a URL — to search for it use 'yt-search $1'" >&2
        exit 1
        ;;
    esac
done

# --status / --stop / --set-volume act on already-running detached players and take
# no URL. Everything else (play, --detach, --get-url, --info) needs a URL.
if [[ "$action" != status && "$action" != stop && "$action" != set-volume ]] && ((${#url[@]} == 0)); then
    echo "yt-play: a YouTube URL is required (see 'yt-play -h')" >&2
    exit 1
fi

# --transcript is a READ-ONLY metadata verb: it never plays, so a playback flag next to it
# is a caller who believes otherwise. Reject instead of silently ignoring - the core's
# set_action only catches conflicting ACTIONS, and -f/-d/--volume are not actions, so
# without this gate they would be accepted and quietly do nothing. This is the gating
# layer's whole job (SPEC-system.md §13).
if [[ "$action" == transcript ]] && ((${#flags[@]})); then
    for f in "${flags[@]}"; do
        case "$f" in
        -d | --detach | -f | --volume | --volume=*)
            echo "yt-play: $f cannot be combined with --transcript (it does not play)" >&2
            exit 1
            ;;
        esac
    done
fi

# flags is always non-empty for status/stop (they add their own flag); for play it may
# be empty, and url may be empty for status/stop — build the argv guarding both.
# `--` is FORWARDED (not just consumed here) so the impl stops option parsing before the
# URL — a URL or query-shaped token beginning with '-' can never be read as a flag.
# SPEC-system.md §6.
argv=()
((${#flags[@]})) && argv+=("${flags[@]}")
((${#url[@]})) && argv+=(-- "${url[@]}")
exec "$IMPL" "${argv[@]}"
