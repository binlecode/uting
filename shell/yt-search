#!/usr/bin/env bash
# yt-search — dedicated non-interactive YouTube search (narrow, agent-facing surface).
#
# This is a real wrapper, not a symlink: it owns a search-only --help, accepts only
# search flags (rejecting playback/lifecycle flags with a redirect to yt-play), then
# delegates to the shared implementation `yt` (core). Keeping the heavy logic
# in one place avoids drift; the narrowing here is what gives an LLM caller a small,
# unambiguous contract. Output defaults to the plain list (-l) unless -j/-J is given.
set -euo pipefail
# Portability: bash 3.2 (macOS system bash) — no bash-4 features; guard empty-array
# expansions ("${arr[@]}" on an empty array aborts under set -u on 3.2). SPEC-system.md §28.

# Resolve this script's OWN symlink chain before looking for its siblings. The PATH entries
# (yt-search / yt-play, and ytt for the TUI) are symlinks into a checkout that can live
# anywhere, so `dirname $0` is
# the symlink's directory, not the code's. This walks the chain to the real file and takes ITS
# directory — which is the one holding the rest of the suite.
#
# `cd -P` / `pwd -P`, not the logical forms: a relative symlink resolves to something like
# ~/bin/../../../elsewhere/shell, and logical `cd` would normalise those `..` textually against
# ~/bin instead of against what ~/bin actually points at. Physical resolution is the only one
# that lands in the right place. bash 3.2 has no `readlink -f`, hence the loop.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _link=$(readlink "$_self")
    case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(dirname "$_self")/$_link" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$_self")" && pwd -P)
if [[ -f "$SCRIPT_DIR/ut-play" ]]; then
    IMPL="$SCRIPT_DIR/ut-play"
else
    echo "yt-search: cannot locate ut-play (core) next to $SCRIPT_DIR" >&2
    exit 1
fi

print_usage() {
    cat <<'EOF'
yt-search — non-interactive YouTube search

Usage:
  yt-search [options] <search query>

Options:
  -n NUM   Number of results to fetch (default: 25)
  -m SEC   Minimum duration in seconds
  -M SEC   Maximum duration in seconds
  -s FIELD Sort field: relevance | view_count | duration (default: relevance)
  -S SORT  yt-dlp format-sort override (--format-sort)
  -l       Plain text list output (default)
  -j       JSON: {query, count, results[]} — 8 lean fields per result
  -J       JSON with full raw yt-dlp fields per result (same envelope)
  -h       This help
  -V       Print the suite version

Output (JSON, -j): {"query","count","results":[{id,title,url,channel,duration,
                    duration_fmt,view_count,live_status}, ...]}

To play a result, pass its url to: yt-play <url>
EOF
}

# Value-taking flags (consume the next token) vs boolean flags, restricted to the
# search surface. Anything outside these is rejected — playback/lifecycle flags get a
# pointer to yt-play so the caller learns the right tool instead of a bare error.
# Collect option tokens and query tokens separately: the impl's getopts stops at the
# first positional, so every flag (including the injected -l default) must be emitted
# before the query.
has_format=0
flags=()
query=()
reject_url() {
    echo "yt-search: '$1' looks like a URL — use 'yt-play $1' to play it" >&2
    exit 1
}
while (($#)); do
    case "$1" in
    -h | --help)
        print_usage
        exit 0
        ;;
    -V | --version)
        # One version, held by the core (§ YT_VERSION). Asking it and printing OUR name in
        # front is what keeps four entry points from drifting into four version numbers.
        printf '%s %s\n' "yt-search" "$("$IMPL" --version | awk '{print $NF}')"
        exit 0
        ;;
    -l | --list | -j | --json | -J | --json-full)
        has_format=1
        flags+=("$1")
        shift
        ;;
    --color=*)
        flags+=("$1")
        shift
        ;;
    -n | -m | -M | -s | -S | --color)
        [[ $# -ge 2 ]] || {
            echo "yt-search: $1 requires a value" >&2
            exit 1
        }
        flags+=("$1" "$2")
        shift 2
        ;;
    -f | -d | --detach | --status | --stop | --get-url | --info | --transcript | --subtitles | --sub-lang | --sub-langs | --set-volume | --id | --all)
        echo "yt-search: $1 is a playback flag — use yt-play for playback" >&2
        exit 1
        ;;
    --)
        shift
        while (($#)); do
            # yt-search searches text; a URL belongs to yt-play.
            case "$1" in
            http://* | https://* | www.* | youtube.com/* | youtu.be/*) reject_url "$1" ;;
            esac
            query+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "yt-search: unknown flag '$1' (search flags: -n -m -M -s -S -l -j -J)" >&2
        exit 1
        ;;
    http://* | https://* | www.* | youtube.com/* | youtu.be/*)
        reject_url "$1"
        ;;
    *)
        query+=("$1")
        shift
        ;;
    esac
done

if ((${#query[@]} == 0)); then
    echo "yt-search: a search query is required (see 'yt-search -h')" >&2
    exit 1
fi

# Default to the plain list unless the caller picked a JSON format.
((has_format)) || flags+=("-l")

# `--` is FORWARDED, not just consumed here: it is what stops the impl from reading a
# query that looks like a flag as one (`yt-search -- --status` must search for the text,
# not list players). SPEC-system.md §6.
exec "$IMPL" "${flags[@]}" -- "${query[@]}"
